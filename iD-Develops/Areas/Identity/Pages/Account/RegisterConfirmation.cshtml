@page
@model iD_Develops.Areas.Identity.Pages.Account.RegisterConfirmationModel
@{
    Layout = "_IdentityLayout";
    ViewData["Title"] = "Confirm registration";
}

<div class="w-full text-center">
    <h1 class="m-0 mb-6 font-['Playfair_Display',Georgia,serif] text-[clamp(2rem,5vw,3rem)] font-medium leading-[1.08] tracking-[-0.015em] text-[#071F3D]">@ViewData["Title"]</h1>
    <p class="mb-2 text-base leading-relaxed text-[#6B6B6B]">Thank you for registering with iD! Training & Development.</p>
    <p class="mb-2 text-base leading-relaxed text-[#6B6B6B]">
        We've sent a confirmation email to:<br /><strong>@Model.Email</strong><br />
        Please check your email and click the confirmation link to activate your account.
    </p>
    <p class="text-[#6B6B6B]">
        <small>If you did not receive the email, please check your spam folder or resend it below.</small>
    </p>

    <form method="post" asp-page-handler="ResendEmailConfirmation">
        <input type="hidden" asp-for="Email" />
        <input type="hidden" asp-for="ReturnUrl" />
        <button type="submit" class="inline-flex min-h-12 w-full items-center justify-center rounded-md border border-[#B23A48] bg-[#B23A48] px-4 py-3 text-sm font-bold text-white no-underline shadow-[0_10px_24px_rgba(159,47,61,0.18)] transition hover:border-[#9F2F3D] hover:bg-[#9F2F3D] hover:text-white hover:no-underline hover:shadow-[0_14px_30px_rgba(159,47,61,0.24)] focus:border-[#9F2F3D] focus:bg-[#9F2F3D] focus:text-white focus:no-underline">Resend email</button>
    </form>

    <p class="mt-4 text-[#6B6B6B]">
        <small>If you need help, <a asp-page="/Contact" class="font-semibold text-[#B23A48] no-underline transition-colors hover:text-[#8F2635] hover:underline hover:underline-offset-4 focus:text-[#8F2635] focus:underline focus:underline-offset-4">contact us</a>.</small>
    </p>
    <p class="mb-0 text-base leading-relaxed text-[#6B6B6B]">
        After confirming your email, you can <a asp-page="/Account/Login" asp-route-returnUrl="@Model.ReturnUrl" class="font-semibold text-[#B23A48] no-underline transition-colors hover:text-[#8F2635] hover:underline hover:underline-offset-4 focus:text-[#8F2635] focus:underline focus:underline-offset-4">log in here</a>.
    </p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
