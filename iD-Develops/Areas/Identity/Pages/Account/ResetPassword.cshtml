@page
@model iD_Develops.Areas.Identity.Pages.Account.ResetPasswordModel
@{
    Layout = "_IdentityLayout";
    ViewData["Title"] = "Reset password";
}

<form class="w-full" method="post">
    <h1 class="m-0 mb-6 text-center font-['Playfair_Display',Georgia,serif] text-[clamp(2rem,5vw,3rem)] font-medium leading-[1.08] tracking-[-0.015em] text-[#071F3D]">@ViewData["Title"]</h1>

    <div asp-validation-summary="ModelOnly" class="mt-1.5 block text-sm text-[#B23A48]"></div>
    <input asp-for="Input.Code" type="hidden" />

    <div class="mb-4">
        <label asp-for="Input.Email" class="mb-2 block text-base leading-relaxed text-[#6B6B6B]">E-mail</label>
        <input asp-for="Input.Email" class="min-h-12 w-full rounded-md border border-[#D8D3CC] bg-white px-3.5 py-3 text-[#1A1A1A] outline-none transition focus:border-[#B23A48] focus:shadow-[0_0_0_3px_rgba(178,58,72,0.12)]" />
        <span asp-validation-for="Input.Email" class="mt-1.5 block text-sm text-[#B23A48]"></span>
    </div>

    <div class="mb-4">
        <label asp-for="Input.Password" class="mb-2 block text-base leading-relaxed text-[#6B6B6B]">Password</label>
        <input asp-for="Input.Password" class="min-h-12 w-full rounded-md border border-[#D8D3CC] bg-white px-3.5 py-3 text-[#1A1A1A] outline-none transition focus:border-[#B23A48] focus:shadow-[0_0_0_3px_rgba(178,58,72,0.12)]" autocomplete="new-password" />
        <span asp-validation-for="Input.Password" class="mt-1.5 block text-sm text-[#B23A48]"></span>
    </div>

    <div class="mb-4">
        <label asp-for="Input.ConfirmPassword" class="mb-2 block text-base leading-relaxed text-[#6B6B6B]">Confirm Password</label>
        <input asp-for="Input.ConfirmPassword" class="min-h-12 w-full rounded-md border border-[#D8D3CC] bg-white px-3.5 py-3 text-[#1A1A1A] outline-none transition focus:border-[#B23A48] focus:shadow-[0_0_0_3px_rgba(178,58,72,0.12)]" autocomplete="new-password" />
        <span asp-validation-for="Input.ConfirmPassword" class="mt-1.5 block text-sm text-[#B23A48]"></span>
    </div>

    <div class="mb-0">
        <button type="submit" class="inline-flex min-h-12 w-full items-center justify-center rounded-md border border-[#B23A48] bg-[#B23A48] px-4 py-3 text-sm font-bold text-white no-underline shadow-[0_10px_24px_rgba(159,47,61,0.18)] transition hover:border-[#9F2F3D] hover:bg-[#9F2F3D] hover:text-white hover:no-underline hover:shadow-[0_14px_30px_rgba(159,47,61,0.24)] focus:border-[#9F2F3D] focus:bg-[#9F2F3D] focus:text-white focus:no-underline">Reset</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
