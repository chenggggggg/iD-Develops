@page
@model ConfirmEmailChangeModel
@{
    Layout = "_IdentityLayout";
    ViewData["Title"] = "Confirm email change";
}

<div class="w-full text-center">
    <h1 class="m-0 mb-6 font-['Playfair_Display',Georgia,serif] text-[clamp(2rem,5vw,3rem)] font-medium leading-[1.08] tracking-[-0.015em] text-[#071F3D]">@ViewData["Title"]</h1>
    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <p class="mb-4 rounded-md border border-[#B23A48]/20 bg-[#B23A48]/[0.07] px-4 py-3 text-base leading-relaxed text-[#1A1A1A]">@Model.StatusMessage</p>
    }
    <p class="mb-0 text-base leading-relaxed text-[#6B6B6B]">
        You can return to your account after the email change has been processed.
    </p>
</div>
