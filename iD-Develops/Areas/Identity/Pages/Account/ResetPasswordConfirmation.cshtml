@page
@model ResetPasswordConfirmationModel
@{
    Layout = "_IdentityLayout";
    ViewData["Title"] = "Reset password confirmation";
}

<div class="w-full text-center">
    <h1 class="m-0 mb-6 font-['Playfair_Display',Georgia,serif] text-[clamp(2rem,5vw,3rem)] font-medium leading-[1.08] tracking-[-0.015em] text-[#071F3D]">Password reset</h1>
    <p class="mb-2 text-base leading-relaxed text-[#6B6B6B]">Your password has been successfully reset.</p>
    <p class="mb-0 text-base leading-relaxed text-[#6B6B6B]">Please <a asp-page="./Login" class="font-semibold text-[#B23A48] no-underline transition-colors hover:text-[#8F2635] hover:underline hover:underline-offset-4 focus:text-[#8F2635] focus:underline focus:underline-offset-4">click here to log in</a>.</p>
</div>
