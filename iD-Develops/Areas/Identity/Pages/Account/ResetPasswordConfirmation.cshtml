@page
@model ResetPasswordConfirmationModel
@{
    Layout = "_IdentityLayout";
    ViewData["Title"] = "Reset password confirmation";
}

<div class="tw:w-full tw:text-center">
    <h1 class="tw:m-0 tw:mb-6 tw:font-['Playfair_Display',Georgia,serif] tw:text-[clamp(2rem,5vw,3rem)] tw:font-medium tw:leading-[1.08] tw:tracking-[-0.015em] tw:text-[#071F3D]">Password reset</h1>
    <p class="tw:mb-2 tw:text-base tw:leading-relaxed tw:text-[#6B6B6B]">Your password has been successfully reset.</p>
    <p class="tw:mb-0 tw:text-base tw:leading-relaxed tw:text-[#6B6B6B]">Please <a asp-page="./Login" class="tw:font-semibold tw:text-[#B23A48] tw:no-underline tw:transition-colors tw:hover:text-[#8F2635] tw:hover:underline tw:hover:underline-offset-4 tw:focus:text-[#8F2635] tw:focus:underline tw:focus:underline-offset-4">click here to log in</a>.</p>
</div>
