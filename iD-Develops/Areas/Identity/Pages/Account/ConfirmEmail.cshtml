@page
@model iD_Develops.Areas.Identity.Pages.Account.ConfirmEmailModel
@{
    Layout = "_IdentityLayout";
    ViewData["Title"] = "Confirm email";
}

<div class="w-full text-center">
@if (Model.StatusMessage.Contains("Thank you"))
{
    <h1 class="m-0 mb-6 font-['Playfair_Display',Georgia,serif] text-[clamp(2rem,5vw,3rem)] font-medium leading-[1.08] tracking-[-0.015em] text-[#071F3D]">Email confirmed</h1>
    <p class="mb-2 text-base leading-relaxed text-[#6B6B6B]">Your email has been successfully confirmed.</p>
    <p class="mb-0 text-base leading-relaxed text-[#6B6B6B]">You can now <a asp-page="/Account/Login" class="font-semibold text-[#B23A48] no-underline transition-colors hover:text-[#8F2635] hover:underline hover:underline-offset-4 focus:text-[#8F2635] focus:underline focus:underline-offset-4">log in</a>.</p>
}
else
{
    <h1 class="m-0 mb-6 font-['Playfair_Display',Georgia,serif] text-[clamp(2rem,5vw,3rem)] font-medium leading-[1.08] tracking-[-0.015em] text-[#071F3D]">Confirmation error</h1>
    <p class="mb-0 text-base leading-relaxed text-[#6B6B6B]">There was an error confirming your email. Please try the link again or <a asp-page="/Account/Register" class="font-semibold text-[#B23A48] no-underline transition-colors hover:text-[#8F2635] hover:underline hover:underline-offset-4 focus:text-[#8F2635] focus:underline focus:underline-offset-4">register again</a>.</p>
}
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
