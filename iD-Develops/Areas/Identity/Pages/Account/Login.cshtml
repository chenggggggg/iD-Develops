@page
@model LoginModel

@{
    Layout = "_IdentityLayout";
    ViewData["Title"] = "Log in";
}

<form class="w-full" id="account" method="post">
    <h1 class="m-0 mb-6 text-center font-['Playfair_Display',Georgia,serif] text-[clamp(2rem,5vw,3rem)] font-medium leading-[1.08] tracking-[-0.015em] text-[#071F3D]">Log in to your account</h1>
    <div asp-validation-summary="ModelOnly" class="mt-1.5 block text-sm text-[#B23A48]"></div>

    <div class="mb-4">
        <label asp-for="Input.Email" class="mb-2 block text-base leading-relaxed text-[#6B6B6B]">E-mail</label>
        <input asp-for="Input.Email"
               type ="email"
               class="min-h-12 w-full rounded-md border border-[#D8D3CC] bg-white px-3.5 py-3 text-[#1A1A1A] outline-none transition focus:border-[#B23A48] focus:shadow-[0_0_0_3px_rgba(178,58,72,0.12)]"
               autocomplete="username"
               inputmode="email"
               autocapitalize="none"
               spellcheck="false" />
        <span asp-validation-for="Input.Email" class="mt-1.5 block text-sm text-[#B23A48]"></span>
    </div>

    <div class="mb-4">
        <div class="mb-2 flex items-center justify-between gap-4 max-[576px]:flex-col max-[576px]:items-start max-[576px]:gap-1">
            <label asp-for="Input.Password" class="block text-base leading-relaxed text-[#6B6B6B]">Password</label>
            <a asp-page="./ForgotPassword" class="font-semibold text-[#B23A48] no-underline transition-colors hover:text-[#8F2635] hover:underline hover:underline-offset-4 focus:text-[#8F2635] focus:underline focus:underline-offset-4">Forgot your password?</a>
        </div>
        <input asp-for="Input.Password" class="min-h-12 w-full rounded-md border border-[#D8D3CC] bg-white px-3.5 py-3 text-[#1A1A1A] outline-none transition focus:border-[#B23A48] focus:shadow-[0_0_0_3px_rgba(178,58,72,0.12)]" autocomplete="current-password" />
        <span asp-validation-for="Input.Password" class="mt-1.5 block text-sm text-[#B23A48]"></span>
    </div>

    <div class="mb-4 flex items-center gap-2.5 text-[#6B6B6B]">
        <input asp-for="Input.RememberMe" />
        <label asp-for="Input.RememberMe">Remember me?</label>
    </div>

    <div class="mb-4">
        <button type="submit" class="inline-flex min-h-12 w-full items-center justify-center rounded-md border border-[#B23A48] bg-[#B23A48] px-4 py-3 text-sm font-bold text-white no-underline shadow-[0_10px_24px_rgba(159,47,61,0.18)] transition hover:border-[#9F2F3D] hover:bg-[#9F2F3D] hover:text-white hover:no-underline hover:shadow-[0_14px_30px_rgba(159,47,61,0.24)] focus:border-[#9F2F3D] focus:bg-[#9F2F3D] focus:text-white focus:no-underline">Log in</button>
    </div>

    <p class="mb-0">
        Don't have an account?
        <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="font-semibold text-[#B23A48] no-underline transition-colors hover:text-[#8F2635] hover:underline hover:underline-offset-4 focus:text-[#8F2635] focus:underline focus:underline-offset-4">Register</a>
    </p>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

