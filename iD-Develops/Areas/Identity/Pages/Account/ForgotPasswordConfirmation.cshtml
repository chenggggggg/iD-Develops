@page
@model ForgotPasswordConfirmation

@{
    Layout = "_IdentityLayout";
    ViewData["Title"] = "Forgot password confirmation";
}

<div class="tw:w-full tw:text-center">
    <h1 class="tw:m-0 tw:mb-6 tw:font-['Playfair_Display',Georgia,serif] tw:text-[clamp(2rem,5vw,3rem)] tw:font-medium tw:leading-[1.08] tw:tracking-[-0.015em] tw:text-[#071F3D]">Password reset link sent</h1>
    <p class="tw:mb-2 tw:text-base tw:leading-relaxed tw:text-[#6B6B6B]">
        Please check your email for a reset link. If you do not receive it, check your spam folder or
        <a asp-page="./ForgotPassword" class="tw:font-semibold tw:text-[#B23A48] tw:no-underline tw:transition-colors tw:hover:text-[#8F2635] tw:hover:underline tw:hover:underline-offset-4 tw:focus:text-[#8F2635] tw:focus:underline tw:focus:underline-offset-4">try again</a>.
    </p>
    <div class="tw:mt-4">
        <a asp-page="./Login" class="tw:inline-flex tw:min-h-12 tw:items-center tw:justify-center tw:rounded-md tw:border tw:border-[#B23A48] tw:bg-[#B23A48] tw:px-4 tw:py-3 tw:text-sm tw:font-bold tw:text-white tw:no-underline tw:shadow-[0_10px_24px_rgba(159,47,61,0.18)] tw:transition tw:hover:border-[#9F2F3D] tw:hover:bg-[#9F2F3D] tw:hover:text-white tw:hover:no-underline tw:hover:shadow-[0_14px_30px_rgba(159,47,61,0.24)] tw:focus:border-[#9F2F3D] tw:focus:bg-[#9F2F3D] tw:focus:text-white tw:focus:no-underline">Back to Login</a>
    </div>
</div>
