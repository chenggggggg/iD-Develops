@page
@model ForgotPasswordConfirmation

@{
    Layout = "_IdentityLayout";
    ViewData["Title"] = "Forgot password confirmation";
}

<div class="w-full text-center">
    <h1 class="m-0 mb-6 font-['Playfair_Display',Georgia,serif] text-[clamp(2rem,5vw,3rem)] font-medium leading-[1.08] tracking-[-0.015em] text-[#071F3D]">Password reset link sent</h1>
    <p class="mb-2 text-base leading-relaxed text-[#6B6B6B]">
        Please check your email for a reset link. If you do not receive it, check your spam folder or
        <a asp-page="./ForgotPassword" class="font-semibold text-[#B23A48] no-underline transition-colors hover:text-[#8F2635] hover:underline hover:underline-offset-4 focus:text-[#8F2635] focus:underline focus:underline-offset-4">try again</a>.
    </p>
    <div class="mt-4">
        <a asp-page="./Login" class="inline-flex min-h-12 items-center justify-center rounded-md border border-[#B23A48] bg-[#B23A48] px-4 py-3 text-sm font-bold text-white no-underline shadow-[0_10px_24px_rgba(159,47,61,0.18)] transition hover:border-[#9F2F3D] hover:bg-[#9F2F3D] hover:text-white hover:no-underline hover:shadow-[0_14px_30px_rgba(159,47,61,0.24)] focus:border-[#9F2F3D] focus:bg-[#9F2F3D] focus:text-white focus:no-underline">Back to Login</a>
    </div>
</div>
