# Copy this file to .env, .env.development, .env.staging, or .env.production.
# Replace placeholders locally. Never commit populated environment files.

# PostgreSQL / Docker Compose
LOCAL_DB_NAME=iddevelops_local
DEVELOPMENT_DB_NAME=iddevelops_development
DB_NAME=iddevelops_staging
LOCAL_POSTGRES_USER=postgres
LOCAL_POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-password
ConnectionStrings__ApplicationDbContextConnection=

# Public website and English-only portal hosts
ApplicationUrls__PublicBaseUrl=http://id.localhost:5000
ApplicationUrls__PortalBaseUrl=http://portal.id.localhost:5000

# Initial administrator
Admin__Email=admin@example.test
Admin__Password=replace-with-a-strong-password
SuperAdmin__Email=
SuperAdmin__Password=
SuperAdmin__FirstName=Super
SuperAdmin__LastName=Admin

# Object storage
Storage__Provider=Disabled
Storage__Bucket=
Storage__Region=auto
Storage__Endpoint=
Storage__PublicBaseUrl=
Storage__CdnBaseUrl=
Storage__AccessKey=
Storage__SecretKey=
Storage__Prefix=local

# Payments
Stripe__PublishableKey=
Stripe__SecretKey=
Stripe__WebhookSecret=

# Scheduling integrations
SchedulingProviders__Zoom__Enabled=false
SchedulingProviders__Zoom__ClientId=
SchedulingProviders__Zoom__ClientSecret=
SchedulingProviders__Zoom__WebhookSecret=
SchedulingProviders__GoogleCalendar__Enabled=false
SchedulingProviders__GoogleCalendar__ClientId=
SchedulingProviders__GoogleCalendar__ClientSecret=

# Email
Mail__Provider=File
Mail__From=no-reply@example.test
Mail__To=admin@example.test
Mail__Host=
Mail__Port=587
Mail__Username=
Mail__Password=
Mail__SecureSocketOptions=StartTls

# Anti-bot and media integrations
Turnstile__SiteKey=
Turnstile__SecretKey=
Cloudflare__StreamApiToken=
