@page
@model Personal_DevelopmentModel
@inject IStringLocalizer<Personal_DevelopmentModel> Localizer
@{
    ViewData["Title"] = Localizer["Title"];
    ViewData["SeoTitle"] = Localizer["SeoTitle"];
    ViewData["MetaDescription"] = Localizer["MetaDescription"];
}

<section class="public-hero-page">
    <div class="public-container">
        <div class="public-hero-grid">
            <div>
                <p class="public-eyebrow public-eyebrow-left">@Localizer["Title"]</p>
                <h1 class="public-hero-title mx-0">@Localizer["HeroTitle"]</h1>
                <p class="public-hero-copy mx-0">@Localizer["HeroDescription"]</p>
                <div class="public-actions justify-start">
                    <a href="https://koalendar.com/e/meet-with-id" target="_blank" rel="noopener noreferrer" class="public-btn public-btn-primary">@Localizer["ScheduleConversation"] <i class="fas fa-arrow-right"></i></a>
                    <a asp-page="/contact" asp-route-culture="@CultureInfo.CurrentCulture.Name.ToLowerInvariant()" class="public-btn public-btn-outline">@Localizer["ContactButton"] <i class="fas fa-arrow-right"></i></a>
                </div>
            </div>
            <div class="public-hero-note"><h2>@Localizer["HeroNoteTitle"]</h2><p class="public-copy">@Localizer["HeroNoteDescription"]</p></div>
        </div>
    </div>
</section>

<section class="public-section">
    <div class="public-container public-content-narrow mx-auto">
        <p class="public-eyebrow public-eyebrow-left">@Localizer["ApproachEyebrow"]</p>
        <p class="public-copy">@Localizer["ApproachParagraph1"]</p>
        <p class="public-copy">@Localizer["ApproachParagraph2"]</p>
    </div>
</section>

<section class="public-section public-section-soft">
    <div class="public-container">
        <div class="public-two-column">
            <div>
                <p class="public-eyebrow public-eyebrow-left">@Localizer["AudienceEyebrow"]</p>
                <h2 class="public-section-title">@Localizer["AudienceTitle"]</h2>
                <p class="public-copy">@Localizer["AudienceDescription"]</p>
            </div>
            <div>
                <p class="public-eyebrow public-eyebrow-left">@Localizer["HelpEyebrow"]</p>
                <ul class="public-check-list">
                    @for (var index = 1; index <= 8; index++)
                    {
                        <li><i class="fa-solid fa-circle-check"></i>@Localizer[$"HelpItem{index}"]</li>
                    }
                </ul>
            </div>
        </div>
    </div>
</section>

<section class="public-section">
    <div class="public-container">
        <div class="public-section-heading public-section-heading-center"><p class="public-eyebrow">@Localizer["MethodsEyebrow"]</p></div>
        <div class="public-feature-grid xl:grid-cols-4">
            @for (var index = 1; index <= 4; index++)
            {
                <article class="public-feature-card"><h3>@Localizer[$"Method{index}Title"]</h3><p class="public-copy">@Localizer[$"Method{index}Description"]</p></article>
            }
        </div>
        <p class="public-copy mx-auto mt-10 max-w-3xl text-center">@Localizer["MethodsConclusion"]</p>
        <div class="public-actions">
            <a href="https://koalendar.com/e/meet-with-id" target="_blank" rel="noopener noreferrer" class="public-btn public-btn-primary">@Localizer["MethodsButton"] <i class="fas fa-arrow-right"></i></a>
            <a asp-page="/contact" asp-route-culture="@CultureInfo.CurrentCulture.Name.ToLowerInvariant()" class="public-btn public-btn-outline">@Localizer["ContactButton"] <i class="fas fa-arrow-right"></i></a>
        </div>
    </div>
</section>
