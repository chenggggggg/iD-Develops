@page
@model Personal_DevelopmentModel
@inject IStringLocalizer<Personal_DevelopmentModel> Localizer
@{
    ViewData["Title"] = Localizer["Title"];
    ViewData["SeoTitle"] = Localizer["SeoTitle"];
    ViewData["MetaDescription"] = Localizer["MetaDescription"];
    var contactUrl = Url.Page("/Contact", new { culture = CultureInfo.CurrentCulture.Name.ToLowerInvariant() })!;
    var conversation = new PublicServiceLink(Localizer["ScheduleConversation"], "https://koalendar.com/e/meet-with-id", true);
    var contact = new PublicServiceLink(Localizer["ContactButton"], contactUrl);
    var hero = new PublicServiceHero(Localizer["Title"], Localizer["HeroTitle"],
        [Localizer["HeroDescription"]], "personal-development", conversation, contact,
        Localizer["HeroNoteTitle"], Localizer["HeroNoteDescription"]);
    var methods = Enumerable.Range(1, 4)
        .Select(index => new PublicServiceOffering(Localizer[$"Method{index}Title"], Localizer[$"Method{index}Description"])).ToArray();
}

<partial name="_PublicServiceHero" model="hero" />

<section class="public-container grid gap-6 py-14 md:py-20 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16" aria-labelledby="development-approach">
    <h2 id="development-approach" class="m-0 text-4xl leading-tight text-[var(--serif-blue-dark)] md:text-5xl">@Localizer["ApproachEyebrow"]</h2>
    <div class="space-y-5 text-lg leading-[1.8] text-[var(--serif-muted)]">
        <p class="m-0">@Localizer["ApproachParagraph1"]</p>
        <p class="m-0">@Localizer["ApproachParagraph2"]</p>
    </div>
</section>

<section class="bg-[var(--serif-soft)]" aria-labelledby="development-audience">
    <div class="public-container grid gap-10 py-14 md:py-20 lg:grid-cols-2 lg:gap-16">
        <div>
            <p class="mb-4 mt-0 font-[family-name:var(--serif-label)] text-xs tracking-[0.12em] text-[var(--serif-muted)] uppercase">@Localizer["AudienceEyebrow"]</p>
            <h2 id="development-audience" class="m-0 text-4xl leading-tight text-[var(--serif-blue-dark)] md:text-5xl">@Localizer["AudienceTitle"]</h2>
            <p class="mb-0 mt-6 text-lg leading-[1.8] text-[var(--serif-muted)]">@Localizer["AudienceDescription"]</p>
        </div>
        <div>
            <h3 class="mb-5 mt-0 text-2xl leading-snug text-[var(--serif-blue-dark)]">@Localizer["HelpEyebrow"]</h3>
            <ul class="m-0 list-none divide-y divide-[var(--serif-border)] p-0">
                @for (var index = 1; index <= 8; index++)
                {
                    <li class="flex gap-4 py-3 text-base leading-relaxed text-[var(--serif-blue-dark)]">
                        <i class="fa-solid fa-check mt-1.5 shrink-0 text-sm text-[var(--id-red)]" aria-hidden="true"></i>
                        <span>@Localizer[$"HelpItem{index}"]</span>
                    </li>
                }
            </ul>
        </div>
    </div>
</section>

<section class="public-container py-14 md:py-20" aria-labelledby="development-methods">
    <h2 id="development-methods" class="mb-9 mt-0 text-4xl leading-tight text-[var(--serif-blue-dark)] md:text-5xl">@Localizer["MethodsEyebrow"]</h2>
    <partial name="_PublicServiceOfferings" model="methods" />
    <div class="mt-7 border-t border-[var(--serif-border)] pt-8 md:mt-10 md:pt-10">
        <p class="m-0 max-w-3xl text-lg leading-[1.8] text-[var(--serif-muted)]">@Localizer["MethodsConclusion"]</p>
        <div class="mt-6 flex flex-wrap gap-3">
            <partial name="_PublicServiceAction" model='new PublicServiceLink(Localizer["MethodsButton"], conversation.Url, true)' />
            <a href="@contactUrl" class="public-btn public-btn-outline gap-3 leading-snug focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--serif-blue-dark)]">@Localizer["ContactButton"] <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
        </div>
    </div>
</section>
