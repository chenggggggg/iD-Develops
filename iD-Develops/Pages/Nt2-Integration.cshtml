@page
@model Nt2IntegrationModel
@inject IStringLocalizer<Nt2IntegrationModel> Localizer
@{
    var culture = CultureInfo.CurrentCulture.Name.ToLowerInvariant();
    ViewData["Title"] = Localizer["Title"];
    ViewData["SeoTitle"] = Localizer["SeoTitle"];
    ViewData["MetaDescription"] = Localizer["MetaDescription"];
    var showExpandedOffer = bool.TryParse(Localizer["ShowExpandedOffer"], out var showExpanded) && showExpanded;
    var conversation = new PublicServiceLink(Localizer["ConversationButton"], "https://koalendar.com/e/meet-with-id", true);
    var offerings = new List<PublicServiceOffering>
    {
        new(Localizer["OfferRegularTitle"], Localizer["OfferRegularDescription"]),
        new(Localizer["OfferDiyTitle"], Localizer["OfferDiyDescription"])
    };
    if (showExpandedOffer)
    {
        offerings.AddRange(Enumerable.Range(1, 5)
            .Select(index => new PublicServiceOffering(Localizer[$"OfferExtra{index}Title"], Localizer[$"OfferExtra{index}Description"])));
    }
}

<section class="public-container pb-12 pt-10 md:pb-16 md:pt-16" data-testid="service-hero" aria-labelledby="service-title">
    <p class="mb-4 mt-0 text-base font-semibold text-[var(--id-red)]">@Localizer["Title"]</p>
    <h1 id="service-title" class="m-0 max-w-3xl text-[clamp(2.125rem,4vw,3.25rem)] leading-[1.15] tracking-[-0.02em] text-[var(--serif-blue-dark)]">@Localizer["HeroTitle"]</h1>
    <div class="mt-7 grid items-start gap-8 md:mt-8 lg:grid-cols-[1.6fr_1fr] lg:gap-12">
        <div>
            <p class="m-0 text-lg leading-[1.75] text-[var(--serif-ink)]/85">@Localizer["HeroDescription"]</p>
            <div class="mt-6 flex flex-wrap gap-3">
                <partial name="_PublicServiceAction" model='new PublicServiceLink(Localizer["LevelTestButton"], $"/{culture}/level-test")' />
                <a href="@conversation.Url" target="_blank" rel="noopener noreferrer" class="public-btn public-btn-outline max-w-full gap-3 leading-snug focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--serif-blue-dark)]">@conversation.Label <i class="fa-solid fa-arrow-right shrink-0" aria-hidden="true"></i></a>
            </div>
        </div>
        <img src="/images/services/nt2-960.webp" srcset="/images/services/nt2-480.webp 480w, /images/services/nt2-960.webp 960w" sizes="(min-width: 1024px) 350px, (min-width: 768px) 700px, calc(100vw - 32px)" width="960" height="640" alt="" fetchpriority="high" class="aspect-[3/2] h-auto w-full rounded-lg object-cover" />
    </div>
</section>

<div class="public-container">
    <div class="mx-auto max-w-3xl border-t border-[var(--serif-border)] py-12 md:py-16">
        <section aria-labelledby="nt2-people">
            <h2 id="nt2-people" class="mb-5 mt-0 text-3xl leading-[1.25] text-[var(--serif-blue-dark)]">@Localizer["HeroNoteTitle"]</h2>
            <div class="flex flex-col gap-6 text-lg leading-[1.8] text-[var(--serif-ink)]/85" data-testid="service-prose">
                <p class="m-0">@Localizer["HeroNoteDescription"]</p>
                <p class="m-0">@Localizer["PromiseParagraph"]</p>
            </div>
        </section>
        <section class="mt-12" aria-labelledby="nt2-approach">
            <h2 id="nt2-approach" class="mb-5 mt-0 text-3xl leading-[1.25] text-[var(--serif-blue-dark)]">@Localizer["WhyUsEyebrow"]</h2>
            <div class="flex flex-col gap-6 text-lg leading-[1.8] text-[var(--serif-ink)]/85" data-testid="service-prose">
                <p class="m-0">@Localizer["WhyUsParagraph1"]</p>
                <p class="m-0">@Localizer["WhyUsParagraph2"]</p>
                <p class="m-0">@Localizer["WhyUsParagraph3"]</p>
            </div>
        </section>
        <section class="mt-12 border-t border-[var(--serif-border)] pt-10" aria-labelledby="nt2-tailored">
            <p class="mb-3 mt-0 text-base font-semibold text-[var(--serif-muted)]">@Localizer["TailoredEyebrow"]</p>
            <h2 id="nt2-tailored" class="mb-5 mt-0 text-3xl leading-[1.25] text-[var(--serif-blue-dark)] md:text-4xl">@Localizer["TailoredTitle"]</h2>
            <div class="flex flex-col gap-6 text-lg leading-[1.8] text-[var(--serif-ink)]/85" data-testid="service-prose">
                <p class="m-0">@Localizer["TailoredParagraph1"]</p>
                <p class="m-0">@Localizer["TailoredParagraph2"]</p>
                <p class="m-0">@Localizer["TailoredParagraph3"]</p>
            </div>
        </section>
    </div>
</div>

<section class="border-y border-[var(--serif-border)] bg-white" aria-labelledby="nt2-offer">
    <div class="public-container py-12 md:py-16">
        <h2 id="nt2-offer" class="mb-7 mt-0 text-3xl leading-[1.25] text-[var(--serif-blue-dark)] md:text-4xl">@Localizer["OfferEyebrow"]</h2>
        <div data-testid="service-offerings">
            <div class="grid gap-5 md:grid-cols-2">
                @foreach (var offering in offerings.Take(2))
                {
                    <article class="min-w-0 rounded-lg border border-[var(--serif-border)] p-6 md:p-8">
                        <h3 class="m-0 font-[family-name:var(--serif-body)] text-xl font-semibold leading-snug text-[var(--serif-blue-dark)]">@offering.Title</h3>
                        <p class="mb-0 mt-4 text-lg leading-[1.75] text-[var(--serif-ink)]/85">@offering.Description</p>
                    </article>
                }
            </div>
            @if (showExpandedOffer)
            {
                <div class="mt-8 divide-y divide-[var(--serif-border)]">
                    @foreach (var offering in offerings.Skip(2))
                    {
                        <article class="grid min-w-0 gap-3 py-6 md:grid-cols-[1fr_2fr] md:gap-10">
                            <h3 class="m-0 font-[family-name:var(--serif-body)] text-xl font-semibold leading-snug text-[var(--serif-blue-dark)]">@offering.Title</h3>
                            <p class="m-0 text-lg leading-[1.75] text-[var(--serif-ink)]/85">@offering.Description</p>
                        </article>
                    }
                </div>
            }
        </div>
        <div class="mt-8 flex flex-wrap gap-3">
            <partial name="_PublicServiceAction" model='new PublicServiceLink(Localizer["ContactButton"], Url.Page("/Contact", new { culture })!)' />
            <a href="@conversation.Url" target="_blank" rel="noopener noreferrer" class="public-btn public-btn-outline max-w-full gap-3 leading-snug focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--serif-blue-dark)]">@Localizer["FreeConversationButton"] <i class="fa-solid fa-arrow-right shrink-0" aria-hidden="true"></i></a>
        </div>
    </div>
</section>

@if (showExpandedOffer)
{
    <section class="public-container py-12 md:py-16" aria-labelledby="nt2-testimonials">
        <div class="mx-auto max-w-3xl">
            <h2 id="nt2-testimonials" class="mb-7 mt-0 text-3xl leading-[1.25] text-[var(--serif-blue-dark)]">@Localizer["TestimonialsEyebrow"]</h2>
            <div class="flex flex-col gap-6">
                @for (var index = 1; index <= 3; index++)
                {
                    <blockquote class="m-0 text-lg italic leading-[1.8] text-[var(--serif-ink)]/85">
                        <p class="m-0">@Localizer[$"Testimonial{index}"]</p>
                    </blockquote>
                }
            </div>
        </div>
    </section>
}
