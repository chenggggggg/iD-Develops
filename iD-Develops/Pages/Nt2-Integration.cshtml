@page
@model Nt2IntegrationModel
@inject IStringLocalizer<Nt2IntegrationModel> Localizer
@{
    var culture = CultureInfo.CurrentCulture.Name.ToLowerInvariant();
    ViewData["Title"] = Localizer["Title"];
    ViewData["SeoTitle"] = Localizer["SeoTitle"];
    ViewData["MetaDescription"] = Localizer["MetaDescription"];
    var showExpandedOffer = bool.TryParse(Localizer["ShowExpandedOffer"], out var showExpanded) && showExpanded;
    var conversation = new PublicServiceLink(Localizer["ConversationButton"], "https://koalendar.com/e/meet-with-id", true);
    var realDutch = PublicServiceText.Balanced(Localizer["WhyUsParagraph2"]);
    var offerings = new List<PublicServiceOffering>
    {
        new(Localizer["OfferRegularTitle"], Localizer["OfferRegularDescription"]),
        new(Localizer["OfferDiyTitle"], Localizer["OfferDiyDescription"])
    };
    if (showExpandedOffer)
    {
        offerings.AddRange(Enumerable.Range(1, 5)
            .Select(index => new PublicServiceOffering(Localizer[$"OfferExtra{index}Title"], Localizer[$"OfferExtra{index}Description"])));
    }
}

<section data-testid="service-hero" aria-labelledby="service-title">
    <div class="public-container grid items-start gap-9 pb-12 pt-10 md:pb-16 md:pt-16 lg:grid-cols-12 lg:gap-10" data-testid="service-frame">
        <div class="min-w-0 lg:col-span-7 lg:col-start-6 lg:row-start-1">
            <p class="mb-5 mt-0 text-base font-semibold text-[var(--id-red)]">@Localizer["Title"]</p>
            <h1 id="service-title" class="m-0 text-[clamp(2.25rem,4vw,3.5rem)] leading-[1.12] tracking-[-0.025em] text-balance text-[var(--serif-blue-dark)]">@Localizer["HeroTitle"]</h1>
            <p class="mb-0 mt-6 text-lg leading-[1.8] text-[var(--serif-ink)]/85">@Localizer["HeroDescription"]</p>
            <div class="mt-7 flex flex-wrap gap-3">
                <partial name="_PublicServiceAction" model='new PublicServiceLink(Localizer["LevelTestButton"], $"/{culture}/level-test")' />
                <a href="@conversation.Url" target="_blank" rel="noopener noreferrer" class="public-btn public-btn-outline max-w-full touch-manipulation gap-3 leading-snug focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--serif-blue-dark)]">@conversation.Label <i class="fa-solid fa-arrow-right shrink-0" aria-hidden="true"></i></a>
            </div>
        </div>
        <figure class="m-0 min-w-0 lg:col-span-5 lg:col-start-1 lg:row-start-1">
            <img src="/images/services/nt2-960.webp" srcset="/images/services/nt2-480.webp 480w, /images/services/nt2-960.webp 960w" sizes="(min-width: 1024px) 380px, (min-width: 768px) 700px, calc(100vw - 32px)" width="960" height="640" alt="" fetchpriority="high" class="aspect-[4/3] h-auto w-full rounded-lg object-cover" />
            <figcaption class="mt-7">
                <h2 class="mb-3 mt-0 text-2xl leading-snug text-[var(--serif-blue-dark)]">@Localizer["HeroNoteTitle"]</h2>
                <p class="m-0 text-lg leading-[1.75] text-[var(--serif-ink)]/85">@Localizer["HeroNoteDescription"]</p>
            </figcaption>
        </figure>
    </div>
</section>

<section class="border-y border-[var(--serif-border)] bg-[var(--serif-soft)]" aria-labelledby="nt2-approach">
    <div class="public-container grid gap-7 py-12 md:py-16 lg:grid-cols-12 lg:gap-x-10" data-testid="service-frame">
        <h2 id="nt2-approach" class="m-0 text-3xl leading-tight text-[var(--serif-blue-dark)] md:text-4xl lg:col-span-12">@Localizer["WhyUsEyebrow"]</h2>
        <p class="m-0 text-lg leading-[1.8] text-[var(--serif-ink)]/85 lg:col-span-8">@Localizer["WhyUsParagraph1"]</p>
        <aside class="border-t-2 border-[var(--id-red)] pt-5 lg:col-span-4">
            <p class="m-0 text-lg font-semibold leading-[1.8] text-[var(--serif-blue-dark)]">@Localizer["PromiseParagraph"]</p>
        </aside>
        <div class="grid min-w-0 gap-6 border-t border-[var(--serif-border)] pt-7 text-lg leading-[1.8] text-[var(--serif-ink)]/85 md:grid-cols-2 md:gap-10 lg:col-span-12" data-testid="service-prose">
            <p class="m-0">@realDutch.Opening</p>
            @if (!string.IsNullOrWhiteSpace(realDutch.Remainder))
            {
                <p class="m-0">@realDutch.Remainder</p>
            }
        </div>
        <p class="mb-0 mt-2 text-xl leading-[1.7] text-[var(--serif-blue-dark)] md:text-2xl lg:col-span-12">@Localizer["WhyUsParagraph3"]</p>
    </div>
</section>

<section aria-labelledby="nt2-tailored">
    <div class="public-container grid gap-7 py-12 md:py-16 lg:grid-cols-12 lg:gap-x-10" data-testid="service-frame">
        <div class="lg:col-span-12">
            <p class="mb-3 mt-0 text-base font-semibold text-[var(--id-red)]">@Localizer["TailoredEyebrow"]</p>
            <h2 id="nt2-tailored" class="m-0 text-3xl leading-tight text-[var(--serif-blue-dark)] md:text-4xl">@Localizer["TailoredTitle"]</h2>
        </div>
        <p class="m-0 text-lg leading-[1.8] text-[var(--serif-ink)]/85 lg:col-span-6">@Localizer["TailoredParagraph1"]</p>
        <div class="flex min-w-0 flex-col gap-6 text-lg leading-[1.8] text-[var(--serif-ink)]/85 lg:col-span-6" data-testid="service-prose">
            <p class="m-0">@Localizer["TailoredParagraph2"]</p>
            <p class="m-0 font-semibold text-[var(--serif-blue-dark)]">@Localizer["TailoredParagraph3"]</p>
            <div>
                <a href="/@culture/level-test" class="public-link min-h-11 touch-manipulation underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--serif-blue-dark)]">@Localizer["LevelTestButton"] <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
            </div>
        </div>
    </div>
</section>

<section class="border-y border-[var(--serif-border)] bg-white" aria-labelledby="nt2-offer">
    <div class="public-container py-12 md:py-16" data-testid="service-frame">
        <h2 id="nt2-offer" class="mb-7 mt-0 text-3xl leading-tight text-[var(--serif-blue-dark)] md:text-4xl">@Localizer["OfferEyebrow"]</h2>
        <div data-testid="service-offerings">
            <div class="grid gap-5 md:grid-cols-2">
                @foreach (var offering in offerings.Take(2))
                {
                    <article class="min-w-0 rounded-lg border border-[var(--serif-border)] bg-[var(--serif-bg)] p-6 md:p-8">
                        <h3 class="m-0 font-[family-name:var(--serif-body)] text-xl font-semibold leading-snug text-[var(--serif-blue-dark)]">@offering.Title</h3>
                        <p class="mb-0 mt-4 text-lg leading-[1.75] text-[var(--serif-ink)]/85">@offering.Description</p>
                    </article>
                }
            </div>
            @if (showExpandedOffer)
            {
                <div class="mt-8 divide-y divide-[var(--serif-border)]">
                    @foreach (var offering in offerings.Skip(2))
                    {
                        <article class="grid min-w-0 gap-3 py-6 md:grid-cols-[1fr_2fr] md:gap-10">
                            <h3 class="m-0 font-[family-name:var(--serif-body)] text-xl font-semibold leading-snug text-[var(--serif-blue-dark)]">@offering.Title</h3>
                            <p class="m-0 text-lg leading-[1.75] text-[var(--serif-ink)]/85">@offering.Description</p>
                        </article>
                    }
                </div>
            }
        </div>
        <div class="mt-8 flex flex-wrap gap-3">
            <partial name="_PublicServiceAction" model='new PublicServiceLink(Localizer["ContactButton"], Url.Page("/Contact", new { culture })!)' />
            <a href="@conversation.Url" target="_blank" rel="noopener noreferrer" class="public-btn public-btn-outline max-w-full touch-manipulation gap-3 leading-snug focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--serif-blue-dark)]">@Localizer["FreeConversationButton"] <i class="fa-solid fa-arrow-right shrink-0" aria-hidden="true"></i></a>
        </div>
    </div>
</section>

@if (showExpandedOffer)
{
    <section aria-labelledby="nt2-testimonials">
        <div class="public-container grid gap-7 py-12 md:py-16 lg:grid-cols-12 lg:gap-x-10" data-testid="service-frame">
            <h2 id="nt2-testimonials" class="m-0 text-3xl leading-tight text-[var(--serif-blue-dark)] lg:col-span-12">@Localizer["TestimonialsEyebrow"]</h2>
            <blockquote class="m-0 font-[family-name:var(--serif-heading)] text-2xl leading-relaxed text-[var(--serif-blue-dark)] lg:col-span-6">
                <p class="m-0">@Localizer["Testimonial1"]</p>
            </blockquote>
            <div class="flex flex-col gap-6 text-lg italic leading-[1.8] text-[var(--serif-ink)]/85 lg:col-span-6">
                <blockquote class="m-0"><p class="m-0">@Localizer["Testimonial2"]</p></blockquote>
                <blockquote class="m-0"><p class="m-0">@Localizer["Testimonial3"]</p></blockquote>
            </div>
        </div>
    </section>
}
