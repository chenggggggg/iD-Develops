@page
@model Nt2IntegrationModel
@using System.Globalization
@inject IStringLocalizer<Nt2IntegrationModel> Localizer
@{
    var levelTestUrl = $"/{CultureInfo.CurrentCulture.Name.ToLowerInvariant()}/level-test";
    ViewData["Title"] = Localizer["Title"];
    ViewData["SeoTitle"] = Localizer["SeoTitle"];
    ViewData["MetaDescription"] = Localizer["MetaDescription"];
    var showExpandedOffer = bool.TryParse(Localizer["ShowExpandedOffer"], out var showExpanded) && showExpanded;
}

<section class="public-hero-page">
    <div class="public-container">
        <div class="public-hero-grid">
            <div>
                <p class="public-eyebrow public-eyebrow-left">@Localizer["Title"]</p>
                <h1 class="public-hero-title mx-0">@Localizer["HeroTitle"]</h1>
                <p class="public-hero-copy mx-0">@Localizer["HeroDescription"]</p>
                <div class="public-actions justify-start">
                    <a href="@levelTestUrl" class="public-btn public-btn-primary">@Localizer["LevelTestButton"] <i class="fas fa-arrow-right"></i></a>
                    <a href="https://koalendar.com/e/meet-with-id" target="_blank" rel="noopener noreferrer" class="public-btn public-btn-outline">@Localizer["ConversationButton"] <i class="fas fa-arrow-right"></i></a>
                </div>
            </div>
            <div class="public-hero-note"><h2>@Localizer["HeroNoteTitle"]</h2><p class="public-copy">@Localizer["HeroNoteDescription"]</p></div>
        </div>
    </div>
</section>

<section class="public-section">
    <div class="public-container public-content-narrow mx-auto">
        <p class="public-copy">@Localizer["PromiseParagraph"]</p>
        <p class="public-eyebrow public-eyebrow-left mt-16">@Localizer["WhyUsEyebrow"]</p>
        <p class="public-copy">@Localizer["WhyUsParagraph1"]</p>
        <p class="public-copy">@Localizer["WhyUsParagraph2"]</p>
        <p class="public-copy">@Localizer["WhyUsParagraph3"]</p>
    </div>
</section>

<section class="public-section public-section-soft">
    <div class="public-container">
        <div class="public-two-column">
            <div><p class="public-eyebrow public-eyebrow-left">@Localizer["TailoredEyebrow"]</p><h2 class="public-section-title">@Localizer["TailoredTitle"]</h2></div>
            <div><p class="public-copy">@Localizer["TailoredParagraph1"]</p><p class="public-copy">@Localizer["TailoredParagraph2"]</p><p class="public-copy">@Localizer["TailoredParagraph3"]</p></div>
        </div>
    </div>
</section>

<section class="public-section">
    <div class="public-container">
        <div class="public-section-heading public-section-heading-center"><p class="public-eyebrow">@Localizer["OfferEyebrow"]</p></div>
        <div class="public-feature-grid mx-auto max-w-6xl md:grid-cols-2 xl:grid-cols-3">
            <article class="public-feature-card"><h3>@Localizer["OfferRegularTitle"]</h3><p class="public-copy">@Localizer["OfferRegularDescription"]</p></article>
            <article class="public-feature-card"><h3>@Localizer["OfferDiyTitle"]</h3><p class="public-copy">@Localizer["OfferDiyDescription"]</p></article>
            @if (showExpandedOffer)
            {
                @for (var index = 1; index <= 5; index++)
                {
                    <article class="public-feature-card"><h3>@Localizer[$"OfferExtra{index}Title"]</h3><p class="public-copy">@Localizer[$"OfferExtra{index}Description"]</p></article>
                }
            }
        </div>
        @if (showExpandedOffer)
        {
            <div class="public-content-narrow mx-auto mt-16">
                <p class="public-eyebrow public-eyebrow-left">@Localizer["TestimonialsEyebrow"]</p>
                @for (var index = 1; index <= 3; index++)
                {
                    <p class="public-copy">@Localizer[$"Testimonial{index}"]</p>
                }
            </div>
        }
        <div class="public-actions">
            <a asp-page="/contact" asp-route-culture="@CultureInfo.CurrentCulture.Name.ToLowerInvariant()" class="public-btn public-btn-primary">@Localizer["ContactButton"] <i class="fas fa-arrow-right"></i></a>
            <a href="https://koalendar.com/e/meet-with-id" target="_blank" rel="noopener noreferrer" class="public-btn public-btn-outline">@Localizer["FreeConversationButton"] <i class="fas fa-arrow-right"></i></a>
        </div>
    </div>
</section>
