@page
@model iD_Develops.Pages.Examination.CompletedModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<iD_Develops.Pages.Portal.Examination.CompletedModel> Localizer
@{
    Layout = null;
    ViewData["Title"] = Localizer["CompletedTitle"];
}
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - iD-Develops</title>
    <link rel="stylesheet" href="~/css/tailwind.generated.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/examination.css" asp-append-version="true" />
</head>
<body>
    @if (Model.ShowLevelTestCompletedPartial)
    {
        <partial name="_LevelTestCompletedPartial" model="Model" />
    }
    else
    {
        <div class="flex min-h-screen items-center justify-center px-4 text-center">
            <div>
                <h2>
                    @Localizer["ExamSubmittedHeading"]
                </h2>
                <p>
                    @Localizer["ExamSubmittedPrefix"] <a asp-page="/Portal/Home/Index">@Localizer["HereAction"]</a> @Localizer["ExamSubmittedSuffix"]
                </p>
            </div>
        </div>
    }
</body>
