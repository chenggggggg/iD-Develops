@page
@model iD_Develops.Pages.Examination.ResultsModel
@using System.Globalization
@{
    var levelTestUrl = $"/{CultureInfo.CurrentCulture.Name.ToLowerInvariant()}/level-test";
    ViewData["Title"] = "Level Test Results";
    ViewData["BodyClass"] = "public-result-page";
}

@section Styles {
    <link rel="stylesheet" href="~/css/examination.css" asp-append-version="true" />
}

@if (Model.IsInvalidResult || Model.Summary == null)
{
    <section class="public-result-shell">
        <div class="container">
            <div class="public-result-invalid">
                <p class="public-result-eyebrow">Result unavailable</p>
                <h1>We could not open this result</h1>
                <p>The link may be expired, incomplete, or not connected to a completed level test.</p>
                <div class="public-result-actions">
                    <a class="public-result-button" href="@levelTestUrl">Take the level test</a>
                    <a class="public-result-button public-result-button-secondary" asp-page="/Contact">Contact us</a>
                </div>
            </div>
        </div>
    </section>
}
else
{
    <section class="public-result-hero">
        <div class="container">
            <div class="public-result-hero-grid">
                <div class="public-result-hero-copy">
                    <p class="public-result-eyebrow">Your level test result</p>
                    <h1>@Model.Summary.ExamName</h1>
                    <p class="public-result-lead">@Model.Summary.AdviceText</p>
                    <div class="public-result-actions">
                        <a class="public-result-button" href="https://koalendar.com/e/test-results-options" target="_blank" rel="noopener noreferrer">Book advice call</a>
                        <a class="public-result-button public-result-button-secondary" asp-page="/Pricing">View pricing</a>
                    </div>
                </div>
                <div class="public-result-score-panel">
                    <div class="public-result-score-ring" style="--score-percent: @Model.Summary.ScorePercentage;">
                        <div>
                            <span>@Model.Summary.ScorePercentage%</span>
                            <small>@Model.Summary.Score.ToString("0.##") / @Model.Summary.MaxScore.ToString("0.##") points</small>
                        </div>
                    </div>
                    <div class="public-result-score-meta">
                        <p>@Model.Summary.GradeLabel</p>
                        <strong>@Model.Summary.GradeValue</strong>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="public-result-content">
        <div class="container">
            <div class="public-result-stats">
                <article>
                    <span>Score</span>
                    <strong>@Model.Summary.Score.ToString("0.##") / @Model.Summary.MaxScore.ToString("0.##")</strong>
                </article>
                <article>
                    <span>Correct answers</span>
                    <strong>@Model.Summary.CorrectAnswers / @Model.Summary.TotalQuestions</strong>
                </article>
                <article>
                    <span>Completed</span>
                    <strong>@((Model.Summary.EndDateTime ?? Model.Summary.StartDateTime).ToLocalTime().ToString("dd MMM yyyy"))</strong>
                </article>
            </div>

            <div class="public-result-section-heading">
                <p class="public-result-eyebrow">Personal advice</p>
                <h2>@Model.Summary.AdviceTitle</h2>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.Summary.CompletionText))
            {
                <div class="public-result-advice">
                    @Html.Raw(Model.Summary.CompletionText)
                </div>
            }

            <div class="public-result-section-heading">
                <p class="public-result-eyebrow">Question review</p>
                <h2>See where you were strong and what to practise next</h2>
            </div>

            <div class="public-result-question-list">
                @foreach (var question in Model.Questions)
                {
                    <article class="public-result-question">
                        <div class="public-result-question-header">
                            <span>Question @question.QuestionNumber</span>
                            <strong class="@question.ResultBadgeClass">@question.ResultLabel</strong>
                        </div>

                        <div class="public-result-question-text">
                            @Html.Raw(question.QuestionHtml)
                        </div>

                        @if (question.MultipleChoiceOptions.Count > 0)
                        {
                            <div class="public-result-option-grid">
                                @foreach (var option in question.MultipleChoiceOptions)
                                {
                                    var optionClass = option.IsCorrect
                                        ? "public-result-option public-result-option-correct"
                                        : option.IsSelected
                                            ? "public-result-option public-result-option-selected"
                                            : "public-result-option";

                                    <div class="@optionClass">
                                        <span>@option.Key</span>
                                        <p>@option.Text</p>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="public-result-answer-grid">
                                <div>
                                    <span>Your answer</span>
                                    <p>@question.SubmittedAnswer</p>
                                </div>
                                <div>
                                    <span>Correct answer</span>
                                    <p>@question.CorrectAnswer</p>
                                </div>
                            </div>
                        }

                        <div class="public-result-notes">
                            <div>
                                <span>Feedback</span>
                                @if (string.IsNullOrWhiteSpace(question.FeedbackHtml))
                                {
                                    <p>No feedback was added for this question.</p>
                                }
                                else
                                {
                                    <div>@Html.Raw(question.FeedbackHtml)</div>
                                }
                            </div>
                            <div>
                                <span>Extra note</span>
                                @if (string.IsNullOrWhiteSpace(question.FunFactHtml))
                                {
                                    <p>No additional note was added for this question.</p>
                                }
                                else
                                {
                                    <div>@Html.Raw(question.FunFactHtml)</div>
                                }
                            </div>
                        </div>
                    </article>
                }
            </div>
        </div>
    </section>
}
