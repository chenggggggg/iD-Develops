@model iD_Develops.Pages.Portal.Home.DashboardEventsModel
<section class="rounded-xl border border-[#dfe5ec] bg-white p-5 shadow-[0_1px_3px_rgba(2,7,47,0.05)]" aria-labelledby="eventsHeading">
    <div class="flex items-end justify-between gap-4">
        <div>
            <p class="m-0 text-xs font-semibold uppercase tracking-[0.1em] text-[#64748b]">Schedule</p>
            <h2 id="eventsHeading" class="mt-1 mb-0 text-xl font-semibold text-[#071f3d]">@Model.Title</h2>
        </div>
        <a class="text-sm font-semibold text-[#005190] no-underline hover:underline" asp-page="/Portal/Schedule/Index">Full calendar</a>
    </div>
    @if (Model.Events.Count == 0)
    {
        <p class="mt-5 mb-0 rounded-lg bg-[#f6f8fa] px-4 py-5 text-sm text-[#64748b]">Nothing is scheduled during the next seven days.</p>
    }
    else
    {
        <div class="mt-5 divide-y divide-[#e5eaf0]">
            @foreach (var item in Model.Events)
            {
                <article class="grid gap-3 py-4 first:pt-0 last:pb-0 sm:grid-cols-[8rem_minmax(0,1fr)_auto] sm:items-center">
                    <div>
                        <time class="block text-sm font-semibold text-[#005190]" datetime="@item.StartAtUtc.ToString("O")">@item.StartAtUtc.ToString("ddd, d MMM")</time>
                        <span class="text-xs text-[#64748b]">@item.StartAtUtc.ToString("HH:mm")–@item.EndAtUtc.ToString("HH:mm") UTC</span>
                    </div>
                    <div class="min-w-0">
                        <h3 class="m-0 truncate text-sm font-semibold text-[#071f3d]">@item.Title</h3>
                        <p class="mt-1 mb-0 truncate text-xs text-[#64748b]">@(string.IsNullOrWhiteSpace(item.CourseName) ? "Independent session" : item.CourseName) · @item.TeacherName</p>
                    </div>
                    @if (Model.ShowStatus)
                    {
                        <span class="rounded-full bg-[#eef6f4] px-2.5 py-1 text-xs font-semibold text-[#287a55]">Scheduled</span>
                    }
                </article>
            }
        </div>
    }
</section>
