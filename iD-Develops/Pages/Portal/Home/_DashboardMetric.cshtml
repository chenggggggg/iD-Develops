@model iD_Develops.Pages.Portal.Home.DashboardMetric
@{
    var colors = Model.Tone switch
    {
        "green" => "bg-[#eef6f4] text-[#287a55]",
        "rose" => "bg-[#f7eff1] text-[#B23A48]",
        "amber" => "bg-[#fff6e7] text-[#9a6500]",
        _ => "bg-[#eaf3fa] text-[#005190]"
    };
}
<article class="flex items-center gap-4 rounded-xl border border-[#dfe5ec] bg-white p-4 shadow-[0_1px_3px_rgba(2,7,47,0.05)]">
    <span class="grid size-11 flex-none place-items-center rounded-lg @colors" aria-hidden="true"><i class="fa-solid @Model.Icon"></i></span>
    <span>
        <span class="block text-xs font-semibold uppercase tracking-[0.07em] text-[#64748b]">@Model.Label</span>
        <strong class="mt-0.5 block text-2xl font-semibold leading-none text-[#071f3d]">@Model.Value</strong>
    </span>
</article>
