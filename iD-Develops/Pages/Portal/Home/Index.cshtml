@page
@model iD_Develops.Pages.Portal.Home.IndexModel
@{
    Layout = "_PortalLayout";
    ViewData["Title"] = "Home";
    ViewData["HideFooterNavigation"] = true;
}

<section class="mx-auto flex w-full max-w-[1440px] flex-col gap-6 px-4 py-6 sm:px-6 lg:px-8">
    <header class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
        <div>
            <p class="m-0 text-xs font-semibold uppercase tracking-[0.14em] text-[#005190]">Dashboard</p>
            <h1 class="mt-1 mb-0 text-3xl font-semibold tracking-tight text-[#071f3d]">Welcome back, @Model.DisplayName.</h1>
            <p class="mt-2 mb-0 text-sm text-[#64748b]">
                @switch (Model.Role)
                {
                    case DashboardRole.Admin:
                        <text>Here is the current operational picture across your learning platform.</text>
                        break;
                    case DashboardRole.Teacher:
                        <text>Your courses, learners, exams, and upcoming teaching schedule at a glance.</text>
                        break;
                    default:
                        <text>Pick up where you left off and see what is coming next.</text>
                        break;
                }
            </p>
        </div>
        <div class="flex flex-wrap gap-2">
            @if (Model.Role == DashboardRole.Student)
            {
                <a class="portal-btn portal-btn-primary" asp-page="/Portal/Courses/Index">Continue learning</a>
                <a class="portal-btn portal-btn-outline" asp-page="/Portal/Exams/List">View exams</a>
            }
            else
            {
                <a class="portal-btn portal-btn-primary" asp-page="/Portal/Schedule/Index">Open calendar</a>
                <a class="portal-btn portal-btn-outline" asp-page="/Portal/Exams/Create">Create exam</a>
            }
        </div>
    </header>

    @if (Model.Role == DashboardRole.Student && Model.Student is { } student)
    {
        <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-4" aria-label="Your learning overview">
            <partial name="_DashboardMetric" model='new DashboardMetric("Average exam score", student.AverageExamScore.HasValue ? student.AverageExamScore.Value.ToString("0.#") : "—", "fa-chart-line", "blue")' />
            <partial name="_DashboardMetric" model='new DashboardMetric("Assigned exams", student.AssignedExamCount.ToString(), "fa-file-circle-check", "green")' />
            <partial name="_DashboardMetric" model='new DashboardMetric("Attended sessions", student.AttendedSessionCount.ToString(), "fa-calendar-check", "rose")' />
            <partial name="_DashboardMetric" model='new DashboardMetric("Completed lectures", student.CompletedLectureCount.ToString(), "fa-book-open-reader", "amber")' />
        </div>

        <div class="grid gap-6 xl:grid-cols-[minmax(0,1.6fr)_minmax(20rem,0.9fr)]">
            <section class="rounded-xl border border-[#dfe5ec] bg-white p-5 shadow-[0_1px_3px_rgba(2,7,47,0.05)]" aria-labelledby="courseProgressHeading">
                <div class="flex items-end justify-between gap-4">
                    <div>
                        <p class="m-0 text-xs font-semibold uppercase tracking-[0.1em] text-[#64748b]">Learning</p>
                        <h2 id="courseProgressHeading" class="mt-1 mb-0 text-xl font-semibold text-[#071f3d]">Course progress</h2>
                    </div>
                    <a class="text-sm font-semibold text-[#005190] no-underline hover:underline" asp-page="/Portal/Courses/Index">All courses</a>
                </div>
                @if (student.Courses.Count == 0)
                {
                    <p class="mt-6 mb-0 rounded-lg bg-[#f6f8fa] px-4 py-5 text-sm text-[#64748b]">No courses are assigned to your account yet.</p>
                }
                else
                {
                    <div class="mt-5 grid gap-3">
                        @foreach (var course in student.Courses)
                        {
                            <a class="block rounded-lg border border-[#e5eaf0] p-4 text-inherit no-underline transition hover:border-[#8eb8d6] hover:bg-[#f8fbfd]" asp-page="/Portal/Courses/Course" asp-route-courseId="@course.Id">
                                <div class="flex items-center justify-between gap-4">
                                    <strong class="text-sm font-semibold text-[#071f3d]">@course.Name</strong>
                                    <span class="text-xs font-semibold text-[#005190]">@course.ProgressPercent%</span>
                                </div>
                                <progress class="mt-3 block h-2 w-full overflow-hidden rounded-full accent-[#005190]" max="100" value="@course.ProgressPercent" aria-label="@course.Name progress"></progress>
                                <span class="mt-2 block text-xs text-[#64748b]">@course.CompletedItemCount of @course.TotalItemCount required items complete</span>
                            </a>
                        }
                    </div>
                }
            </section>

            <div class="grid content-start gap-4">
                <section class="rounded-xl bg-[#071f3d] p-5 text-white" aria-labelledby="continueHeading">
                    <p class="m-0 text-xs font-semibold uppercase tracking-[0.1em] text-[#9fc7e4]">Up next</p>
                    @if (student.NextItem is { } nextItem)
                    {
                        <h2 id="continueHeading" class="mt-2 mb-1 text-xl font-semibold">@nextItem.Title</h2>
                        <p class="m-0 text-sm text-[#cbd8e5]">@nextItem.CourseName · @nextItem.ContentType</p>
                        <a class="mt-5 inline-flex items-center gap-2 rounded-md bg-white px-4 py-2 text-sm font-semibold text-[#071f3d] no-underline" asp-page="/Portal/Courses/Course" asp-route-courseId="@nextItem.CourseId" asp-route-contentType="@nextItem.ContentType" asp-route-contentId="@nextItem.ContentId">Open item <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
                    }
                    else
                    {
                        <h2 id="continueHeading" class="mt-2 mb-1 text-xl font-semibold">You are all caught up</h2>
                        <p class="m-0 text-sm text-[#cbd8e5]">There are no unlocked incomplete course items right now.</p>
                    }
                </section>
                <section class="rounded-xl border border-[#dfe5ec] bg-white p-5">
                    <p class="m-0 text-xs font-semibold uppercase tracking-[0.1em] text-[#64748b]">Next course unlock</p>
                    @if (student.NextUnlockAtUtc.HasValue)
                    {
                        <time class="mt-2 block text-lg font-semibold text-[#071f3d]" datetime="@student.NextUnlockAtUtc.Value.ToString("O")">@student.NextUnlockAtUtc.Value.ToString("ddd, d MMM yyyy · HH:mm") UTC</time>
                    }
                    else
                    {
                        <p class="mt-2 mb-0 text-sm text-[#64748b]">No future course unlocks are scheduled.</p>
                    }
                </section>
            </div>
        </div>

        <partial name="_DashboardEvents" model='new DashboardEventsModel("Your next 7 days", student.UpcomingEvents, false)' />
    }
    else if (Model.Staff is { } staff)
    {
        <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-4" aria-label="Dashboard overview">
            @if (Model.Role == DashboardRole.Admin)
            {
                <partial name="_DashboardMetric" model='new DashboardMetric("Active users", staff.PeopleCount.ToString(), "fa-users", "blue")' />
                <partial name="_DashboardMetric" model='new DashboardMetric("Courses", staff.CourseCount.ToString(), "fa-graduation-cap", "green")' />
                <partial name="_DashboardMetric" model='new DashboardMetric("Published exams", staff.ExamCount.ToString(), "fa-file-circle-check", "rose")' />
                <partial name="_DashboardMetric" model='new DashboardMetric("Draft exams", staff.DraftExamCount.ToString(), "fa-pen-to-square", "amber")' />
            }
            else
            {
                <partial name="_DashboardMetric" model='new DashboardMetric("Events this week", staff.UpcomingEventCount.ToString(), "fa-calendar-days", "blue")' />
                <partial name="_DashboardMetric" model='new DashboardMetric("My courses", staff.CourseCount.ToString(), "fa-graduation-cap", "green")' />
                <partial name="_DashboardMetric" model='new DashboardMetric("My exams", staff.ExamCount.ToString(), "fa-file-circle-check", "rose")' />
                <partial name="_DashboardMetric" model='new DashboardMetric("Course learners", staff.PeopleCount.ToString(), "fa-users", "amber")' />
            }
        </div>

        <div class="grid gap-6 xl:grid-cols-[minmax(0,1.6fr)_minmax(19rem,0.8fr)]">
            <partial name="_DashboardEvents" model='new DashboardEventsModel(Model.Role == DashboardRole.Admin ? "Platform schedule · next 7 days" : "Your teaching week", staff.UpcomingEvents, Model.Role == DashboardRole.Admin)' />
            <section class="rounded-xl border border-[#dfe5ec] bg-white p-5 shadow-[0_1px_3px_rgba(2,7,47,0.05)]" aria-labelledby="quickActionsHeading">
                <p class="m-0 text-xs font-semibold uppercase tracking-[0.1em] text-[#64748b]">Shortcuts</p>
                <h2 id="quickActionsHeading" class="mt-1 mb-4 text-xl font-semibold text-[#071f3d]">Quick actions</h2>
                <div class="grid gap-2">
                    <a class="portal-btn portal-btn-primary justify-center" asp-page="/Portal/Exams/Create"><i class="fa-solid fa-plus" aria-hidden="true"></i> Create exam</a>
                    <a class="portal-btn portal-btn-outline justify-center" asp-page="/Portal/Exams/Assignments"><i class="fa-solid fa-user-check" aria-hidden="true"></i> Assign exam</a>
                    <a class="portal-btn portal-btn-outline justify-center" asp-page="/Portal/Courses/Index"><i class="fa-solid fa-graduation-cap" aria-hidden="true"></i> Manage courses</a>
                    <a class="portal-btn portal-btn-outline justify-center" asp-page="/Portal/Schedule/Index"><i class="fa-solid fa-calendar" aria-hidden="true"></i> Open calendar</a>
                    @if (Model.Role == DashboardRole.Admin)
                    {
                        <a class="portal-btn portal-btn-outline justify-center" asp-page="/Portal/Admin/Users"><i class="fa-solid fa-users-gear" aria-hidden="true"></i> Manage users</a>
                    }
                </div>
            </section>
        </div>
    }
</section>
