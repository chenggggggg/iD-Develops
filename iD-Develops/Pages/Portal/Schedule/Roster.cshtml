@page "/calendar/roster"
@using System.Text.Json
@using iD_Develops.Enums
@using iD_Develops.Services
@model iD_Develops.Pages.Portal.Schedule.RosterModel
@{
    Layout = "_PortalLayout";
    ViewData["Title"] = "Manage roster";
    ViewData["BodyClass"] = "portal-roster-page";
}

<section class="portal-page-shell roster-page" data-roster-root>
    <header class="portal-page-header roster-page-header">
        <div class="portal-page-header-copy">
            <a class="roster-back-link" asp-page="/Portal/Schedule/Index">
                <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
                Calendar
            </a>
            <p class="portal-eyebrow">Scheduling</p>
            <h1 class="portal-title-sm">Manage roster</h1>
            <p class="portal-copy">Manage weekly working hours and availability. Events and recurring classes are managed separately.</p>
        </div>
    </header>

    @if (TempData["StatusMessage"] is string statusMessage)
    {
        <div class="schedule-notice is-success" role="status">@statusMessage</div>
    }
    @if (TempData["WarningMessage"] is string warningMessage)
    {
        <div class="mb-5 rounded-xl border border-amber-200 bg-amber-50 p-4 text-sm text-amber-950" role="status" data-roster-warning>@warningMessage</div>
    }
    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="schedule-notice is-error" role="alert">@errorMessage</div>
    }
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="schedule-notice is-error" asp-validation-summary="All"></div>
    }

    <section class="roster-availability-panel" data-availability-form-root>
        <div class="roster-section-heading">
            <div>
                <p class="portal-eyebrow">Teacher availability</p>
                <h2>Weekly teaching hours</h2>
                <p class="roster-section-copy">These hours determine when sessions can be booked with the selected teacher.</p>
            </div>
        </div>
        <form method="post" asp-page-handler="SaveAvailability" class="availability-form" data-submit-feedback>
            <div class="availability-controls">
                @if (Model.IsAdmin)
                {
                    <label class="roster-field">
                        <span>Teacher</span>
                        <select asp-for="AvailabilityInput.TeacherUserId" data-availability-teacher required>
                            @foreach (var teacher in Model.Data.Teachers)
                            {
                                <option value="@teacher.Id">@teacher.Name</option>
                            }
                        </select>
                    </label>
                }
                else
                {
                    <input type="hidden" asp-for="AvailabilityInput.TeacherUserId" value="@Model.Data.Teachers.FirstOrDefault()?.Id" data-availability-teacher />
                }
                <label class="roster-field">
                    <span>Time zone</span>
                    <input asp-for="AvailabilityInput.TimeZoneId" type="hidden" value="@SchedulingService.AmsterdamTimeZoneId" data-availability-time-zone />
                    <span class="roster-fixed-value">Amsterdam (Europe/Amsterdam)</span>
                </label>
            </div>
            <div class="availability-week">
                @for (var index = 0; index < Model.AvailabilityInput.Days.Count; index++)
                {
                    <div class="availability-day" data-availability-day="@Model.AvailabilityInput.Days[index].DayOfWeek">
                        <input asp-for="AvailabilityInput.Days[index].DayOfWeek" type="hidden" />
                        <label class="availability-day-toggle">
                            <input asp-for="AvailabilityInput.Days[index].IsAvailable" data-availability-enabled />
                            <span>@Model.AvailabilityInput.Days[index].DayOfWeek</span>
                        </label>
                        <label>
                            <span class="sr-only">Start time</span>
                            <input asp-for="AvailabilityInput.Days[index].LocalStartTime" type="time" data-availability-start />
                        </label>
                        <span class="availability-separator">to</span>
                        <label>
                            <span class="sr-only">End time</span>
                            <input asp-for="AvailabilityInput.Days[index].LocalEndTime" type="time" data-availability-end />
                        </label>
                    </div>
                }
            </div>
            <button class="portal-btn portal-btn-primary portal-btn-sm" type="submit">
                <span data-submit-idle><i class="fa-solid fa-floppy-disk" aria-hidden="true"></i> Save availability</span>
                <span data-submit-pending hidden class="inline-flex items-center gap-2">
                    <span aria-hidden="true" class="size-4 rounded-full border-2 border-current border-r-transparent motion-safe:animate-spin"></span>
                    Saving availability...
                </span>
            </button>
        </form>
    </section>

    <script type="application/json" data-availability-json>
        @Html.Raw(JsonSerializer.Serialize(Model.Data.Availability.Select(item => new
        {
            item.TeacherUserId,
            DayOfWeek = item.DayOfWeek.ToString(),
            Start = item.LocalStartTime.ToString("HH:mm"),
            End = item.LocalEndTime.ToString("HH:mm"),
            item.TimeZoneId
        })))
    </script>

</section>
@section Scripts { <script src="~/js/schedule-roster.js" asp-append-version="true"></script> }
