@using System.Text.Json
@using iD_Develops.Enums
@model iD_Develops.Pages.Portal.Schedule.EventsModel
    <div class="grid min-w-0 items-start gap-6 xl:grid-cols-[minmax(0,1fr)_minmax(0,1.2fr)]">
        <div class="min-w-0 rounded-xl border border-[var(--id-border)] bg-white p-5 sm:p-6">
            <div class="mb-5 flex flex-wrap items-center justify-between gap-3">
                <div>
                    <p class="portal-eyebrow">Automatic</p>
                    <h2 class="m-0 text-lg font-semibold text-[var(--id-ink)]">Recurring classes</h2>
                </div>
                <button class="portal-btn portal-btn-primary" type="button" data-roster-new>
                    <i class="fa-solid fa-plus" aria-hidden="true"></i>
                    Add recurring class
                </button>
            </div>

            <div class="grid min-w-0 gap-3">
                @if (Model.ScheduleData.Rules.Count == 0)
                {
                    <div class="grid min-h-40 place-content-center gap-3 rounded-lg border border-dashed border-slate-300 p-6 text-center text-sm text-slate-500">
                        <i class="fa-regular fa-calendar" aria-hidden="true"></i>
                        <strong>No recurring classes</strong>
                    </div>
                }
                @foreach (var rule in Model.ScheduleData.Rules)
                {
                    var ruleJson = JsonSerializer.Serialize(new
                    {
                        rule.Id,
                        rule.TeacherUserId,
                        rule.CourseClassId,
                        DayOfWeek = rule.DayOfWeek.ToString(),
                        LocalStartTime = rule.LocalStartTime.ToString("HH:mm"),
                        rule.TimeZoneId,
                        ActiveFromDate = rule.ActiveFromDate.ToString("yyyy-MM-dd"),
                        ActiveUntilDate = rule.ActiveUntilDate?.ToString("yyyy-MM-dd"),
                        rule.DurationMinutes,
                        rule.Capacity,
                        DeliveryType = rule.DeliveryType.ToString(),
                        rule.Location,
                        rule.BookingOpenDaysBefore,
                        rule.BookingCloseHoursBefore,
                        rule.GenerateWeeksAhead,
                        rule.IsVisibleForStudentBooking,
                        rule.IsActive
                    });
                    <article class="grid min-w-0 grid-cols-[4rem_minmax(0,1fr)] gap-3 rounded-lg border border-slate-200 p-4 @(rule.IsActive ? null : "opacity-60")" data-roster-rule-id="@rule.Id">
                        <span class="grid content-start gap-1 rounded-lg bg-[var(--id-blue-soft)] px-3 py-2 text-center text-sm text-[var(--id-blue)]">
                            <strong>@rule.DayOfWeek.ToString()[..3]</strong>
                            <span class="tabular-nums">@rule.LocalStartTime.ToString("HH:mm")</span>
                        </span>
                        <span class="grid min-w-0 grid-cols-1 gap-1 break-words text-sm text-slate-600">
                            <strong class="text-base font-semibold text-[var(--id-ink)]">@rule.ClassTitle</strong>
                            <span class="text-sm">@rule.CourseName &middot; @rule.TeacherName</span>
                            @if (rule.IsActive && rule.ProvisioningStatus != ScheduleRosterProvisioningStatus.Ready)
                            {
                                <span class="mt-2 inline-flex w-fit rounded-md bg-amber-100 px-2 py-1 text-xs font-semibold text-amber-950" data-roster-provisioning-status="@rule.ProvisioningStatus">
                                    @(rule.ProvisioningStatus == ScheduleRosterProvisioningStatus.PendingZoomSetup ? "Pending Zoom setup" : rule.ProvisioningStatus == ScheduleRosterProvisioningStatus.ProvisioningFailed ? "Meeting setup failed" : "Meeting setup pending")
                                </span>
                                @if (!string.IsNullOrWhiteSpace(rule.ProvisioningError))
                                {
                                    <small class="break-words text-sm text-amber-950">@rule.ProvisioningError</small>
                                }
                            }
                            <span class="text-xs text-slate-500">Amsterdam (<span data-portal-schedule-time="zone-range" data-start="@(rule.ActiveFromDate.ToString("yyyy-MM-dd") + "T12:00:00Z")" data-end="@(rule.ActiveUntilDate.HasValue ? rule.ActiveUntilDate.Value.ToString("yyyy-MM-dd") + "T12:00:00Z" : "")">CET/CEST</span>)</span><span>@rule.DurationMinutes min &middot; @rule.Capacity seat@(rule.Capacity == 1 ? string.Empty : "s") &middot; @rule.UpcomingEventCount upcoming</span>
                        </span>
                        <span class="col-span-2 flex flex-wrap items-center gap-2 sm:col-span-1 sm:col-start-2">
                            @if (rule.IsActive && rule.ProvisioningStatus != ScheduleRosterProvisioningStatus.Ready)
                            {
                                <form method="post" asp-route-mode="recurring" asp-page-handler="RetryRule" data-submit-feedback>
                                    <input type="hidden" name="ruleId" value="@rule.Id" />
                                    <button type="submit" class="portal-btn portal-btn-outline size-11 p-0" aria-label="Retry meeting setup for @rule.ClassTitle" title="Retry meeting setup">
                                        <span data-submit-idle><i class="fa-solid fa-rotate-right" aria-hidden="true"></i></span>
                                        <span data-submit-pending hidden class="inline-flex"><span aria-hidden="true" class="size-4 rounded-full border-2 border-current border-r-transparent motion-safe:animate-spin"></span></span>
                                    </button>
                                </form>
                            }
                            <button type="button"
                                    class="portal-btn portal-btn-outline size-11 p-0"
                                    data-roster-edit
                                    data-roster-rule="@ruleJson"
                                    aria-label="Edit @rule.ClassTitle"
                                    title="Edit recurring class">
                                <i class="fa-solid fa-pencil" aria-hidden="true"></i>
                            </button>
                            <form method="post" asp-route-mode="recurring"
                                  asp-page-handler="DeleteRule"
                                  data-confirm-title="Remove recurring class"
                                  data-confirm-message="Remove this recurring class and its unbooked future meetings?"
                                  data-confirm-action="Remove class"
                                  data-confirm-tone="danger">
                                <input type="hidden" name="ruleId" value="@rule.Id" />
                                <button type="submit" class="portal-btn portal-btn-outline size-11 p-0 text-red-700" aria-label="Remove @rule.ClassTitle" title="Remove recurring class">
                                    <i class="fa-regular fa-trash-can" aria-hidden="true"></i>
                                </button>
                            </form>
                        </span>
                    </article>
                }
            </div>
        </div>

        <aside class="min-w-0 scroll-mt-6 rounded-xl border border-[var(--id-border)] bg-white p-5 sm:p-6" data-roster-editor>
            <div class="mb-6 flex items-start justify-between gap-3">
                <div>
                    <p class="portal-eyebrow">Automatic</p>
                    <h2 class="m-0 text-lg font-semibold text-[var(--id-ink)]" data-roster-editor-title>New recurring class</h2>
                </div>
                <button type="button" class="portal-btn portal-btn-outline shrink-0" data-roster-reset aria-label="Clear form" title="Clear form">
                    <i class="fa-solid fa-rotate-left" aria-hidden="true"></i> Reset
                </button>
            </div>
            <form id="recurring-class" method="post" asp-route-mode="recurring" asp-page-handler="SaveRule" class="grid min-w-0 gap-6" autocomplete="off" data-roster-form data-submit-feedback data-preserve-values="@(!ViewData.ModelState.IsValid ? "true" : "false")">
                <input asp-for="RuleInput.Id" type="hidden" data-roster-field="Id" />

<fieldset class="m-0 min-w-0 border-0 p-0"><legend class="mb-4 text-base font-semibold text-[var(--id-ink)]">Class and teacher</legend><div class="grid min-w-0 gap-4 sm:grid-cols-2">                @if (Model.IsAdmin)
                {
                    <label class="grid min-w-0 gap-2 text-sm font-medium text-slate-700 sm:col-span-2">
                        <span>Teacher</span>
                        <select class="min-h-11 w-full min-w-0 rounded-lg border border-slate-300 bg-white px-3 py-2 text-base text-[var(--id-ink)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--id-blue)] disabled:cursor-not-allowed disabled:bg-slate-100 disabled:text-slate-500 sm:text-sm" asp-for="RuleInput.TeacherUserId" data-roster-field="TeacherUserId" data-roster-teacher required>
                            <option value="">Select an available teacher</option>
                            @foreach (var teacher in Model.ScheduleData.Teachers)
                            {
                                <option value="@teacher.Id">@teacher.Name</option>
                            }
                        </select>
                    <span asp-validation-for="RuleInput.TeacherUserId" class="text-sm text-red-700"></span></label>
                }
                else
                {
                    <input type="hidden" asp-for="RuleInput.TeacherUserId" value="@Model.ScheduleData.Teachers.FirstOrDefault()?.Id" data-roster-field="TeacherUserId" data-roster-teacher />
                }
                <label class="grid min-w-0 gap-2 text-sm font-medium text-slate-700 sm:col-span-2">
                    <span>Course class</span>
                    <select class="min-h-11 w-full min-w-0 rounded-lg border border-slate-300 bg-white px-3 py-2 text-base text-[var(--id-ink)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--id-blue)] disabled:cursor-not-allowed disabled:bg-slate-100 disabled:text-slate-500 sm:text-sm" asp-for="RuleInput.CourseClassId" data-roster-field="CourseClassId" data-roster-class required>
                        <option value="">Select class</option>
                        @foreach (var courseClass in Model.ScheduleData.Classes)
                        {
                            <option value="@courseClass.Id" data-duration="@courseClass.DurationMinutes" data-capacity="@courseClass.Capacity">@courseClass.CourseName &middot; @courseClass.SectionTitle &middot; @courseClass.ClassTitle</option>
                        }
                    </select>
                <span asp-validation-for="RuleInput.CourseClassId" class="text-sm text-red-700"></span></label>
<p class="m-0 rounded-lg bg-slate-50 p-3 text-sm text-slate-600 sm:col-span-2" data-class-summary>Duration and capacity follow the selected course class.</p></div></fieldset><fieldset class="m-0 min-w-0 border-0 p-0"><legend class="mb-4 text-base font-semibold text-[var(--id-ink)]">Weekly schedule</legend><div class="grid min-w-0 gap-4 sm:grid-cols-2">                <label class="grid min-w-0 gap-2 text-sm font-medium text-slate-700">
                    <span>Day</span>
                    <select class="min-h-11 w-full min-w-0 rounded-lg border border-slate-300 bg-white px-3 py-2 text-base text-[var(--id-ink)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--id-blue)] disabled:cursor-not-allowed disabled:bg-slate-100 disabled:text-slate-500 sm:text-sm" asp-for="RuleInput.DayOfWeek" data-roster-field="DayOfWeek" data-roster-day>
                        @foreach (var day in Enum.GetValues<DayOfWeek>().OrderBy(day => ((int)day + 6) % 7))
                        {
                            <option value="@day">@day</option>
                        }
                    </select>
                <span asp-validation-for="RuleInput.DayOfWeek" class="text-sm text-red-700"></span></label>
                <label class="grid min-w-0 gap-2 text-sm font-medium text-slate-700">
                    <span>Start time</span>
                    <input class="min-h-11 w-full min-w-0 rounded-lg border border-slate-300 bg-white px-3 py-2 text-base text-[var(--id-ink)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--id-blue)] disabled:cursor-not-allowed disabled:bg-slate-100 disabled:text-slate-500 sm:text-sm" asp-for="RuleInput.LocalStartTime" type="time" data-roster-field="LocalStartTime" data-roster-start required />
                <span asp-validation-for="RuleInput.LocalStartTime" class="text-sm text-red-700"></span></label>
                <input asp-for="RuleInput.TimeZoneId" type="hidden" data-roster-field="TimeZoneId" data-roster-time-zone />
                <p class="m-0 rounded-lg bg-[var(--id-blue-soft)] p-3 text-sm text-[var(--id-blue)] sm:col-span-2" data-roster-availability-hint></p>
                <label class="grid min-w-0 gap-2 text-sm font-medium text-slate-700">
                    <span>Active from</span>
                    <input class="min-h-11 w-full min-w-0 rounded-lg border border-slate-300 bg-white px-3 py-2 text-base text-[var(--id-ink)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--id-blue)] disabled:cursor-not-allowed disabled:bg-slate-100 disabled:text-slate-500 sm:text-sm" asp-for="RuleInput.ActiveFromDate" type="date" data-roster-field="ActiveFromDate" required />
                <span asp-validation-for="RuleInput.ActiveFromDate" class="text-sm text-red-700"></span></label>
                <label class="grid min-w-0 gap-2 text-sm font-medium text-slate-700">
                    <span>Active until</span>
                    <input class="min-h-11 w-full min-w-0 rounded-lg border border-slate-300 bg-white px-3 py-2 text-base text-[var(--id-ink)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--id-blue)] disabled:cursor-not-allowed disabled:bg-slate-100 disabled:text-slate-500 sm:text-sm" asp-for="RuleInput.ActiveUntilDate" type="date" data-roster-field="ActiveUntilDate" required />
                <span asp-validation-for="RuleInput.ActiveUntilDate" class="text-sm text-red-700"></span></label>
                <input asp-for="RuleInput.DurationMinutes" type="hidden" data-roster-field="DurationMinutes" />
                <input asp-for="RuleInput.Capacity" type="hidden" data-roster-field="Capacity" />
<p class="m-0 text-sm text-slate-600 sm:col-span-2">Amsterdam (CET/CEST). Weekly times follow local clock changes.</p></div></fieldset><fieldset class="m-0 min-w-0 border-0 p-0"><legend class="mb-4 text-base font-semibold text-[var(--id-ink)]">Delivery</legend><div class="grid min-w-0 gap-4 sm:grid-cols-2">                <label class="grid min-w-0 gap-2 text-sm font-medium text-slate-700">
                    <span>Delivery</span>
                    <select class="min-h-11 w-full min-w-0 rounded-lg border border-slate-300 bg-white px-3 py-2 text-base text-[var(--id-ink)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--id-blue)] disabled:cursor-not-allowed disabled:bg-slate-100 disabled:text-slate-500 sm:text-sm" asp-for="RuleInput.DeliveryType" data-roster-field="DeliveryType" data-delivery>
                        <option value="@ScheduleDeliveryType.Zoom">Zoom</option>
                        <option value="@ScheduleDeliveryType.InPerson">In person</option>
                        <option value="@ScheduleDeliveryType.OtherOnline">Other online</option>
                    </select>
                <span asp-validation-for="RuleInput.DeliveryType" class="text-sm text-red-700"></span></label>
                <label class="grid min-w-0 gap-2 text-sm font-medium text-slate-700 sm:col-span-2" data-location-field>
                    <span>Location</span>
                    <input class="min-h-11 w-full min-w-0 rounded-lg border border-slate-300 bg-white px-3 py-2 text-base text-[var(--id-ink)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--id-blue)] disabled:cursor-not-allowed disabled:bg-slate-100 disabled:text-slate-500 sm:text-sm" asp-for="RuleInput.Location" maxlength="300" placeholder="Room or address" data-roster-field="Location" data-location />
                <span asp-validation-for="RuleInput.Location" class="text-sm text-red-700"></span></label>
                <div class="sm:col-span-2 rounded-xl border border-slate-200 bg-slate-50 p-4 text-sm text-slate-700" data-zoom-readiness data-readiness-url="@Url.Page(null, "ZoomReadiness")" role="status" aria-live="polite">
                    <strong class="inline-flex items-center gap-2">Zoom setup <span hidden data-zoom-readiness-spinner class="size-4 rounded-full border-2 border-current border-r-transparent motion-safe:animate-spin" aria-hidden="true"></span></strong>
                    <p class="mt-1" data-zoom-readiness-message>Select a teacher to check their Zoom connection.</p>
                    <details><summary class="mt-2 cursor-pointer font-medium">Scheduling before Zoom is connected</summary><p class="mt-2">You can save the schedule before Zoom is connected. New occurrences become bookable only after their meetings are created. Pending setup retries automatically, normally within a minute.</p></details>
                </div></div></fieldset>                <details class="rounded-lg border border-slate-200 p-4" data-schedule-advanced open="@(!ViewData.ModelState.IsValid)">
                    <summary class="cursor-pointer text-sm font-semibold text-[var(--id-ink)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--id-blue)]">Advanced booking options</summary>
                    <div class="mt-4 grid gap-4 sm:grid-cols-2"><label class="grid min-w-0 gap-2 text-sm font-medium text-slate-700 sm:col-span-2"><span>Meeting link (optional)</span><input class="min-h-11 w-full min-w-0 rounded-lg border border-slate-300 bg-white px-3 py-2 text-base text-[var(--id-ink)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--id-blue)] disabled:cursor-not-allowed disabled:bg-slate-100 disabled:text-slate-500 sm:text-sm" asp-for="RuleInput.MeetingUrl" type="url" maxlength="1024" placeholder="https://…" data-roster-field="MeetingUrl" /><span asp-validation-for="RuleInput.MeetingUrl" class="text-sm text-red-700"></span></label>
                        <label class="grid min-w-0 gap-2 text-sm font-medium text-slate-700">
                            <span>Generate ahead</span>
                            <select class="min-h-11 w-full min-w-0 rounded-lg border border-slate-300 bg-white px-3 py-2 text-base text-[var(--id-ink)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--id-blue)] disabled:cursor-not-allowed disabled:bg-slate-100 disabled:text-slate-500 sm:text-sm" asp-for="RuleInput.GenerateWeeksAhead" data-roster-field="GenerateWeeksAhead">
                                <option value="4">4 weeks</option>
                                <option value="8">8 weeks</option>
                                <option value="12">12 weeks</option>
                                <option value="24">24 weeks</option>
                                <option value="52">52 weeks</option>
                            </select>
                        <span asp-validation-for="RuleInput.GenerateWeeksAhead" class="text-sm text-red-700"></span></label>
                        <label class="grid min-w-0 gap-2 text-sm font-medium text-slate-700">
                            <span>Booking opens</span>
                            <span class="grid gap-2"><input class="min-h-11 w-full min-w-0 rounded-lg border border-slate-300 bg-white px-3 py-2 text-base text-[var(--id-ink)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--id-blue)] disabled:cursor-not-allowed disabled:bg-slate-100 disabled:text-slate-500 sm:text-sm" asp-for="RuleInput.BookingOpenDaysBefore" type="number" min="0" max="365" data-roster-field="BookingOpenDaysBefore" /><small>days before</small></span>
                        <span asp-validation-for="RuleInput.BookingOpenDaysBefore" class="text-sm text-red-700"></span></label>
                        <label class="grid min-w-0 gap-2 text-sm font-medium text-slate-700">
                            <span>Booking closes</span>
                            <span class="grid gap-2"><input class="min-h-11 w-full min-w-0 rounded-lg border border-slate-300 bg-white px-3 py-2 text-base text-[var(--id-ink)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--id-blue)] disabled:cursor-not-allowed disabled:bg-slate-100 disabled:text-slate-500 sm:text-sm" asp-for="RuleInput.BookingCloseHoursBefore" type="number" min="0" max="8760" data-roster-field="BookingCloseHoursBefore" /><small>hours before</small></span>
                        <span asp-validation-for="RuleInput.BookingCloseHoursBefore" class="text-sm text-red-700"></span></label>
                        <label class="flex min-h-11 items-center gap-3 text-sm text-slate-700 sm:col-span-2">
                            <input class="size-4 accent-[var(--id-blue)]" asp-for="RuleInput.IsVisibleForStudentBooking" data-roster-field="IsVisibleForStudentBooking" />

                            Visible for student self-booking
                        </label>
                        <label class="flex min-h-11 items-center gap-3 text-sm text-slate-700 sm:col-span-2">
                            <input class="size-4 accent-[var(--id-blue)]" asp-for="RuleInput.IsActive" data-roster-field="IsActive" />
                            <span aria-hidden="true"></span>
                            Active recurring class
                        </label>
                    </div>
                </details>
                <button class="portal-btn portal-btn-primary justify-self-start" type="submit">
                    <span data-submit-idle><i class="fa-solid fa-floppy-disk" aria-hidden="true"></i> <span data-roster-submit-label>Save recurring class</span></span>
                    <span data-submit-pending hidden class="inline-flex items-center gap-2">
                        <span aria-hidden="true" class="size-4 rounded-full border-2 border-current border-r-transparent motion-safe:animate-spin"></span>
                        Saving recurring class&hellip;
                    </span>
                </button>
            </form>
        </aside>
    </div>
