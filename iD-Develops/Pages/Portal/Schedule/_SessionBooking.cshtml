@using System.Text.Json
@model iD_Develops.Pages.Portal.Schedule.BookModel
<section class="grid gap-6" data-appointment-booking
         data-attendee-id="@Model.Data.AttendeeUserId" data-attendee-name="@Model.Data.AttendeeName"
         data-selected-type="@Model.SelectedTypeId" data-selected-teacher="@Model.SelectedTeacherId">
    @if (TempData["StatusMessage"] is string status)
    {
        <div role="status" class="rounded-lg border border-emerald-200 bg-emerald-50 p-4 text-sm text-emerald-900">@status</div>
    }
    @if (TempData["ErrorMessage"] is string error)
    {
        <div role="alert" class="rounded-lg border border-red-200 bg-red-50 p-4 text-sm text-red-900">@error</div>
    }
    @if (!ViewData.ModelState.IsValid)
    {
        <div role="alert" class="rounded-lg border border-red-200 bg-red-50 p-4 text-sm text-red-900" asp-validation-summary="All"></div>
    }
    @if (Model.IsStaff)
    {
        <form method="get" class="flex flex-wrap items-end gap-3 rounded-xl border border-slate-200 bg-white p-5">
            <div class="grid min-w-0 flex-1 gap-2">
                <label for="booking-attendee" class="text-sm font-semibold text-slate-800">Who is attending?</label>
                <select id="booking-attendee" name="attendeeUserId" class="w-full min-w-0 rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm">
                    <option value="@Model.CurrentUserId" selected="@(Model.Data.AttendeeUserId == Model.CurrentUserId)">Myself</option>
                    @foreach (var attendee in Model.Data.Attendees)
                    {
                        <option value="@attendee.Id" selected="@(Model.Data.AttendeeUserId == attendee.Id)">@attendee.Name (@attendee.Email)</option>
                    }
                </select>
            </div>
            <button type="submit" class="portal-btn portal-btn-outline">Use attendee</button>
        </form>
    }
    <p class="m-0 text-sm text-slate-600" data-attendee-summary>Booking for <strong>@Model.Data.AttendeeName</strong>. Any required credits come from this attendee's balance.</p>
    <script type="application/json" data-appointment-options>@Html.Raw(JsonSerializer.Serialize(Model.Options, new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase }))</script>
    @if (Model.Options.Count == 0)
    {
        <div class="rounded-xl border border-dashed border-slate-300 bg-white p-6 text-sm text-slate-600">
            No sessions are available for this attendee.
            @if (Model.IsStaff)
            {
                <a asp-page="/Portal/Schedule/Appointments" class="font-semibold text-[var(--id-blue)] underline">Manage event types</a>
            }
        </div>
    }
    <div class="grid min-w-0 items-start gap-6 lg:grid-cols-[minmax(16rem,20rem)_minmax(0,1fr)]">
        <aside class="grid min-w-0 gap-5 rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
            <label class="grid gap-2 text-sm font-medium text-slate-700"><span>1. Event type</span><select data-appointment-type disabled class="w-full min-w-0 rounded-lg border border-slate-300 bg-white px-3 py-2.5"><option value="">Select an event type</option>@foreach (var option in Model.Options) { <option value="@option.Id">@option.Name</option> }</select></label>
            <div class="grid gap-2 rounded-lg bg-slate-50 p-4 text-sm text-slate-700" data-appointment-detail hidden>
                <strong data-detail-name></strong>
                <span data-detail-duration></span>
                <span data-detail-credit></span>
                <span data-detail-delivery></span>
                <span data-detail-location></span>
                <small data-detail-balance></small>
            </div>
            <label class="grid gap-2 text-sm font-medium text-slate-700"><span>2. Teacher</span><select data-appointment-teacher disabled class="w-full min-w-0 rounded-lg border border-slate-300 bg-white px-3 py-2.5"><option value="">Select an event type first</option></select></label>
            <label class="grid gap-2 text-sm font-medium text-slate-700"><span>3. Starting date</span><input type="date" data-appointment-start-date value="@Model.StartingDate" class="w-full min-w-0 rounded-lg border border-slate-300 bg-white px-3 py-2.5" /></label>
        </aside>
        <section class="min-w-0 rounded-xl border border-slate-200 bg-white p-5 shadow-sm" aria-labelledby="booking-times-heading">
            <div class="mb-5 flex flex-wrap items-end justify-between gap-3 border-b border-slate-100 pb-4">
                <h2 id="booking-times-heading" class="m-0 text-lg font-semibold text-slate-950">Choose a time</h2>
                <span class="text-xs text-slate-500">Amsterdam time (CET/CEST)</span>
            </div>
            <div class="grid gap-5" data-appointment-slots aria-live="polite"><p class="m-0 text-sm text-slate-600">Select an event type and teacher to see available times.</p></div>
        </section>
    </div>
    <form method="post" asp-page-handler="Book" data-appointment-book-form data-submit-feedback hidden>
        <input type="hidden" name="bookingRequestId" value="@Model.BookingRequestId" />
        <input type="hidden" name="attendeeUserId" value="@Model.Data.AttendeeUserId" />
        <input type="hidden" name="appointmentTypeId" data-book-type />
        <input type="hidden" name="teacherUserId" data-book-teacher />
        <input type="hidden" name="startUtc" data-book-start />
    </form>
    @if (Model.IsStaff && Model.Data.SetupIssues?.Count > 0)
    {
        <section class="grid gap-4 rounded-xl border border-amber-200 bg-amber-50 p-5" aria-labelledby="setup-review-heading">
            <h2 id="setup-review-heading" class="m-0 text-lg font-semibold text-amber-950">Meeting setup needing attention</h2>
            <p class="m-0 text-sm text-amber-900">A missing provider response does not prove that meeting creation failed. Verify Zoom and Google Calendar before creating a replacement or releasing a held booking.</p>
            @foreach (var issue in Model.Data.SetupIssues)
            {
                <article class="grid gap-3 rounded-lg bg-white p-4" data-setup-request-id="@issue.RequestId">
                    <strong class="break-words text-sm text-slate-900">@issue.Name &middot; @issue.AttendeeName</strong>
                    <p class="m-0 text-sm text-slate-600">Teacher: @issue.TeacherName</p>
                    <p class="m-0 text-sm text-slate-600">@TimeZoneInfo.ConvertTimeFromUtc(issue.StartUtc, iD_Develops.Pages.Portal.Schedule.BookModel.AmsterdamZone()).ToString("dd MMM yyyy HH:mm") Amsterdam</p>
                    <p class="m-0 break-all text-xs text-slate-500">Reference: @issue.RequestId</p>
                    @if (Model.IsAdmin)
                    {
                        <details>
                            <summary class="cursor-pointer text-sm font-semibold text-[var(--id-blue)]">Resolve unconfirmed setup</summary>
                            <form method="post" asp-page-handler="ResolveSetup" class="mt-4 grid gap-4" data-cancel-session data-cancel-message="Only proceed after verifying that no meeting remains in Zoom or Google Calendar. This cancels the unconfirmed booking and returns its reserved credits." data-submit-feedback>
                                <input type="hidden" name="requestId" value="@issue.RequestId" />
                                <label class="flex items-start gap-3 text-sm text-slate-700"><input type="checkbox" name="providerCleanupConfirmed" value="true" required class="mt-1 h-4 w-4 shrink-0" /> I verified that no external meeting remains for this request.</label>
                                <button type="submit" class="portal-btn portal-btn-outline" disabled>Cancel unconfirmed setup</button>
                            </form>
                        </details>
                    }
                    else { <p class="m-0 text-sm text-slate-600">Ask an administrator to review this setup.</p> }
                </article>
            }
        </section>
    }
    <section id="my-bookings" class="grid gap-4" aria-labelledby="my-bookings-heading">
        <h2 id="my-bookings-heading" class="m-0 text-lg font-semibold text-slate-950">Sessions for @Model.Data.AttendeeName</h2>
        @if (Model.Data.Bookings.Count == 0)
        {
            <p class="m-0 text-sm text-slate-600">No sessions booked yet.</p>
        }
        @foreach (var booking in Model.Data.Bookings)
        {
            var localStart = TimeZoneInfo.ConvertTimeFromUtc(booking.StartUtc, iD_Develops.Pages.Portal.Schedule.BookModel.AmsterdamZone());
            var zoneLabel = iD_Develops.Pages.Portal.Schedule.BookModel.AmsterdamZone().IsDaylightSavingTime(booking.StartUtc) ? "CEST" : "CET";
            <article data-booking-event-id="@booking.EventId" class="min-w-0 rounded-xl border border-slate-200 bg-white p-5">
                <div class="flex flex-wrap items-start justify-between gap-3">
                    <div class="min-w-0">
                        <h3 class="m-0 break-words text-base font-semibold text-slate-950">@booking.Name</h3>
                        <p class="mb-0 mt-2 text-sm text-slate-600">@localStart.ToString("ddd, dd MMM yyyy HH:mm") @zoneLabel &middot; @booking.TeacherName</p>
                    </div>
                    <span class="rounded-full bg-slate-100 px-3 py-1 text-xs text-slate-700">@(booking.SetupStatus is "Preparing" or "ReviewRequired" ? "Setup pending" : booking.Status)</span>
                </div>
                @if (booking.SetupStatus is "Preparing" or "ReviewRequired")
                {
                    <p role="status" class="mb-0 mt-3 rounded-lg bg-amber-50 p-3 text-sm text-amber-900">@(booking.SetupMessage ?? "Meeting setup is pending. Please contact the company if it does not finish.") Reference: @booking.RequestId</p>
                }
                @if (booking.CanCancel)
                {
                    <form method="post" asp-page-handler="Cancel" class="mt-4" data-cancel-session data-cancel-message="@booking.CancellationMessage" data-submit-feedback>
                        <input type="hidden" name="scheduledEventId" value="@booking.EventId" />
                        <input type="hidden" name="attendeeUserId" value="@Model.Data.AttendeeUserId" />
                        <button type="submit" class="portal-btn portal-btn-outline" disabled><span data-submit-idle>Cancel session</span><span data-submit-pending hidden>Cancelling&hellip;</span></button>
                    </form>
                }
            </article>
        }
    </section>
</section>