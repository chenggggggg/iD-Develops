@using iD_Develops.Services
@using iD_Develops.Enums
@model iD_Develops.Pages.Portal.Schedule.EventsModel
    <section class="roster-manual-panel" id="schedule-session">
        <div class="roster-section-heading">
            <div>
                <p class="portal-eyebrow">One-time session</p>
                <h2>Add a session</h2>
            </div>
        </div>
        <form method="post" asp-route-mode="single" asp-page-handler="CreateManual" class="roster-form roster-manual-form" data-submit-feedback>
            @if (Model.IsAdmin)
            {
                <label class="roster-field">
                    <span>Teacher</span>
                    <select asp-for="ManualInput.TeacherUserId" data-manual-teacher required>
                        <option value="">Select an available teacher</option>
                        @foreach (var teacher in Model.ScheduleData.Teachers)
                        {
                            <option value="@teacher.Id">@teacher.Name</option>
                        }
                    </select>
                    <small class="roster-field-help" data-manual-availability-hint></small>
                </label>
            }
            else
            {
                <input type="hidden" asp-for="ManualInput.TeacherUserId" value="@Model.ScheduleData.Teachers.FirstOrDefault()?.Id" />
            }
            <label class="roster-field">
                <span>Course class</span>
                <select asp-for="ManualInput.CourseClassId" data-manual-course>
                    <option value="">Select class</option>
                    @foreach (var courseClass in Model.ScheduleData.Classes)
                    {
                        <option value="@courseClass.Id">@courseClass.CourseName &middot; @courseClass.ClassTitle</option>
                    }
                </select>
            </label>
            <p class="roster-choice-hint is-wide">For an event-type booking with credits, <a asp-page="/Portal/Schedule/Events">book a session</a>.</p>
            <details class="is-wide rounded-lg border border-slate-200 p-4">
                <summary class="cursor-pointer text-sm font-semibold text-slate-700">Advanced: custom session</summary>
                <p class="mb-4 mt-3 text-sm text-slate-600">Keep this option for custom times or durations. Custom sessions use the manual scheduling rules and do not consume event-type credits. Choose either a student here or a course class above.</p>
                <div class="roster-field roster-student-picker" data-student-picker>
                    <span>Student</span>
                    <input type="search" placeholder="Search by email" autocomplete="off" data-student-search aria-label="Search students by email" />
                    <select asp-for="ManualInput.StudentUserId" data-manual-student>
                        <option value="">Select student</option>
                        @foreach (var student in Model.ScheduleData.Students)
                        {
                            <option value="@student.Id">@student.Email</option>
                        }
                    </select>
                </div>
            </details>
            <label class="roster-field">
                <span>Date and time</span>
                <input asp-for="ManualInput.StartLocal" type="datetime-local" data-manual-start required />
            </label>
            <label class="roster-field">
                <span>Time zone</span>
                <input asp-for="ManualInput.TimeZoneId" type="hidden" value="@SchedulingService.AmsterdamTimeZoneId" data-manual-time-zone />
                <span class="roster-fixed-value">Amsterdam (Europe/Amsterdam)</span>
            </label>
            <label class="roster-field">
                <span>Duration (min)</span>
                <input asp-for="ManualInput.DurationMinutes" type="number" min="5" max="1440" data-manual-duration />
            </label>
            <label class="roster-field">
                <span>Capacity</span>
                <input asp-for="ManualInput.Capacity" type="number" min="1" max="10000" />
            </label>
            <label class="roster-field">
                <span>Delivery</span>
                <select asp-for="ManualInput.DeliveryType">
                    <option value="@ScheduleDeliveryType.Zoom">Zoom</option>
                    <option value="@ScheduleDeliveryType.InPerson">In person</option>
                    <option value="@ScheduleDeliveryType.OtherOnline">Other online</option>
                </select>
            </label>
            <label class="roster-field is-wide">
                <span>Zoom URL <small>(optional)</small></span>
                <input asp-for="ManualInput.MeetingUrl" type="url" maxlength="1024" placeholder="https://zoom.us/j/..." />
                <small class="roster-field-help">Leave empty to create the Zoom meeting automatically from the teacher's connected account.</small>
            </label>
            <label class="roster-field">
                <span>Location</span>
                <input asp-for="ManualInput.Location" maxlength="300" />
            </label>
            <label class="roster-field">
                <span>Booking opens (days)</span>
                <input asp-for="ManualInput.BookingOpenDaysBefore" type="number" min="0" max="365" />
            </label>
            <label class="roster-field">
                <span>Booking closes (hours)</span>
                <input asp-for="ManualInput.BookingCloseHoursBefore" type="number" min="0" max="8760" />
            </label>
            <button class="portal-btn portal-btn-primary roster-submit" type="submit">
                <span data-submit-idle><i class="fa-solid fa-calendar-plus" aria-hidden="true"></i> Schedule meeting</span>
                <span data-submit-pending hidden class="inline-flex items-center gap-2">
                    <span aria-hidden="true" class="size-4 rounded-full border-2 border-current border-r-transparent motion-safe:animate-spin"></span>
                    Scheduling meeting...
                </span>
            </button>
        </form>
    </section>