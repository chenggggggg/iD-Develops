@page "/calendar/book-private-session"
@model iD_Develops.Pages.Portal.Schedule.BookModel
@{
    Layout = "_PortalLayout";
    ViewData["Title"] = "Book session";
}
<section class="portal-page-shell grid gap-6">
    <header class="portal-page-header">
        <div>
            <p class="portal-eyebrow">Appointments</p>
            <h1 class="portal-title-sm">Book session</h1>
            <p class="portal-copy">Choose an event type, teacher, and an available time.</p>
        </div>
        <a class="portal-btn portal-btn-outline" asp-page="/Portal/Schedule/Index"><i class="fa-solid fa-calendar" aria-hidden="true"></i> Calendar</a>
    </header>
    <partial name="_SessionBooking" model="Model" />
</section>
@section Scripts { <script src="~/js/appointment-booking.js" asp-append-version="true"></script> }
