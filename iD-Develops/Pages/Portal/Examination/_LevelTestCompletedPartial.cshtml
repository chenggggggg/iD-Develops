@model iD_Develops.Pages.Portal.Examination.CompletedModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<iD_Develops.Pages.Portal.Examination.CompletedModel> Localizer

<div class="flex min-h-screen w-full">
    <div class="content-panel flex flex-col items-center justify-center">
        <div class="content-panel-inner">
            @if (!string.IsNullOrWhiteSpace(Model.LevelTestSuccessMessage))
            {
                <div class="text-center">
                    <p class="completion-message m-0 text-center">
                        @Model.LevelTestSuccessMessage
                    </p>

                    @if (Model.IsSignedInPortalUser)
                    {
                        <p class="m-0">
                            <a asp-page="/Portal/Profile/Index" class="completion-link">@Localizer["ReturnProfileAction"]</a>
                        </p>
                    }
                    else
                    {
                        <div class="completion-help my-6 text-center">
                            <p class="m-0">
                                @Localizer["EmailMissingHelp"]
                            </p>

                            <form method="post" asp-page-handler="Resend" class="completion-resend-form">
                                <input type="hidden" name="RecordId" value="@Model.RecordId" />
                                <button type="submit" class="completion-inline-button">@Localizer["ResendAction"]</button>.
                            </form>

                            <p class="completion-divider my-1">@Localizer["OrLabel"]</p>

                            <p class="mb-4">
                                @Localizer["ContactAtText"] <a class="completion-link" href="mailto:@Model.SupportEmail">@Model.SupportEmail</a>
                            </p>
                        </div>

                        <p class="m-0">
                            <a asp-page="/Index" class="completion-link">@Localizer["ReturnHomeAction"]</a>
                        </p>
                    }
                </div>
            }
            else
            {
                <h2 class="text-center">@Localizer["FormHeading"]</h2>
                <p class="subtitle text-center">
                    @Localizer["FormCongratulations"]
                    <br />@Localizer["FormResultsSoon"]
                    @if (!Model.IsSignedInPortalUser)
                    {
                        <text>@Localizer["FormAnonymousExplanation"]</text>
                    }
                    else
                    {
                        <text>@Localizer["FormSignedInExplanation"]</text>
                    }
                    <br />@Localizer["FormClosing"]
                </p>

                @if (!string.IsNullOrWhiteSpace(Model.LevelTestErrorMessage))
                {
                    <div class="public-alert public-alert-danger" role="alert">
                        @Model.LevelTestErrorMessage
                    </div>
                }

                <div class="flex justify-center pt-2">
                    <form method="post" asp-page-handler="SubmitForm" class="completed-form">
                        <input type="hidden" name="RecordId" value="@Model.RecordId" />

                        @if (!Model.IsSignedInPortalUser)
                        {
                            <label asp-for="Name" class="sr-only">@Localizer["NameLabel"]</label>
                            <input asp-for="Name" placeholder="@Localizer["NamePlaceholder"]" />

                            <label asp-for="Email" class="sr-only">@Localizer["EmailLabel"]</label>
                            <input asp-for="Email" placeholder="@Localizer["EmailPlaceholder"]" />
                        }

                        @if (!Model.IsSignedInPortalUser)
                        {
                            <div class="mt-4 flex items-start gap-2">
                                <input class="mt-1" asp-for="SubscribeNewsletter" type="checkbox" />
                                <label class="consent-label font-light" asp-for="SubscribeNewsletter">
                                    @Localizer["NewsletterConsent"]
                                </label>
                            </div>

                        }

                        @if (!Model.IsSignedInPortalUser)
                        {
                            <partial name="_Turnstile" />
                        }

                        <input type="submit" value="@(Model.IsSignedInPortalUser ? Localizer["ViewResultsButton"] : Localizer["SendResultsButton"])" class="submit-button mt-4" />

                        <div asp-validation-summary="All" class="public-invalid-feedback mt-4"></div>
                    </form>
                </div>
            }
        </div>
    </div>
</div>
