@model iD_Develops.Pages.Portal.Examination.CompletedModel

<div class="flex min-h-screen w-full">
    <div class="content-panel flex flex-col items-center justify-center">
        <div class="content-panel-inner">
            @if (!string.IsNullOrWhiteSpace(Model.LevelTestSuccessMessage))
            {
                <div class="text-center">
                    <p class="completion-message m-0 text-center">
                        @Model.LevelTestSuccessMessage
                    </p>

                    @if (Model.IsSignedInPortalUser)
                    {
                        <p class="m-0">
                            <a asp-page="/Portal/Profile/Index" class="completion-link">Return to your profile</a>
                        </p>
                    }
                    else
                    {
                        <div class="completion-help my-6 text-center">
                            <p class="m-0">
                                Didn't receive an email? Check your spam folder or
                            </p>

                            <form method="post" asp-page-handler="Resend" class="completion-resend-form">
                                <input type="hidden" name="RecordId" value="@Model.RecordId" />
                                <button type="submit" class="completion-inline-button">click here to resend</button>.
                            </form>

                            <p class="completion-divider my-1">or</p>

                            <p class="mb-4">
                                Contact us at <a class="completion-link" href="mailto:@Model.SupportEmail">@Model.SupportEmail</a>
                            </p>
                        </div>

                        <p class="m-0">
                            <a asp-page="/Index" class="completion-link">Return to the home page</a>
                        </p>
                    }
                </div>
            }
            else
            {
                <h2 class="text-center">Dutch Language Awaits!</h2>
                <p class="subtitle text-center">
                    Well done on completing your level test!
                    <br />Your results are just around the corner.
                    @if (!Model.IsSignedInPortalUser)
                    {
                        <text>Simply leave your name and email to receive detailed results and feedback on your test.</text>
                    }
                    else
                    {
                        <text>You're already signed in, so we can send the next steps straight to your account email.</text>
                    }
                    <br />Ready to explore the Dutch language?
                </p>

                @if (!string.IsNullOrWhiteSpace(Model.LevelTestErrorMessage))
                {
                    <div class="public-alert public-alert-danger" role="alert">
                        @Model.LevelTestErrorMessage
                    </div>
                }

                <div class="flex justify-center pt-2">
                    <form method="post" asp-page-handler="SubmitForm" class="completed-form">
                        <input type="hidden" name="RecordId" value="@Model.RecordId" />

                        @if (!Model.IsSignedInPortalUser)
                        {
                            <label asp-for="Name" class="sr-only">Name:</label>
                            <input asp-for="Name" placeholder="Name" />

                            <label asp-for="Email" class="sr-only">Email:</label>
                            <input asp-for="Email" placeholder="Email" />
                        }

                        @if (!Model.IsSignedInPortalUser)
                        {
                            <div class="mt-4 flex items-start gap-2">
                                <input class="mt-1" asp-for="SubscribeNewsletter" type="checkbox" />
                                <label class="consent-label font-light" asp-for="SubscribeNewsletter">
                                    I would like to receive newsletters and updates.
                                </label>
                            </div>

                        }

                        @if (!Model.IsSignedInPortalUser)
                        {
                            <partial name="_Turnstile" />
                        }

                        <input type="submit" value="@(Model.IsSignedInPortalUser ? "View my results!" : "Send my results!")" class="submit-button mt-4" />

                        <div asp-validation-summary="All" class="public-invalid-feedback mt-4"></div>
                    </form>
                </div>
            }
        </div>
    </div>
</div>
