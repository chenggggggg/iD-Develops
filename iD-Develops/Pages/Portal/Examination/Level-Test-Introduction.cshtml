@page
@using System.Globalization
@model iD_Develops.Pages.Portal.Examination.LevelTestIntroductionModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<iD_Develops.Pages.Portal.Examination.LevelTestIntroductionModel> Localizer
@{
    Layout = "/Pages/Shared/_Layout.cshtml";
    var culture = CultureInfo.CurrentUICulture.Name.ToLowerInvariant();
    var test = Model.SelectedTest;
    var level = Model.SelectedLevel?.ToUpperInvariant();
    var overview = $"/{culture}/level-test";
    ViewData["Title"] = level == null ? Localizer["Title"].Value : Localizer["SelectedTitle", level].Value;
    ViewData["MetaDescription"] = Localizer["SelectionMetaDescription"];
    ViewData["BodyClass"] = "level-test-introduction-page";
    ViewData["UsePublicNavigation"] = true;
    var action = "public-btn public-btn-primary min-h-12 touch-manipulation select-none gap-3 px-6 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#B23A48]";
    var rich = "text-base leading-8 text-[#535353] [overflow-wrap:anywhere] [&_p]:m-0 [&_p+p]:mt-5 [&_a]:font-semibold [&_a]:underline [&_a]:underline-offset-4 [&_ul]:my-5 [&_ul]:list-disc [&_ul]:pl-6 [&_ol]:my-5 [&_ol]:list-decimal [&_ol]:pl-6 [&_li+li]:mt-2 [&_h2]:mt-8 [&_h2]:mb-3 [&_h2]:text-2xl [&_h2]:font-semibold [&_h2]:text-[#071F3D] [&_img]:h-auto [&_img]:max-w-full";
}
@if (level == null)
{
    <section class="border-b border-[#D8D3CC] bg-[#FAFAF8]" aria-labelledby="level-test-title">
        <div class="public-container grid gap-8 py-14 sm:py-20 lg:grid-cols-[1.1fr_0.9fr] lg:items-end lg:gap-20">
            <div>
                <p class="m-0 mb-5 text-xs font-semibold uppercase tracking-[0.18em] text-[#B23A48]">@Localizer["SelectionEyebrow"]</p>
                <h1 id="level-test-title" class="m-0 max-w-[14ch] text-[clamp(2.75rem,6vw,5rem)] font-medium leading-[1.04] tracking-[-0.035em] text-[#071F3D] [font-family:var(--serif-heading)]">@Localizer["SelectionHeading"]</h1>
            </div>
            <div class="max-w-xl text-lg leading-8 text-[#535353]">
                <p class="m-0">@Localizer["SelectionIntroduction"]</p>
                <p class="m-0 mt-4 text-base leading-7">@Localizer["SelectionReassurance"]</p>
            </div>
        </div>
    </section>
    <section class="bg-white py-12 sm:py-16" aria-labelledby="choose-test-title">
        <div class="public-container">
            <div class="mb-8 flex flex-wrap items-baseline justify-between gap-3">
                <h2 id="choose-test-title" class="m-0 text-2xl font-medium text-[#071F3D] [font-family:var(--serif-heading)] sm:text-3xl">@Localizer["ChooseTestHeading"]</h2>
                <p class="m-0 text-sm leading-6 text-[#6B6B6B]">@Localizer["FreeTestsNote"]</p>
            </div>
            <div class="grid border-y border-[#D8D3CC] md:grid-cols-2">
                @foreach (var option in Model.Tests)
                {
                    var upper = option.Level.ToUpperInvariant();
                    <article class="flex min-w-0 flex-col py-8 first:border-b first:border-[#D8D3CC] last:pb-4 sm:py-10 md:first:border-r md:first:border-b-0 md:first:pr-10 md:last:pb-10 md:last:pl-10 lg:first:pr-16 lg:last:pl-16" data-level-test-choice="@option.Level">
                        <div class="flex items-baseline justify-between gap-4">
                            <h3 class="m-0 text-6xl font-medium tracking-[-0.04em] text-[#071F3D] [font-family:var(--serif-heading)]">@upper</h3>
                            <span class="text-xs font-semibold uppercase tracking-[0.12em] text-[#B23A48]">@Localizer[option.Level == "a1" ? "A1Eyebrow" : "A2Eyebrow"]</span>
                        </div>
                        <p class="m-0 mt-5 max-w-lg text-lg leading-8 text-[#535353]">@Localizer[option.Level == "a1" ? "A1Description" : "A2Description"]</p>
                        @if (option.IsAvailable)
                        {
                            <dl class="mt-6 mb-8 flex flex-wrap gap-x-10 gap-y-4 text-sm">
                                <div><dt class="text-[#6B6B6B]">@Localizer["DurationLabel"]</dt><dd class="m-0 mt-1 font-semibold tabular-nums text-[#071F3D]">@Model.FormatDuration(option)</dd></div>
                                <div><dt class="text-[#6B6B6B]">@Localizer["QuestionCountLabel"]</dt><dd class="m-0 mt-1 font-semibold tabular-nums text-[#071F3D]">@option.QuestionCount</dd></div>
                            </dl>
                            <a class="@action mt-auto self-start" href="@($"{overview}/{option.Level}")">@Localizer["ChooseLevelButton", upper]<i class="fa-solid fa-arrow-right-long" aria-hidden="true"></i></a>
                        }
                        else
                        {
                            <p class="m-0 mt-6 mb-8 text-sm leading-6 text-[#6B6B6B]" role="status">@Localizer["TestUnavailable", upper]</p>
                            <button class="@action mt-auto self-start disabled:cursor-not-allowed disabled:opacity-50" type="button" disabled>@Localizer["ChooseLevelButton", upper]</button>
                        }
                    </article>
                }
            </div>
            <p class="m-0 mt-6 max-w-2xl text-sm leading-7 text-[#6B6B6B]">@Localizer["ChooseHelp"] <a class="font-semibold text-[#B23A48] underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-4" href="@($"/{culture}/contact")">@Localizer["ContactAction"]</a></p>
        </div>
    </section>
    <section class="bg-[#EEF4F7] py-12 sm:py-16" aria-labelledby="test-process-title">
        <div class="public-container">
            <h2 id="test-process-title" class="m-0 text-2xl font-medium text-[#071F3D] [font-family:var(--serif-heading)] sm:text-3xl">@Localizer["ProcessHeading"]</h2>
            <ol class="mt-8 mb-0 grid list-none gap-7 p-0 md:grid-cols-3 md:gap-10">
                <li class="border-t border-[#C9D6DF] pt-5"><h3 class="m-0 text-base font-semibold text-[#071F3D]">@Localizer["ProcessBeforeTitle"]</h3><p class="m-0 mt-3 text-base leading-7 text-[#535353]">@Localizer["ProcessBeforeText"]</p></li>
                <li class="border-t border-[#C9D6DF] pt-5"><h3 class="m-0 text-base font-semibold text-[#071F3D]">@Localizer["ProcessDuringTitle"]</h3><p class="m-0 mt-3 text-base leading-7 text-[#535353]">@Localizer["ProcessDuringText"]</p></li>
                <li class="border-t border-[#C9D6DF] pt-5"><h3 class="m-0 text-base font-semibold text-[#071F3D]">@Localizer["ProcessAfterTitle"]</h3><p class="m-0 mt-3 text-base leading-7 text-[#535353]">@Localizer["ProcessAfterText"]</p></li>
            </ol>
        </div>
    </section>
}
else
{
    <section class="bg-[#FAFAF8] py-12 sm:py-16" aria-labelledby="selected-test-title" data-selected-level="@Model.SelectedLevel">
        <div class="public-container">
            <a href="@overview" class="inline-flex min-h-11 items-center gap-3 text-sm font-semibold text-[#B23A48] underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-4"><i class="fa-solid fa-arrow-left-long" aria-hidden="true"></i>@Localizer["BackToTests"]</a>
            <div class="mt-8 grid gap-10 lg:grid-cols-[minmax(0,1fr)_21rem] lg:items-start lg:gap-20">
                <article class="min-w-0">
                    <p class="m-0 mb-4 text-xs font-semibold uppercase tracking-[0.18em] text-[#B23A48]">@Localizer["SelectionEyebrow"]</p>
                    <h1 id="selected-test-title" class="m-0 text-[clamp(2.75rem,6vw,4.5rem)] font-medium leading-[1.04] tracking-[-0.035em] text-[#071F3D] [font-family:var(--serif-heading)]">@Localizer["SelectedTitle", level]</h1>
                    @if (test?.IsAvailable == true)
                    {
                        <div class="@rich mt-8" data-test-introduction>@Html.Raw(Model.IntroductionHtml)</div>
                    }
                    else
                    {
                        <p class="m-0 mt-6 text-lg leading-8 text-[#535353]" role="status">@Localizer["TestUnavailable", level]</p>
                    }
                </article>
                @if (test?.IsAvailable == true)
                {
                    <aside class="min-w-0 border-t border-[#D8D3CC] pt-6 lg:border-t-0 lg:border-l lg:pt-1 lg:pl-8" aria-labelledby="start-test-title">
                        <h2 id="start-test-title" class="m-0 text-2xl font-medium text-[#071F3D] [font-family:var(--serif-heading)]">@Localizer["ReadyHeading"]</h2>
                        <dl class="my-6 grid grid-cols-2 gap-4 text-sm">
                            <div><dt class="text-[#6B6B6B]">@Localizer["DurationLabel"]</dt><dd class="m-0 mt-2 font-semibold tabular-nums text-[#071F3D]">@Model.DurationDisplay</dd></div>
                            <div><dt class="text-[#6B6B6B]">@Localizer["QuestionCountLabel"]</dt><dd class="m-0 mt-2 font-semibold tabular-nums text-[#071F3D]">@test.QuestionCount</dd></div>
                        </dl>
                        <p class="m-0 mb-6 text-sm leading-7 text-[#535353]">@Localizer[Model.HasTimeLimit ? "ExplicitTimerNote" : "UntimedStartNote"]</p>
                        <form method="post" asp-page-handler="CreateRecord" asp-route-level="@Model.SelectedLevel" data-submit-feedback>
                            <button type="submit" class="@action w-full justify-between">@Localizer["StartLevelButton", level]<i class="fa-solid fa-arrow-right-long" aria-hidden="true"></i></button>
                        </form>
                    </aside>
                }
            </div>
        </div>
    </section>
}