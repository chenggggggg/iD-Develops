@page
@model iD_Develops.Pages.Portal.Examination.LevelTestIntroductionModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<iD_Develops.Pages.Portal.Examination.LevelTestIntroductionModel> Localizer
@{
    Layout = "/Pages/Shared/_Layout.cshtml";
    var duration = Localizer["DurationFormat", Model.DurationMinutes];

    ViewData["Title"] = Localizer["Title"];
    ViewData["MetaDescription"] = Localizer["MetaDescription"];
    ViewData["BodyClass"] = "level-test-introduction-page";
    ViewData["UsePublicNavigation"] = true;
}

<section class="border-b border-[#D8D3CC] bg-[#FAFAF8]">
    <div class="public-container grid gap-12 py-16 md:py-24 lg:grid-cols-[minmax(0,1fr)_20rem] lg:items-end lg:gap-20">
        <div class="max-w-4xl">
            <p class="mb-6 text-xs font-medium uppercase tracking-[0.22em] text-[#B23A48] [font-family:var(--serif-label)]">@Localizer["Eyebrow"]</p>
            <h1 class="m-0 max-w-[14ch] text-[clamp(3rem,7vw,6rem)] font-medium leading-[0.98] tracking-[-0.04em] text-[#071F3D] [font-family:var(--serif-heading)]">@Localizer["Heading"]</h1>
            <p class="mt-8 mb-0 max-w-[43rem] text-lg leading-[1.75] text-[#535353] md:text-xl">
                @Localizer["Introduction"]
            </p>
        </div>
        <aside class="border-t border-[#071F3D] pt-6 lg:border-t-0 lg:border-l lg:pt-0 lg:pl-10" aria-label="@Localizer["PracticalInformationLabel"]">
            <p class="m-0 text-xs font-medium uppercase tracking-[0.18em] text-[#6B6B6B] [font-family:var(--serif-label)]">@Localizer["DurationLabel"]</p>
            <p class="mt-3 mb-0 text-4xl font-semibold leading-none text-[#071F3D] [font-family:var(--serif-heading)]">@duration</p>
            <p class="mt-5 mb-0 text-sm leading-6 text-[#6B6B6B]">@Localizer["TimerExplanation"]</p>
            <a href="#start-level-test" class="mt-7 inline-flex items-center gap-3 text-sm font-semibold text-[#B23A48] underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-[#B23A48] focus-visible:outline-offset-4">
                @Localizer["ReadOnButton"]
                <i class="fa-solid fa-arrow-down-long" aria-hidden="true"></i>
            </a>
        </aside>
    </div>
</section>

<section class="bg-white py-16 md:py-24">
    <div class="public-container grid gap-14 lg:grid-cols-[minmax(0,1fr)_minmax(20rem,0.72fr)] lg:gap-24">
        <article>
            <p class="mb-4 text-xs font-medium uppercase tracking-[0.2em] text-[#B23A48] [font-family:var(--serif-label)]">@Localizer["BenefitsEyebrow"]</p>
            <h2 class="m-0 max-w-[18ch] text-[clamp(2.2rem,4.5vw,3.8rem)] font-medium leading-[1.08] tracking-[-0.025em] text-[#071F3D] [font-family:var(--serif-heading)]">@Localizer["BenefitsHeading"]</h2>
            <div class="mt-8 max-w-[45rem] space-y-5 text-[1.05rem] leading-[1.8] text-[#535353]">
                <p class="m-0">@Localizer["BenefitsParagraph1"]</p>
                <p class="m-0">@Localizer["BenefitsParagraph2"]</p>
            </div>
        </article>
        <aside class="border-t border-[#D8D3CC] pt-8 lg:border-t-0 lg:border-l lg:pt-0 lg:pl-12">
            <h2 class="m-0 text-2xl font-semibold text-[#071F3D] [font-family:var(--serif-heading)]">@Localizer["BeforeHeading"]</h2>
            <ol class="mt-8 mb-0 grid list-none gap-7 p-0">
                <li class="grid grid-cols-[2rem_1fr] gap-4"><span class="text-sm font-semibold text-[#B23A48]">01</span><div><h3 class="m-0 text-base font-semibold text-[#071F3D]">@Localizer["BeforeStep1Heading"]</h3><p class="mt-2 mb-0 leading-7 text-[#6B6B6B]">@Localizer["BeforeStep1Text", duration]</p></div></li>
                <li class="grid grid-cols-[2rem_1fr] gap-4"><span class="text-sm font-semibold text-[#B23A48]">02</span><div><h3 class="m-0 text-base font-semibold text-[#071F3D]">@Localizer["BeforeStep2Heading"]</h3><p class="mt-2 mb-0 leading-7 text-[#6B6B6B]">@Localizer["BeforeStep2Text"]</p></div></li>
                <li class="grid grid-cols-[2rem_1fr] gap-4"><span class="text-sm font-semibold text-[#B23A48]">03</span><div><h3 class="m-0 text-base font-semibold text-[#071F3D]">@Localizer["BeforeStep3Heading"]</h3><p class="mt-2 mb-0 leading-7 text-[#6B6B6B]">@Localizer["BeforeStep3Text"]</p></div></li>
            </ol>
        </aside>
    </div>
</section>

<section id="score-guide" class="border-y border-[#C9D6DF] bg-[#EEF4F7] py-16 md:py-24">
    <div class="public-container">
        <div class="grid gap-6 md:grid-cols-[minmax(0,0.7fr)_minmax(0,1fr)] md:items-end md:gap-16">
            <div>
                <p class="mb-4 text-xs font-medium uppercase tracking-[0.2em] text-[#B23A48] [font-family:var(--serif-label)]">@Localizer["ScoreGuideEyebrow"]</p>
                <h2 class="m-0 text-[clamp(2.2rem,4.5vw,3.8rem)] font-medium leading-[1.08] text-[#071F3D] [font-family:var(--serif-heading)]">@Localizer["ScoreGuideHeading"]</h2>
            </div>
            <p class="m-0 max-w-[40rem] text-lg leading-8 text-[#535353]">@Localizer["ScoreGuideIntroduction"]</p>
        </div>

        <div class="mt-12 border-t border-[#9FB1BD]">
            <article class="grid gap-4 border-b border-[#9FB1BD] py-7 md:grid-cols-[13rem_1fr] md:gap-12">
                <div>
                    <p class="m-0 text-2xl font-semibold text-[#071F3D] [font-family:var(--serif-heading)]">@Localizer["HighScoreRange"]</p>
                    <p class="mt-2 mb-0 text-xs font-semibold uppercase tracking-[0.16em] text-[#39705F]">@Localizer["HighScoreLabel"]</p>
                </div>
                <p class="m-0 max-w-[48rem] text-[1.05rem] leading-8 text-[#3F505A]">@Localizer["HighScoreText"]</p>
            </article>
            <article class="grid gap-4 border-b border-[#9FB1BD] py-7 md:grid-cols-[13rem_1fr] md:gap-12">
                <div>
                    <p class="m-0 text-2xl font-semibold text-[#071F3D] [font-family:var(--serif-heading)]">@Localizer["MiddleScoreRange"]</p>
                    <p class="mt-2 mb-0 text-xs font-semibold uppercase tracking-[0.16em] text-[#A46722]">@Localizer["MiddleScoreLabel"]</p>
                </div>
                <p class="m-0 max-w-[48rem] text-[1.05rem] leading-8 text-[#3F505A]">@Localizer["MiddleScoreText"]</p>
            </article>
            <article class="grid gap-4 border-b border-[#9FB1BD] py-7 md:grid-cols-[13rem_1fr] md:gap-12">
                <div>
                    <p class="m-0 text-2xl font-semibold text-[#071F3D] [font-family:var(--serif-heading)]">@Localizer["LowScoreRange"]</p>
                    <p class="mt-2 mb-0 text-xs font-semibold uppercase tracking-[0.16em] text-[#B23A48]">@Localizer["LowScoreLabel"]</p>
                </div>
                <p class="m-0 max-w-[48rem] text-[1.05rem] leading-8 text-[#3F505A]">
                    @Localizer["LowScoreText"]
                    <a class="font-semibold text-[#8F2D3A] underline decoration-[#B23A48]/40 underline-offset-4 hover:decoration-[#B23A48]" href="mailto:info@id-develops.com">info@id-develops.com</a>.
                </p>
            </article>
        </div>
    </div>
</section>

<section id="start-level-test" class="bg-[#071F3D] py-16 text-white md:py-24">
    <div class="public-container grid gap-10 md:grid-cols-[minmax(0,1fr)_auto] md:items-end md:gap-16">
        <div>
            <p class="mb-4 text-xs font-medium uppercase tracking-[0.2em] text-[#F4C8CD] [font-family:var(--serif-label)]">@Localizer["StartEyebrow"]</p>
            <h2 class="m-0 max-w-[16ch] text-[clamp(2.5rem,5vw,4.5rem)] font-medium leading-[1.02] tracking-[-0.03em] text-white [font-family:var(--serif-heading)]">@Localizer["StartHeading"]</h2>
            <p class="mt-6 mb-0 max-w-[39rem] text-lg leading-8 text-white/70">@Localizer["StartText", duration]</p>
        </div>

        <div>
            @if (Model.IsLevelTestAvailable)
            {
                <form method="post" asp-page-handler="CreateRecord">
                    <button type="submit" class="public-btn public-btn-primary min-h-14 border-[#B23A48] bg-[#B23A48] px-7 text-white shadow-[0_12px_28px_rgba(0,0,0,0.22)] hover:border-[#C84E5F] hover:bg-[#C84E5F] focus:border-[#C84E5F] focus:bg-[#C84E5F]">
                        @Localizer["StartButton"]
                        <i class="fa-solid fa-arrow-right-long" aria-hidden="true"></i>
                    </button>
                </form>
            }
            else
            {
                <div class="max-w-md border border-white/20 bg-white/10 p-5 text-sm leading-6 text-white" role="alert">
                    @Localizer["UnavailableMessage"]
                </div>
            }
        </div>
    </div>
</section>
