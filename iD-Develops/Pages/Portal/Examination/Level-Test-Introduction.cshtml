@page
@using System.Globalization
@model iD_Develops.Pages.Portal.Examination.LevelTestIntroductionModel
@{
    Layout = "/Pages/Shared/_Layout.cshtml";
    var isDutch = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName.Equals("nl", StringComparison.OrdinalIgnoreCase);
    var duration = $"{Model.DurationMinutes} {(isDutch ? "minuten" : "minutes")}";

    ViewData["Title"] = isDutch ? "Gratis Nederlandse niveautest" : "Free Dutch level test";
    ViewData["MetaDescription"] = isDutch
        ? "Doe de gratis Nederlandse niveautest en ontdek of de online cursus Nederlands A1-A2 bij je past."
        : "Take the free Dutch level test and find out whether the online Dutch A1-A2 course is right for you.";
    ViewData["BodyClass"] = "level-test-introduction-page";
    ViewData["UsePublicNavigation"] = true;
}

<section class="border-b border-[#D8D3CC] bg-[#FAFAF8]">
    <div class="public-container grid gap-12 py-16 md:py-24 lg:grid-cols-[minmax(0,1fr)_20rem] lg:items-end lg:gap-20">
        <div class="max-w-4xl">
            <p class="mb-6 text-xs font-medium uppercase tracking-[0.22em] text-[#B23A48] [font-family:var(--serif-label)]">@(isDutch ? "Gratis Nederlandse niveautest" : "Free Dutch level test")</p>
            <h1 class="m-0 max-w-[14ch] text-[clamp(3rem,7vw,6rem)] font-medium leading-[0.98] tracking-[-0.04em] text-[#071F3D] [font-family:var(--serif-heading)]">@(isDutch ? "Hoe goed is jouw Nederlands?" : "How strong is your Dutch?")</h1>
            <p class="mt-8 mb-0 max-w-[43rem] text-lg leading-[1.75] text-[#535353] md:text-xl">
                @(isDutch
                    ? "Deze niveautest geeft je een eerste, praktische indruk van je basiskennis. Zo ontdek je of de online cursus Nederlands A1-A2 een logische volgende stap voor je is."
                    : "This level test gives you a practical first impression of your foundation. It helps you decide whether the online Dutch A1-A2 course is the right next step for you.")
            </p>
        </div>
        <aside class="border-t border-[#071F3D] pt-6 lg:border-t-0 lg:border-l lg:pt-0 lg:pl-10" aria-label="@(isDutch ? "Praktische informatie" : "Practical information")">
            <p class="m-0 text-xs font-medium uppercase tracking-[0.18em] text-[#6B6B6B] [font-family:var(--serif-label)]">@(isDutch ? "Reken op" : "Allow")</p>
            <p class="mt-3 mb-0 text-4xl font-semibold leading-none text-[#071F3D] [font-family:var(--serif-heading)]">@duration</p>
            <p class="mt-5 mb-0 text-sm leading-6 text-[#6B6B6B]">@(isDutch ? "De timer start zodra je de test opent. Je hebt geen account nodig." : "The timer starts when you open the test. You do not need an account.")</p>
            <a href="#start-level-test" class="mt-7 inline-flex items-center gap-3 text-sm font-semibold text-[#B23A48] underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-[#B23A48] focus-visible:outline-offset-4">
                @(isDutch ? "Lees verder en start" : "Read on and begin")
                <i class="fa-solid fa-arrow-down-long" aria-hidden="true"></i>
            </a>
        </aside>
    </div>
</section>

<section class="bg-white py-16 md:py-24">
    <div class="public-container grid gap-14 lg:grid-cols-[minmax(0,1fr)_minmax(20rem,0.72fr)] lg:gap-24">
        <article>
            <p class="mb-4 text-xs font-medium uppercase tracking-[0.2em] text-[#B23A48] [font-family:var(--serif-label)]">@(isDutch ? "Wat je eraan hebt" : "What you will learn")</p>
            <h2 class="m-0 max-w-[18ch] text-[clamp(2.2rem,4.5vw,3.8rem)] font-medium leading-[1.08] tracking-[-0.025em] text-[#071F3D] [font-family:var(--serif-heading)]">@(isDutch ? "Een helder vertrekpunt, geen definitief taalcertificaat" : "A clear starting point, not a formal language certificate")</h2>
            <div class="mt-8 max-w-[45rem] space-y-5 text-[1.05rem] leading-[1.8] text-[#535353]">
                <p class="m-0">@(isDutch ? "De test kijkt naar de basis die je nodig hebt om verder te werken richting niveau A2. Na afloop zie je je score en lees je wat die score betekent voor jouw volgende stap." : "The test looks at the foundation you need to continue working towards level A2. At the end, you will see your score and what it means for your next step.")</p>
                <p class="m-0">@(isDutch ? "Gebruik de uitslag als praktisch advies. De test is bedoeld om je op weg te helpen en is geen officieel examen of erkend bewijs van je taalniveau." : "Use the result as practical guidance. The test is designed to help you move forward; it is not an official exam or recognised proof of your language level.")</p>
            </div>
        </article>
        <aside class="border-t border-[#D8D3CC] pt-8 lg:border-t-0 lg:border-l lg:pt-0 lg:pl-12">
            <h2 class="m-0 text-2xl font-semibold text-[#071F3D] [font-family:var(--serif-heading)]">@(isDutch ? "Voor je begint" : "Before you begin")</h2>
            <ol class="mt-8 mb-0 grid list-none gap-7 p-0">
                <li class="grid grid-cols-[2rem_1fr] gap-4"><span class="text-sm font-semibold text-[#B23A48]">01</span><div><h3 class="m-0 text-base font-semibold text-[#071F3D]">@(isDutch ? "Plan voldoende tijd" : "Set aside enough time")</h3><p class="mt-2 mb-0 leading-7 text-[#6B6B6B]">@(isDutch ? $"Houd ongeveer {duration} vrij en kies een moment waarop je niet gestoord wordt." : $"Set aside around {duration} and choose a time when you will not be interrupted.")</p></div></li>
                <li class="grid grid-cols-[2rem_1fr] gap-4"><span class="text-sm font-semibold text-[#B23A48]">02</span><div><h3 class="m-0 text-base font-semibold text-[#071F3D]">@(isDutch ? "Werk zelfstandig" : "Work independently")</h3><p class="mt-2 mb-0 leading-7 text-[#6B6B6B]">@(isDutch ? "Gebruik geen woordenboek of vertaaltool. Dan geeft de uitslag het eerlijkste beeld." : "Do not use a dictionary or translation tool. That gives you the most useful result.")</p></div></li>
                <li class="grid grid-cols-[2rem_1fr] gap-4"><span class="text-sm font-semibold text-[#B23A48]">03</span><div><h3 class="m-0 text-base font-semibold text-[#071F3D]">@(isDutch ? "Bekijk direct je uitslag" : "See your result immediately")</h3><p class="mt-2 mb-0 leading-7 text-[#6B6B6B]">@(isDutch ? "Na de laatste vraag krijg je je score en een advies voor het vervolg." : "After the final question, you will receive your score and guidance on what to do next.")</p></div></li>
            </ol>
        </aside>
    </div>
</section>

<section id="score-guide" class="border-y border-[#C9D6DF] bg-[#EEF4F7] py-16 md:py-24">
    <div class="public-container">
        <div class="grid gap-6 md:grid-cols-[minmax(0,0.7fr)_minmax(0,1fr)] md:items-end md:gap-16">
            <div>
                <p class="mb-4 text-xs font-medium uppercase tracking-[0.2em] text-[#B23A48] [font-family:var(--serif-label)]">@(isDutch ? "Scoregids" : "Score guide")</p>
                <h2 class="m-0 text-[clamp(2.2rem,4.5vw,3.8rem)] font-medium leading-[1.08] text-[#071F3D] [font-family:var(--serif-heading)]">@(isDutch ? "Zo lees je de uitslag" : "How to read your result")</h2>
            </div>
            <p class="m-0 max-w-[40rem] text-lg leading-8 text-[#535353]">@(isDutch ? "Je score helpt je inschatten hoeveel basis je al hebt en hoeveel ondersteuning of herhaling voor jou prettig is." : "Your score helps you estimate how much foundation you already have and how much support or revision may be useful.")</p>
        </div>

        <div class="mt-12 border-t border-[#9FB1BD]">
            <article class="grid gap-4 border-b border-[#9FB1BD] py-7 md:grid-cols-[13rem_1fr] md:gap-12">
                <div>
                    <p class="m-0 text-2xl font-semibold text-[#071F3D] [font-family:var(--serif-heading)]">@(isDutch ? "51 punten of meer" : "51 points or more")</p>
                    <p class="mt-2 mb-0 text-xs font-semibold uppercase tracking-[0.16em] text-[#39705F]">@(isDutch ? "A1-basis bereikt" : "A1 foundation reached")</p>
                </div>
                <p class="m-0 max-w-[48rem] text-[1.05rem] leading-8 text-[#3F505A]">@(isDutch ? "Je beheerst de basis van niveau A1. De cursus Nederlands A1-A2 is een passende volgende stap." : "You have a solid A1 foundation. The Dutch A1-A2 course is a suitable next step.")</p>
            </article>
            <article class="grid gap-4 border-b border-[#9FB1BD] py-7 md:grid-cols-[13rem_1fr] md:gap-12">
                <div>
                    <p class="m-0 text-2xl font-semibold text-[#071F3D] [font-family:var(--serif-heading)]">@(isDutch ? "45 tot 50 punten" : "45 to 50 points")</p>
                    <p class="mt-2 mb-0 text-xs font-semibold uppercase tracking-[0.16em] text-[#A46722]">@(isDutch ? "Bijna op A1" : "Close to A1")</p>
                </div>
                <p class="m-0 max-w-[48rem] text-[1.05rem] leading-8 text-[#3F505A]">@(isDutch ? "De cursus kan goed bij je passen. Neem wel de tijd voor herhaling en doorloop alle uitleg en opdrachten zorgvuldig." : "The course can still be a good fit. Make time for revision and work through every explanation and assignment carefully.")</p>
            </article>
            <article class="grid gap-4 border-b border-[#9FB1BD] py-7 md:grid-cols-[13rem_1fr] md:gap-12">
                <div>
                    <p class="m-0 text-2xl font-semibold text-[#071F3D] [font-family:var(--serif-heading)]">@(isDutch ? "Minder dan 45 punten" : "Below 45 points")</p>
                    <p class="mt-2 mb-0 text-xs font-semibold uppercase tracking-[0.16em] text-[#B23A48]">@(isDutch ? "Eerst de basis versterken" : "Strengthen the basics first")</p>
                </div>
                <p class="m-0 max-w-[48rem] text-[1.05rem] leading-8 text-[#3F505A]">
                    @(isDutch ? "Je basis heeft waarschijnlijk nog wat aandacht nodig. Mail ons voor persoonlijk advies via " : "Your foundation probably needs some attention first. Email us for personal advice at ")
                    <a class="font-semibold text-[#8F2D3A] underline decoration-[#B23A48]/40 underline-offset-4 hover:decoration-[#B23A48]" href="mailto:info@id-develops.com">info@id-develops.com</a>.
                </p>
            </article>
        </div>
    </div>
</section>

<section id="start-level-test" class="bg-[#071F3D] py-16 text-white md:py-24">
    <div class="public-container grid gap-10 md:grid-cols-[minmax(0,1fr)_auto] md:items-end md:gap-16">
        <div>
            <p class="mb-4 text-xs font-medium uppercase tracking-[0.2em] text-[#F4C8CD] [font-family:var(--serif-label)]">@(isDutch ? "Klaar om te beginnen?" : "Ready to begin?")</p>
            <h2 class="m-0 max-w-[16ch] text-[clamp(2.5rem,5vw,4.5rem)] font-medium leading-[1.02] tracking-[-0.03em] text-white [font-family:var(--serif-heading)]">@(isDutch ? "Neem de tijd en ontdek waar je staat." : "Take your time and discover where you stand.")</h2>
            <p class="mt-6 mb-0 max-w-[39rem] text-lg leading-8 text-white/70">@(isDutch ? $"De test duurt ongeveer {duration}. Zodra je start, begint de timer." : $"The test takes around {duration}. The timer begins as soon as you start.")</p>
        </div>

        <div>
            @if (Model.IsLevelTestAvailable)
            {
                <form method="post" asp-page-handler="CreateRecord">
                    <button type="submit" class="public-btn public-btn-primary min-h-14 border-[#B23A48] bg-[#B23A48] px-7 text-white shadow-[0_12px_28px_rgba(0,0,0,0.22)] hover:border-[#C84E5F] hover:bg-[#C84E5F] focus:border-[#C84E5F] focus:bg-[#C84E5F]">
                        @(isDutch ? "Start de niveautest" : "Start the level test")
                        <i class="fa-solid fa-arrow-right-long" aria-hidden="true"></i>
                    </button>
                </form>
            }
            else
            {
                <div class="max-w-md border border-white/20 bg-white/10 p-5 text-sm leading-6 text-white" role="alert">
                    @(isDutch ? "De openbare niveautest is op dit moment niet beschikbaar. Probeer het later opnieuw." : "The public level test is currently unavailable. Please try again later.")
                </div>
            }
        </div>
    </div>
</section>
