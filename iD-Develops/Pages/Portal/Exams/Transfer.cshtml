@page
@model iD_Develops.Pages.Portal.Exams.TransferModel
@{
    Layout = "_PortalLayout";
    ViewData["Title"] = "Import exam";
}

<main class="mx-auto w-full max-w-4xl px-4 py-8 sm:px-6">
    <div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
        <div>
            <p class="mb-2 text-sm font-semibold uppercase tracking-[0.18em] text-sky-700">Exam transfer</p>
            <h1 class="text-3xl font-bold tracking-tight text-slate-950">Import an exam</h1>
            <p class="mt-3 max-w-2xl text-base leading-7 text-slate-600">
                Importing always creates a separate draft with new IDs. Existing exams, attempts, and results are never changed.
            </p>
        </div>
        <a asp-page="/Portal/Exams/List"
           class="inline-flex min-h-11 items-center justify-center gap-2 rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 shadow-sm transition hover:border-slate-400 hover:bg-slate-50">
            <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
            Back to exams
        </a>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.TransferSuccessMessage))
    {
        <div class="mb-4 rounded-xl border border-emerald-200 bg-emerald-50 p-4 text-sm text-emerald-900" role="status">
            <div class="flex items-start gap-3">
                <i class="fa-solid fa-circle-check mt-0.5" aria-hidden="true"></i>
                <div>
                    <p class="font-semibold">@Model.TransferSuccessMessage</p>
                    @if (Model.ImportedExamId.HasValue)
                    {
                        <a asp-page="/Portal/Examination/Edit"
                           asp-route-examId="@Model.ImportedExamId.Value"
                           class="mt-2 inline-flex font-semibold underline underline-offset-2">
                            Review imported exam
                        </a>
                    }
                </div>
            </div>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.TransferWarningMessage))
    {
        <div class="mb-4 rounded-xl border border-amber-200 bg-amber-50 p-4 text-sm text-amber-950" role="alert">
            <div class="flex items-start gap-3">
                <i class="fa-solid fa-triangle-exclamation mt-0.5" aria-hidden="true"></i>
                <p>@Model.TransferWarningMessage</p>
            </div>
        </div>
    }

    @if (Model.ImportFailure is { } failure)
    {
        <section class="mb-6 overflow-hidden rounded-xl border border-red-200 bg-red-50" role="alert" aria-labelledby="import-failure-title">
            <div class="border-b border-red-200 p-4 sm:p-5">
                <div class="flex items-start gap-3">
                    <i class="fa-solid fa-circle-exclamation mt-1 text-red-700" aria-hidden="true"></i>
                    <div class="min-w-0">
                        <h2 id="import-failure-title" class="text-base font-bold text-red-950">Import failed</h2>
                        <p class="mt-1 text-sm leading-6 text-red-900">@failure.Summary</p>
                    </div>
                </div>
            </div>
            <dl class="grid gap-3 p-4 text-sm sm:grid-cols-2 sm:p-5">
                <div>
                    <dt class="font-semibold text-red-950">Failure stage</dt>
                    <dd class="mt-1 text-red-900">@failure.Stage</dd>
                </div>
                <div>
                    <dt class="font-semibold text-red-950">Reference ID</dt>
                    <dd class="mt-1 font-mono text-red-900">@failure.ReferenceId</dd>
                </div>
                @if (!string.IsNullOrWhiteSpace(failure.FileName))
                {
                    <div class="sm:col-span-2">
                        <dt class="font-semibold text-red-950">File</dt>
                        <dd class="mt-1 break-all text-red-900">@failure.FileName</dd>
                    </div>
                }
            </dl>
            @if (failure.ShowTechnicalDetails && failure.TechnicalDetails.Count > 0)
            {
                <details class="border-t border-red-200 px-4 py-3 sm:px-5" open>
                    <summary class="cursor-pointer font-semibold text-red-950">Technical details</summary>
                    <ol class="mt-3 list-decimal space-y-2 pl-5 text-sm leading-6 text-red-900">
                        @foreach (var detail in failure.TechnicalDetails)
                        {
                            <li class="break-words font-mono">@detail</li>
                        }
                    </ol>
                </details>
            }
            else if (!failure.ShowTechnicalDetails)
            {
                <p class="border-t border-red-200 px-4 py-3 text-sm text-red-900 sm:px-5">
                    Technical details are recorded in the application log under this reference ID.
                </p>
            }
        </section>
    }

    <section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
        <form method="post" enctype="multipart/form-data" asp-page-handler="Import" class="space-y-6">
            <div>
                <label asp-for="ExamFile" class="mb-2 block text-sm font-semibold text-slate-800">Exam JSON file</label>
                <input asp-for="ExamFile"
                       type="file"
                       accept="application/json,.json"
                       class="block w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm text-slate-700 file:mr-4 file:rounded-md file:border-0 file:bg-sky-50 file:px-4 file:py-2 file:font-semibold file:text-sky-800 hover:file:bg-sky-100" />
                <span asp-validation-for="ExamFile" class="mt-2 block text-sm text-red-700"></span>
                <p class="mt-2 text-sm text-slate-500">Maximum size: 5 MB. Only files exported by this application are supported.</p>
            </div>

            <div class="rounded-xl bg-slate-50 p-4">
                <h2 class="text-sm font-semibold text-slate-900">What happens during import?</h2>
                <ul class="mt-3 list-disc space-y-2 pl-5 text-sm leading-6 text-slate-600">
                    <li>A new draft examination is created.</li>
                    <li>The original examination and all historical results remain unchanged.</li>
                    <li>Public URLs are not activated automatically.</li>
                    <li>You can review, publish, and assign the imported exam afterward.</li>
                </ul>
            </div>

            <button type="submit"
                    class="inline-flex min-h-11 items-center justify-center gap-2 rounded-lg bg-sky-700 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-sky-800 focus:outline-none focus:ring-2 focus:ring-sky-500 focus:ring-offset-2">
                <i class="fa-solid fa-file-import" aria-hidden="true"></i>
                Import as new draft
            </button>
        </form>
    </section>
</main>
