@page
@model iD_Develops.Pages.Portal.Exams.AssignmentsModel
@{
    Layout = "_PortalLayout";
    ViewData["Title"] = $"Assign {Model.Data.ExamName}";
    var assignedIds = Model.Data.Assignments.Select(item => item.UserId).ToHashSet(StringComparer.Ordinal);
}

<section class="portal-page-shell portal-data-page">
    <div class="portal-page-header">
        <div class="portal-page-header-copy">
            <a class="tw:mb-2 tw:inline-flex tw:items-center tw:gap-2 tw:text-sm tw:font-semibold tw:text-[#005190]" asp-page="/Portal/Exams/List"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i>Exams</a>
            <p class="portal-eyebrow">Exam access</p>
            <h1 class="portal-title-sm">@Model.Data.ExamName</h1>
            <p class="portal-copy">Assign this exam directly, schedule access, or grant additional attempts.</p>
        </div>
        <span class="tw:rounded-full tw:bg-slate-100 tw:px-3 tw:py-1 tw:text-xs tw:font-semibold tw:text-slate-700">@Model.Data.PublishStatus</span>
    </div>

    @if (TempData["StatusMessage"] is string status)
    {
        <div class="tw:mb-4 tw:rounded-xl tw:border tw:border-emerald-200 tw:bg-emerald-50 tw:p-4 tw:text-sm tw:text-emerald-900" role="status">@status</div>
    }
    @if (TempData["ErrorMessage"] is string error)
    {
        <div class="tw:mb-4 tw:rounded-xl tw:border tw:border-red-200 tw:bg-red-50 tw:p-4 tw:text-sm tw:text-red-900" role="alert">@error</div>
    }

    <div class="tw:grid tw:gap-5 tw:lg:grid-cols-2">
        <form method="post" asp-page-handler="Assign" asp-route-examId="@Model.Data.ExamId" class="tw:rounded-xl tw:border tw:border-slate-200 tw:bg-white tw:p-5 tw:shadow-sm">
            <h2 class="tw:m-0 tw:text-lg tw:font-semibold tw:text-slate-900">Direct assignment</h2>
            <p class="tw:mt-1 tw:text-sm tw:text-slate-500">The exam stays private to the selected user. Dates are UTC.</p>
            <div class="tw:mt-4 tw:grid tw:gap-4">
                <label class="tw:grid tw:gap-1 tw:text-sm tw:font-medium tw:text-slate-700">User
                    <select asp-for="SelectedUserId" class="portal-field" required>
                        <option value="">Select user</option>
                        @foreach (var user in Model.Data.UserOptions.Where(user => !assignedIds.Contains(user.UserId)))
                        {
                            <option value="@user.UserId">@user.Name (@user.Email)</option>
                        }
                    </select>
                </label>
                <div class="tw:grid tw:gap-4 tw:sm:grid-cols-2">
                    <label class="tw:grid tw:gap-1 tw:text-sm tw:font-medium tw:text-slate-700">Unlock at
                        <input asp-for="UnlockAtUtc" type="datetime-local" class="portal-field" />
                    </label>
                    <label class="tw:grid tw:gap-1 tw:text-sm tw:font-medium tw:text-slate-700">Due at
                        <input asp-for="DueAtUtc" type="datetime-local" class="portal-field" />
                    </label>
                </div>
                <button class="portal-btn portal-btn-primary tw:justify-self-start" type="submit"><i class="fa-solid fa-user-plus" aria-hidden="true"></i>Assign exam</button>
            </div>
        </form>

        <form method="post" asp-page-handler="GrantAttempts" asp-route-examId="@Model.Data.ExamId" class="tw:rounded-xl tw:border tw:border-slate-200 tw:bg-white tw:p-5 tw:shadow-sm">
            <h2 class="tw:m-0 tw:text-lg tw:font-semibold tw:text-slate-900">Grant attempts</h2>
            <p class="tw:mt-1 tw:text-sm tw:text-slate-500">Adds to the exam limit without changing the exam’s default settings.</p>
            <div class="tw:mt-4 tw:grid tw:gap-4">
                <label class="tw:grid tw:gap-1 tw:text-sm tw:font-medium tw:text-slate-700">User
                    <select asp-for="SelectedUserId" class="portal-field" required>
                        <option value="">Select user</option>
                        @foreach (var user in Model.Data.UserOptions)
                        {
                            <option value="@user.UserId">@user.Name (@user.Email)</option>
                        }
                    </select>
                </label>
                <label class="tw:grid tw:gap-1 tw:text-sm tw:font-medium tw:text-slate-700">Additional attempts
                    <input asp-for="AdditionalAttempts" type="number" min="1" max="1000" class="portal-field" />
                </label>
                <label class="tw:grid tw:gap-1 tw:text-sm tw:font-medium tw:text-slate-700">Reason (optional)
                    <textarea asp-for="AttemptReason" rows="3" maxlength="500" class="portal-field"></textarea>
                </label>
                <button class="portal-btn portal-btn-primary tw:justify-self-start" type="submit"><i class="fa-solid fa-plus" aria-hidden="true"></i>Grant attempts</button>
            </div>
        </form>
    </div>

    <div class="tw:mt-6 tw:rounded-xl tw:border tw:border-slate-200 tw:bg-white tw:shadow-sm">
        <div class="tw:border-b tw:border-slate-100 tw:px-5 tw:py-4"><h2 class="tw:m-0 tw:text-base tw:font-semibold tw:text-slate-900">Directly assigned users</h2></div>
        <div class="portal-table-wrap">
            <table class="portal-exams-table">
                <thead><tr><th>User</th><th>Unlock</th><th>Due</th><th>Assigned</th><th></th></tr></thead>
                <tbody>
                @if (Model.Data.Assignments.Count == 0)
                {
                    <tr><td colspan="5" class="tw:px-5 tw:py-8 tw:text-center tw:text-sm tw:text-slate-500">No direct assignments yet.</td></tr>
                }
                @foreach (var assignment in Model.Data.Assignments)
                {
                    <tr>
                        <td><strong class="tw:block">@assignment.Name</strong><small>@assignment.Email</small></td>
                        <td>@(assignment.UnlockAtUtc?.ToString("dd MMM yyyy HH:mm") ?? "Immediately")</td>
                        <td>@(assignment.DueAtUtc?.ToString("dd MMM yyyy HH:mm") ?? "No due date")</td>
                        <td>@assignment.AssignedAtUtc.ToString("dd MMM yyyy")<small class="tw:block">by @assignment.AssignedBy</small></td>
                        <td><form method="post" asp-page-handler="Remove" asp-route-examId="@Model.Data.ExamId" onsubmit="return confirm('Remove this direct assignment?');"><input type="hidden" name="userId" value="@assignment.UserId" /><button class="portal-btn portal-btn-danger portal-btn-sm" type="submit">Remove</button></form></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>

    @if (Model.Data.AttemptGrants.Count > 0)
    {
        <div class="tw:mt-6 tw:rounded-xl tw:border tw:border-slate-200 tw:bg-white tw:p-5 tw:shadow-sm">
            <h2 class="tw:m-0 tw:text-base tw:font-semibold tw:text-slate-900">Attempt grant history</h2>
            <ul class="tw:mt-4 tw:grid tw:gap-3 tw:p-0">
                @foreach (var grant in Model.Data.AttemptGrants)
                {
                    <li class="tw:list-none tw:rounded-lg tw:border tw:border-slate-100 tw:bg-slate-50 tw:px-4 tw:py-3 tw:text-sm"><strong>@grant.UserName</strong> received @grant.AdditionalAttempts attempt@(grant.AdditionalAttempts == 1 ? string.Empty : "s") <span class="tw:text-slate-500">on @grant.GrantedAtUtc.ToString("dd MMM yyyy") by @grant.GrantedBy</span>@if (!string.IsNullOrWhiteSpace(grant.Reason)){<small class="tw:mt-1 tw:block tw:text-slate-600">@grant.Reason</small>}</li>
                }
            </ul>
        </div>
    }
</section>
