@page
@model iD_Develops.Pages.Portal.Exams.ResultsModel
@{
    Layout = "_PortalLayout";
    ViewData["Title"] = "Results";
    var uniqueExamCount = Model.Results.Select(result => result.ExamId).Distinct().Count();
    var scoredResults = Model.Results.Where(result => result.MaxScore > 0).ToList();
    var averageScorePercentage = scoredResults.Count == 0
        ? 0
        : Math.Round(scoredResults.Average(result => result.Score / result.MaxScore * 100));
}

@functions {
    private static string GetStatusPillClass(iD_Develops.Models.ExamStatus status)
    {
        return status switch
        {
            iD_Develops.Models.ExamStatus.NotStarted => "portal-table-pill-status-not-started",
            iD_Develops.Models.ExamStatus.InProgress => "portal-table-pill-status-in-progress",
            iD_Develops.Models.ExamStatus.Completed => "portal-table-pill-status-completed",
            iD_Develops.Models.ExamStatus.Overdue => "portal-table-pill-status-overdue",
            iD_Develops.Models.ExamStatus.Cancelled => "portal-table-pill-status-cancelled",
            iD_Develops.Models.ExamStatus.Invalid => "portal-table-pill-status-invalid",
            iD_Develops.Models.ExamStatus.Disconnected => "portal-table-pill-status-disconnected",
            _ => "portal-table-pill-status-default"
        };
    }
}

<div class="portal-page-shell portal-data-page">
    <div class="portal-page-header">
        <div class="portal-page-header-copy">
            <p class="portal-eyebrow">Exams</p>
            <h1 class="portal-title-sm">Results</h1>
            <p class="portal-copy">Review your completed exam results, including when you took them and the score you achieved.</p>
        </div>
    </div>

    <div class="tw:mb-4 tw:grid tw:flex-none tw:gap-3 tw:sm:grid-cols-3" aria-label="Results overview">
        <article class="tw:flex tw:items-center tw:gap-3 tw:rounded-lg tw:border tw:border-[#dfe5ec] tw:bg-white tw:px-4 tw:py-3 tw:shadow-[0_1px_2px_rgba(2,7,47,0.04)]">
            <span class="tw:grid tw:size-9 tw:flex-none tw:place-items-center tw:rounded-md tw:bg-[#eaf3fa] tw:text-[#005190]" aria-hidden="true"><i class="fa-solid fa-list-check"></i></span>
            <span><span class="tw:block tw:text-[0.68rem] tw:font-semibold tw:uppercase tw:tracking-[0.08em] tw:text-[#64748b]">Results</span><strong class="tw:block tw:text-xl tw:font-semibold tw:leading-tight tw:text-[#071f3d]">@Model.Results.Count</strong></span>
        </article>
        <article class="tw:flex tw:items-center tw:gap-3 tw:rounded-lg tw:border tw:border-[#dfe5ec] tw:bg-white tw:px-4 tw:py-3 tw:shadow-[0_1px_2px_rgba(2,7,47,0.04)]">
            <span class="tw:grid tw:size-9 tw:flex-none tw:place-items-center tw:rounded-md tw:bg-[#eef6f4] tw:text-[#287a55]" aria-hidden="true"><i class="fa-solid fa-file-circle-check"></i></span>
            <span><span class="tw:block tw:text-[0.68rem] tw:font-semibold tw:uppercase tw:tracking-[0.08em] tw:text-[#64748b]">Exams completed</span><strong class="tw:block tw:text-xl tw:font-semibold tw:leading-tight tw:text-[#071f3d]">@uniqueExamCount</strong></span>
        </article>
        <article class="tw:flex tw:items-center tw:gap-3 tw:rounded-lg tw:border tw:border-[#dfe5ec] tw:bg-white tw:px-4 tw:py-3 tw:shadow-[0_1px_2px_rgba(2,7,47,0.04)]">
            <span class="tw:grid tw:size-9 tw:flex-none tw:place-items-center tw:rounded-md tw:bg-[#f7eff1] tw:text-[#B23A48]" aria-hidden="true"><i class="fa-solid fa-chart-line"></i></span>
            <span><span class="tw:block tw:text-[0.68rem] tw:font-semibold tw:uppercase tw:tracking-[0.08em] tw:text-[#64748b]">Average score</span><strong class="tw:block tw:text-xl tw:font-semibold tw:leading-tight tw:text-[#071f3d]">@(scoredResults.Count == 0 ? "—" : $"{averageScorePercentage:0}%")</strong></span>
        </article>
    </div>

    <div class="tw:mb-2 tw:flex tw:flex-none tw:items-end tw:justify-between tw:gap-4">
        <div><p class="tw:m-0 tw:text-sm tw:font-semibold tw:text-[#071f3d]">Result history</p><p class="tw:m-0 tw:text-xs tw:text-[#64748b]">Review scores and open the details of a result.</p></div>
        <span class="tw:text-xs tw:font-medium tw:text-[#64748b]">@Model.Results.Count records</span>
    </div>

    <div class="portal-table-card portal-exams-table-card">
        @if (Model.Results.Count == 0)
        {
            <div class="portal-card-centered tw:p-6 tw:lg:p-10">
                <p class="portal-eyebrow">No results yet</p>
                <h2 class="portal-title-sm">Your completed records will appear here</h2>
                <p class="portal-copy portal-copy-spaced">Once you finish an exam, you will be able to review the record from this page.</p>
                <a class="portal-btn portal-btn-outline" asp-page="/Portal/Exams/List">Go to my exams</a>
            </div>
        }
        else
        {
            <div class="portal-table-wrap">
                <table class="portal-exams-table">
                    <thead>
                        <tr>
                            <th>Exam</th>
                            <th>Completed</th>
                            <th>Status</th>
                            <th>Version</th>
                            <th>Score</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var record in Model.Results)
                    {
                        <tr>
                            <td>
                                <div class="portal-exam-name">@record.ExamName</div>
                                <div class="portal-table-meta">Started @record.StartDateTime.ToLocalTime().ToString("dd MMM yyyy")</div>
                            </td>
                            <td>
                                <span class="portal-table-meta">
                                    @((record.EndDateTime ?? record.StartDateTime).ToLocalTime().ToString("dd MMM yyyy"))
                                </span>
                            </td>
                            <td>
                                <span class="portal-table-pill portal-table-pill-status @GetStatusPillClass(record.ExamStatus)">@record.ExamStatus</span>
                            </td>
                            <td>
                                <span class="portal-table-meta">@(record.ExamVersionNumber.HasValue ? $"v{record.ExamVersionNumber}" : "Legacy")</span>
                            </td>
                            <td>
                                <span class="portal-table-meta">@(record.MaxScore > 0 ? $"{record.Score:0.##} / {record.MaxScore:0.##}" : "—")</span>
                            </td>
                            <td class="portal-exams-table-actions">
                                <a class="portal-btn portal-btn-outline portal-btn-sm"
                                   asp-page="/Portal/Exams/Record"
                                   asp-route-recordId="@record.RecordId">
                                    View
                                </a>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
