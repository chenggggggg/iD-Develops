@page
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@model iD_Develops.Pages.Portal.Exams.ListModel
@{
    Layout = "_PortalLayout";
    @if (User.IsInRole("Teacher") || (User.IsInRole("Admin") || User.IsInRole("SuperAdmin")))
    {
        ViewData["Title"] = "Exams";
    }
    else
    {
        ViewData["Title"] = "Exams";        
    }
    var requestToken = Antiforgery.GetAndStoreTokens(Model.HttpContext).RequestToken;
    var canManageExams = User.IsInRole("Teacher") || User.IsInRole("Admin") || User.IsInRole("SuperAdmin");
    var publishedExamCount = Model.Exams.Count(exam => exam.PublishStatus == iD_Develops.Models.ExamPublishStatus.Published);
    var draftExamCount = Model.Exams.Count(exam => exam.PublishStatus == iD_Develops.Models.ExamPublishStatus.Draft);
    var timedExamCount = Model.Exams.Count(exam => exam.TimeLimit.HasValue);
    var difficultyCount = Model.Exams.Select(exam => exam.Difficulty).Distinct().Count();
}

<div class="portal-page-shell portal-data-page">
    <input id="RequestVerificationToken" type="hidden" value="@requestToken" />

    @if (TempData["ExamLaunchError"] is string launchError)
    {
        <div class="portal-exam-launch-error-banner" role="alert">
            <i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i>
            <span>@launchError</span>
        </div>
    }

    @if (TempData["ExamActionSuccess"] is string actionSuccess)
    {
        <div class="mb-4 rounded-xl border border-emerald-200 bg-emerald-50 p-4 text-sm text-emerald-900" role="status">
            <i class="fa-solid fa-circle-check mr-2" aria-hidden="true"></i>@actionSuccess
        </div>
    }

    @if (TempData["ExamActionError"] is string actionError)
    {
        <div class="mb-4 rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-900" role="alert">
            <i class="fa-solid fa-circle-exclamation mr-2" aria-hidden="true"></i>@actionError
        </div>
    }

    @if(User.IsInRole("Teacher") || (User.IsInRole("Admin") || User.IsInRole("SuperAdmin")))
    {
        <div class="portal-page-header">
            <div class="portal-page-header-copy">
                <p class="portal-eyebrow">Exams</p>
                <h1 class="portal-title-sm">View, edit, and organize your exams</h1>
                <p class="portal-copy">Keep your examination library up to date and jump into editing whenever you need to make changes.</p>
            </div>
            <div class="portal-page-header-actions">
                <a class="portal-btn portal-btn-outline" asp-page="/Portal/Exams/Transfer">
                    <i class="fa-solid fa-file-import" aria-hidden="true"></i>
                    Import exam
                </a>
                <a class="portal-btn portal-btn-primary" asp-page="/Portal/Exams/Create">
                    Create new exam
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="portal-page-header">
            <div class="portal-page-header-copy">
                <p class="portal-eyebrow">Exams</p>
                <h1 class="portal-title-sm">Your assigned exams in one place</h1>
                <p class="portal-copy">Open an exam when you are ready, or come back later and continue from the portal.</p>
            </div>
        </div>
    }

    <div class="mb-4 grid flex-none gap-3 sm:grid-cols-3" aria-label="Exam overview">
        <article class="flex items-center gap-3 rounded-lg border border-[#dfe5ec] bg-white px-4 py-3 shadow-[0_1px_2px_rgba(2,7,47,0.04)]">
            <span class="grid size-9 flex-none place-items-center rounded-md bg-[#eaf3fa] text-[#005190]" aria-hidden="true"><i class="fa-solid fa-file-lines"></i></span>
            <span><span class="block text-[0.68rem] font-semibold uppercase tracking-[0.08em] text-[#64748b]">@(canManageExams ? "Total exams" : "Assigned exams")</span><strong class="block text-xl font-semibold leading-tight text-[#071f3d]">@Model.Exams.Count</strong></span>
        </article>
        <article class="flex items-center gap-3 rounded-lg border border-[#dfe5ec] bg-white px-4 py-3 shadow-[0_1px_2px_rgba(2,7,47,0.04)]">
            <span class="grid size-9 flex-none place-items-center rounded-md bg-[#eef6f4] text-[#287a55]" aria-hidden="true"><i class="fa-solid @(canManageExams ? "fa-circle-check" : "fa-clock")"></i></span>
            <span><span class="block text-[0.68rem] font-semibold uppercase tracking-[0.08em] text-[#64748b]">@(canManageExams ? "Published" : "Timed exams")</span><strong class="block text-xl font-semibold leading-tight text-[#071f3d]">@(canManageExams ? publishedExamCount : timedExamCount)</strong></span>
        </article>
        <article class="flex items-center gap-3 rounded-lg border border-[#dfe5ec] bg-white px-4 py-3 shadow-[0_1px_2px_rgba(2,7,47,0.04)]">
            <span class="grid size-9 flex-none place-items-center rounded-md bg-[#f7eff1] text-[#B23A48]" aria-hidden="true"><i class="fa-solid @(canManageExams ? "fa-pen-ruler" : "fa-layer-group")"></i></span>
            <span><span class="block text-[0.68rem] font-semibold uppercase tracking-[0.08em] text-[#64748b]">@(canManageExams ? "Drafts" : "Levels")</span><strong class="block text-xl font-semibold leading-tight text-[#071f3d]">@(canManageExams ? draftExamCount : difficultyCount)</strong></span>
        </article>
    </div>

    <div class="mb-2 flex flex-none items-end justify-between gap-4">
        <div><p class="m-0 text-sm font-semibold text-[#071f3d]">@(canManageExams ? "Exam library" : "Your exams")</p><p class="m-0 text-xs text-[#64748b]">@(canManageExams ? "Start, edit, export, or archive an examination." : "Choose an exam when you are ready to begin.")</p></div>
        <span class="text-xs font-medium text-[#64748b]">@Model.Exams.Count total</span>
    </div>

    <div class="portal-table-card portal-exams-table-card">
        <div class="portal-table-wrap">
        <table class="portal-exams-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Level</th>
                    <th>Time limit</th>
                    @if ((User.IsInRole("Admin") || User.IsInRole("SuperAdmin")) || User.IsInRole("Teacher"))
                    {
                        <th>Status</th>
                    }
                    <th class="portal-table-cell-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var exam in Model.Exams)
                {
                    <tr>
                        <td>
                            <div class="portal-exam-name">@exam.Name</div>
                            @if (!canManageExams && Model.AvailabilityByExamId.TryGetValue(exam.Id, out var availability))
                            {
                                @if (availability.CanTake)
                                {
                                    <small class="mt-1 block font-medium text-emerald-700">Available now</small>
                                }
                                else if (availability.UnlockAtUtc.HasValue)
                                {
                                    <small class="mt-1 block font-medium text-amber-700">Unlocks @availability.UnlockAtUtc.Value.ToString("dd MMM yyyy HH:mm") UTC</small>
                                }
                                else
                                {
                                    <small class="mt-1 block font-medium text-slate-500">@availability.BlockReason</small>
                                }
                            }
                        </td>
                        <td>
                            <span class="portal-table-pill">@exam.Difficulty</span>
                        </td>
                        @if (exam.TimeLimit.HasValue)
                        {
                            <td>
                                <span class="portal-table-meta">@exam.TimeLimit</span>
                            </td>
                        }
                        else
                        {
                            <td>
                                <span class="portal-table-meta">No time limit</span>
                            </td>
                        }
                        @if ((User.IsInRole("Admin") || User.IsInRole("SuperAdmin")) || User.IsInRole("Teacher"))
                        {
                            <td>
                                <span class="portal-table-pill portal-table-pill-status">@exam.PublishStatus</span>
                            </td>
                        }
                        <td class="portal-exams-table-actions portal-table-cell-end">
                            @{
                                Model.AvailabilityByExamId.TryGetValue(exam.Id, out var rowAvailability);
                                var examCanLaunch = canManageExams || rowAvailability == null || rowAvailability.CanTake;
                                var actionsPopoverId = $"exam-actions-{exam.Id}";
                            }
                            <div class="flex items-center justify-end gap-2">
                                <button type="button"
                                        class="portal-btn portal-btn-primary portal-btn-sm portal-exam-start-btn"
                                        data-portal-dialog-open="examLaunchDialog"
                                        data-exam-launch
                                        data-exam-id="@exam.Id"
                                        disabled="@(!examCanLaunch)"
                                        title="@(examCanLaunch ? "Start exam" : rowAvailability?.BlockReason ?? "Exam is locked")">
                                    <i class="fa-solid @(examCanLaunch ? "fa-play" : "fa-lock")" aria-hidden="true"></i>
                                    <span class="@(canManageExams ? "sr-only" : null)">@(examCanLaunch ? "Start" : "Locked")</span>
                                </button>
                                @if (User.IsInRole("Teacher") || (User.IsInRole("Admin") || User.IsInRole("SuperAdmin")))
                                {
                                    <a class="portal-btn portal-btn-outline portal-btn-sm portal-btn-icon"
                                       asp-page="/Portal/Exams/Assignments"
                                       asp-route-examId="@exam.Id"
                                       title="Assign users and grant attempts">
                                        <i class="fa-solid fa-user-check" aria-hidden="true"></i>
                                    </a>
                                    <a class="portal-btn portal-btn-sm portal-btn-icon portal-exam-action-edit"
                                       role="button"
                                       asp-page="/Portal/Examination/Edit"
                                       asp-route-examId="@exam.Id"
                                       title="Edit">
                                        <i class="fa-solid fa-pencil"></i>
                                    </a>

                                    <button type="button"
                                            class="portal-btn portal-btn-outline portal-btn-sm portal-btn-icon"
                                            title="More actions"
                                            aria-label="More actions for @exam.Name"
                                            aria-haspopup="true"
                                            popovertarget="@actionsPopoverId"
                                            data-exam-actions-trigger="@actionsPopoverId">
                                        <i class="fa-solid fa-ellipsis" aria-hidden="true"></i>
                                    </button>
                                    <div id="@actionsPopoverId"
                                         class="portal-exam-actions-popover w-44 gap-1 rounded-lg border border-slate-200 bg-white p-1.5 text-left shadow-xl"
                                         popover="auto"
                                         data-exam-actions-popover>
                                        <a class="flex items-center gap-2 rounded-md px-3 py-2 text-sm font-semibold text-slate-700 no-underline hover:bg-slate-50" asp-page="/Portal/Exams/Transfer" asp-page-handler="Export" asp-route-examId="@exam.Id"><i class="fa-solid fa-file-export w-4" aria-hidden="true"></i>Export</a>
                                        @if (exam.PublishStatus != iD_Develops.Models.ExamPublishStatus.Archived)
                                        {
                                            <form method="post" asp-page-handler="ArchiveExam" asp-route-examId="@exam.Id" class="m-0" onsubmit="return confirm('Archive this exam? Existing attempts and results will remain available.');">
                                                <button type="submit" class="flex w-full items-center gap-2 rounded-md border-0 bg-transparent px-3 py-2 text-left text-sm font-semibold text-slate-700 hover:bg-slate-50"><i class="fa-solid fa-box-archive w-4" aria-hidden="true"></i>Archive</button>
                                            </form>
                                        }
                                        <button type="button" class="flex w-full items-center gap-2 rounded-md border-0 bg-transparent px-3 py-2 text-left text-sm font-semibold text-red-700 hover:bg-red-50" data-delete-url="@Url.Page("/Portal/Exams/List", "DeleteExam", new { examId = exam.Id })" data-exam-id="@exam.Id" data-delete-exam><i class="fa-solid fa-trash w-4" aria-hidden="true"></i>Delete</button>
                                    </div>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    </div>
</div>

<div class="portal-dialog-backdrop" data-portal-dialog-backdrop="examLaunchDialog" hidden></div>
<div class="portal-dialog portal-exam-launch-dialog"
     id="examLaunchDialog"
     role="dialog"
     aria-modal="true"
     aria-labelledby="examLaunchDialogTitle"
     tabindex="-1"
     hidden>
    <section class="portal-exam-launch-dialog-card">
        <div class="portal-dialog-header">
            <div>
                <p class="portal-eyebrow" data-exam-launch-eyebrow>Before you begin</p>
                <h2 class="portal-title-sm" id="examLaunchDialogTitle" data-exam-launch-title>Exam details</h2>
            </div>
            <button type="button"
                    class="portal-dialog-close"
                    data-portal-dialog-close="examLaunchDialog"
                    aria-label="Close">
                <i class="fa-solid fa-xmark" aria-hidden="true"></i>
            </button>
        </div>

        <div class="portal-dialog-body portal-exam-launch-body">
            <div class="portal-exam-launch-loading" data-exam-launch-loading role="status">
                <span class="portal-exam-launch-spinner" aria-hidden="true"></span>
                <span>Loading exam details...</span>
            </div>

            <div class="portal-exam-launch-error" data-exam-launch-error role="alert" hidden>
                <i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i>
                <span data-exam-launch-error-text>Exam details could not be loaded.</span>
            </div>

            <div data-exam-launch-content hidden>
                <div class="portal-exam-launch-meta" aria-label="Exam information">
                    <div class="portal-exam-launch-meta-item">
                        <i class="fa-solid fa-graduation-cap" aria-hidden="true"></i>
                        <div>
                            <span>Course</span>
                            <strong data-exam-launch-course>-</strong>
                        </div>
                    </div>
                    <div class="portal-exam-launch-meta-item">
                        <i class="fa-regular fa-clock" aria-hidden="true"></i>
                        <div>
                            <span>Time limit</span>
                            <strong data-exam-launch-time>-</strong>
                        </div>
                    </div>
                    <div class="portal-exam-launch-meta-item">
                        <i class="fa-solid fa-rotate" aria-hidden="true"></i>
                        <div>
                            <span>Attempts</span>
                            <strong data-exam-launch-attempts>-</strong>
                        </div>
                    </div>
                </div>

                <div class="portal-exam-launch-introduction" data-exam-launch-introduction></div>

                <div class="portal-exam-launch-state" data-exam-launch-state hidden>
                    <i class="fa-solid fa-circle-info" aria-hidden="true"></i>
                    <span data-exam-launch-state-text></span>
                </div>
            </div>
        </div>

        <div class="portal-exam-launch-footer">
            <button type="button"
                    class="portal-btn portal-btn-outline"
                    data-portal-dialog-close="examLaunchDialog">
                Cancel
            </button>

            <form method="post" asp-page-handler="LaunchExam" class="portal-exam-launch-form" data-exam-launch-restart-form hidden>
                <input type="hidden" name="examId" data-exam-launch-restart-id />
                <input type="hidden" name="launchAction" value="restart" />
                <button type="submit" class="portal-btn portal-btn-outline">
                    <i class="fa-solid fa-rotate-right" aria-hidden="true"></i>
                    Restart
                </button>
            </form>

            <form method="post" asp-page-handler="LaunchExam" class="portal-exam-launch-form" data-exam-launch-primary-form hidden>
                <input type="hidden" name="examId" data-exam-launch-primary-id />
                <input type="hidden" name="launchAction" data-exam-launch-action />
                <button type="submit" class="portal-btn portal-btn-primary" data-exam-launch-submit>
                    <i class="fa-solid fa-play" aria-hidden="true" data-exam-launch-submit-icon></i>
                    <span data-exam-launch-submit-label>Start exam</span>
                </button>
            </form>
        </div>
    </section>
</div>

@section Scripts {
    <script src="/js/display-messages.js"></script>
    <script src="/js/exam-table.js"></script>
    <script src="~/js/exams-list.js" asp-append-version="true"></script>
}
