@page
@using iD_Develops.Enums
@model iD_Develops.Pages.Portal.Admin.Products.FreeDownloadsModel
@inject iD_Develops.Services.IApplicationUrlService ApplicationUrls
@{
    Layout = Model.IsAdminEditMode ? "_PortalLayout" : "_Layout";
    ViewData["Title"] = "Free Downloads";
}
<section class="public-page product-page-shell @(Model.IsAdminEditMode ? "product-edit-mode-shell" : null)">
    <div class="public-container">
    <div class="mb-8 flex flex-col justify-between gap-3 md:flex-row md:items-center">
        <div>
            <p class="public-catalog-label">Free downloads</p>
            <h1 class="public-page-title mb-0">Free Downloads</h1>
        </div>
        @if (Model.IsAdminEditMode)
        {
            <a class="public-btn public-btn-outline" asp-page="/Portal/Admin/Products/Index">
                <i class="fa-solid fa-arrow-left-long" aria-hidden="true"></i>Products
            </a>
        }
    </div>

    @if (TempData["StatusMessage"] is string statusMessage)
    {
        <div class="public-alert public-alert-success product-page-alert">@statusMessage</div>
    }

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="public-alert public-alert-danger product-page-alert">
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <div>@error.ErrorMessage</div>
            }
        </div>
    }

    @if (Model.Downloads.Count == 0 && !Model.IsAdminEditMode)
    {
        <div class="public-empty-state">
            No free downloads are available yet.
        </div>
    }
    else
    {
        <div class="public-catalog-grid">
            @foreach (var download in Model.Downloads)
            {
                var downloadName = ProductModel.IsDraftPlaceholderName(download.Name) ? "Download title" : download.Name;
                var saveFormId = $"download-save-form-{download.Id}";
                var saveButtonLabel = download.Status == CatalogProductStatus.Published ? "Save" : "Publish";
                var saveButtonIcon = download.Status == CatalogProductStatus.Published ? "fa-solid fa-floppy-disk" : "fa-solid fa-cloud-arrow-up";
                var imageDisplayUrl = await Model.ResolvePublicAssetUrlAsync(download.ImageUrl);
                var publicDownloadPath = Url.RouteUrl(
                    "PublicFreeDownloads",
                    new { culture = "en-us", handler = "Download", id = download.Id });
                var downloadUrl = string.IsNullOrWhiteSpace(download.IncludedBookingBenefitUrl) || string.IsNullOrWhiteSpace(publicDownloadPath)
                    ? null
                    : ApplicationUrls.PublicUrl(publicDownloadPath);
                <div>
                    @if (Model.IsAdminEditMode)
                    {
                        <article class="public-catalog-card free-download-edit-card">
                            <div class="public-catalog-body gap-3">
                                <div class="flex items-center justify-between gap-2">
                                    <span class="public-status-pill @(download.Status == CatalogProductStatus.Published ? "public-status-pill-success" : "public-status-pill-warning")">@download.Status</span>
                                </div>

                                <form id="@saveFormId" method="post" enctype="multipart/form-data" asp-page-handler="Save" asp-route-id="@download.Id" class="grid gap-3" data-product-id="@download.Id">
                                    @Html.AntiForgeryToken()
                                    <div class="product-editable-field">
                                        <input class="product-editable-input"
                                               name="EditInput.Name"
                                               value="@(ProductModel.IsDraftPlaceholderName(download.Name) ? string.Empty : download.Name)"
                                               placeholder="Download title"
                                               aria-label="Download title" />
                                        <i class="fa-solid fa-pencil product-editable-icon" aria-hidden="true"></i>
                                    </div>

                                    <div class="free-download-image-upload">
                                        <div class="free-download-image-upload-inner">
                                        <button type="button"
                                                class="free-download-image-picker"
                                                data-upload-trigger="image"
                                                aria-label="Select image">
                                            @if (!string.IsNullOrWhiteSpace(imageDisplayUrl))
                                            {
                                                <img src="@imageDisplayUrl" alt="@downloadName" data-image-preview />
                                            }
                                            <span class="free-download-image-picker-copy" data-upload-label="image">Select image</span>
                                        </button>
                                        <input class="hidden"
                                               type="file"
                                               accept="@Model.ImageAccept"
                                               data-upload-input="image" />
                                        <input type="hidden"
                                               name="EditInput.ImageObjectKey"
                                               value="@download.ImageUrl"
                                               data-upload-key="image" />
                                        <input type="hidden"
                                               name="EditInput.OriginalImageObjectKey"
                                               value="@download.ImageUrl" />
                                            <div class="free-download-upload-status" data-upload-status="image"></div>
                                        </div>
                                    </div>

                                    <div class="product-editable-field">
                                        <textarea class="product-editable-textarea"
                                                  name="EditInput.Description"
                                                  rows="4"
                                                  placeholder="Description"
                                                  aria-label="Download description">@download.Summary</textarea>
                                        <i class="fa-solid fa-pencil product-editable-icon" aria-hidden="true"></i>
                                    </div>

                                    <div class="free-download-file-upload">
                                        <button type="button"
                                                class="public-btn public-btn-outline min-h-9 px-3 py-2 text-xs"
                                                data-upload-trigger="download">
                                            <i class="fa-solid fa-paperclip" aria-hidden="true"></i>
                                            <span data-upload-label="download">Select download file</span>
                                        </button>
                                        <input class="hidden"
                                               type="file"
                                               accept="@Model.DownloadAccept"
                                               data-upload-input="download" />
                                        <input type="hidden"
                                               name="EditInput.DownloadObjectKey"
                                               value="@download.IncludedBookingBenefitUrl"
                                               data-upload-key="download" />
                                        <input type="hidden"
                                               name="EditInput.OriginalDownloadObjectKey"
                                               value="@download.IncludedBookingBenefitUrl" />
                                        @if (!string.IsNullOrWhiteSpace(downloadUrl))
                                        {
                                            <a class="free-download-current-link" href="@downloadUrl" target="_blank" rel="noopener" data-current-download-link>
                                                <i class="fa-solid fa-download" aria-hidden="true"></i>
                                                Current download
                                            </a>
                                        }
                                        <div class="free-download-upload-status" data-upload-status="download"></div>
                                    </div>
                                </form>
                            </div>
                            <div class="flex flex-wrap items-center justify-between gap-2 bg-white px-6 pb-6">
                                <div class="flex flex-wrap items-center gap-2">
                                    @if (download.Status == CatalogProductStatus.Archived)
                                    {
                                        <form method="post" asp-page-handler="SetStatus" asp-route-id="@download.Id" class="m-0">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="status" value="@CatalogProductStatus.Draft" />
                                            <button type="submit" class="public-btn public-btn-outline">
                                                <i class="fa-solid fa-file-lines" aria-hidden="true"></i>Move to draft
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <button type="submit" form="@saveFormId" class="public-btn public-btn-primary" data-save-button data-save-label="@saveButtonLabel" data-save-icon="@saveButtonIcon">
                                            <i class="@saveButtonIcon" aria-hidden="true"></i>@saveButtonLabel
                                        </button>

                                        @if (download.Status == CatalogProductStatus.Published)
                                        {
                                            <form method="post" asp-page-handler="SetStatus" asp-route-id="@download.Id" class="m-0">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="status" value="@CatalogProductStatus.Draft" />
                                                <button type="submit" class="public-btn public-btn-outline">
                                                    <i class="fa-solid fa-file-lines" aria-hidden="true"></i>Draft
                                                </button>
                                            </form>
                                        }
                                    }
                                </div>
                                <div class="flex items-center gap-2">
                                    @if (download.Status != CatalogProductStatus.Archived)
                                    {
                                        <form method="post" asp-page-handler="SetStatus" asp-route-id="@download.Id" class="m-0">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="status" value="@CatalogProductStatus.Archived" />
                                            <button type="submit" class="public-btn public-btn-outline" aria-label="Archive download">
                                                <i class="fa-solid fa-box-archive" aria-hidden="true"></i>
                                            </button>
                                        </form>
                                    }
                                    <form method="post" asp-page-handler="Delete" asp-route-id="@download.Id" class="m-0">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="public-btn public-btn-outline free-download-delete-button" aria-label="Delete download">
                                            <i class="fa-solid fa-trash" aria-hidden="true"></i>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </article>
                    }
                    else
                    {
                        <article class="public-catalog-card">
                            @if (!string.IsNullOrWhiteSpace(imageDisplayUrl))
                            {
                                <img src="@imageDisplayUrl" class="download-card-image" alt="@download.Name" />
                            }
                            <div class="public-catalog-body">
                                <div class="public-catalog-label">Free download</div>
                                <h2 class="public-catalog-title">@download.Name</h2>
                                <p class="public-catalog-summary">@download.Summary</p>
                                @if (!string.IsNullOrWhiteSpace(downloadUrl))
                                {
                                    <a class="public-btn public-btn-outline mt-6" href="@downloadUrl" target="_blank" rel="noopener">
                                        <i class="fa-solid fa-download" aria-hidden="true"></i>Download
                                    </a>
                                }
                            </div>
                        </article>
                    }
                </div>
            }

            @if (Model.IsAdminEditMode)
            {
                <div>
                    <form method="post" asp-page-handler="Create" class="h-full">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="free-download-add-card">
                            <span class="free-download-add-icon" aria-hidden="true">
                                <i class="fa-solid fa-plus"></i>
                            </span>
                            <span class="free-download-add-title">Add free download</span>
                            <span class="free-download-add-copy">Create an untitled file card and edit it here.</span>
                        </button>
                    </form>
                </div>
            }
        </div>
    }
    </div>
</section>

@if (Model.IsAdminEditMode)
{
    <input type="hidden" id="FreeDownloadUploadsEnabled" value="@Model.UploadsEnabled.ToString().ToLowerInvariant()" />
    <input type="hidden" id="FreeDownloadMaxImageBytes" value="@Model.MaxImageBytes" />
    <input type="hidden" id="FreeDownloadMaxDownloadBytes" value="@Model.MaxDownloadBytes" />

    <div class="product-edit-mode-bar" role="status">
        <div class="product-edit-mode-bar-inner">
            <div class="product-edit-mode-bar-copy">
                <span class="product-edit-mode-dot" aria-hidden="true"></span>
                <span>You are in edit mode.</span>
            </div>
        </div>
    </div>
}

@section Styles {
    <style>
        .free-download-edit-card,
        .free-download-add-card {
            min-height: 100%;
        }

        .free-download-image-upload {
            display: flex;
            justify-content: center;
        }

        .free-download-image-upload-inner {
            width: 100%;
            display: grid;
            justify-items: center;
            gap: 0.5rem;
        }

        .free-download-image-picker {
            width: min(100%, 13rem);
            aspect-ratio: 1;
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            border: 1.5px dashed #9eb5cf;
            border-radius: 0.85rem;
            background: #f7fafc;
            color: #33506f;
            font-weight: 700;
            transition: border-color 0.18s ease, background-color 0.18s ease, transform 0.18s ease;
        }

        .free-download-image-picker:hover,
        .free-download-image-picker:focus-visible {
            border-color: #005190;
            background: #eef6fd;
            outline: 0;
            transform: translateY(-1px);
        }

        .free-download-image-picker[disabled] {
            opacity: 0.62;
            cursor: not-allowed;
            transform: none;
        }

        .free-download-image-picker img {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .free-download-image-picker-copy {
            position: relative;
            z-index: 1;
            padding: 0.35rem 0.6rem;
            border-radius: 999px;
            background: rgba(255, 255, 255, 0.88);
            box-shadow: 0 8px 24px rgba(15, 23, 42, 0.08);
        }

        .free-download-file-upload {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 0.55rem;
        }

        .free-download-upload-status {
            min-height: 1.25rem;
            color: #68758f;
            font-size: 0.88rem;
        }

        .free-download-upload-status.is-error {
            color: #B23A48;
        }

        .free-download-upload-loading,
        .free-download-current-link {
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
        }

        .free-download-current-link {
            color: #33506f;
            font-size: 0.88rem;
            text-decoration: none;
        }

        .free-download-current-link:hover,
        .free-download-current-link:focus {
            color: #B23A48;
            text-decoration: underline;
            text-underline-offset: 0.2rem;
        }

        .free-download-upload-spinner {
            display: inline-block;
            width: 0.9rem;
            height: 0.9rem;
            border: 2px solid #c8d7ea;
            border-top-color: #005190;
            border-radius: 999px;
            animation: free-download-spin 0.8s linear infinite;
        }

        @@keyframes free-download-spin {
            to {
                transform: rotate(360deg);
            }
        }

        .free-download-add-card {
            width: 100%;
            height: 100%;
            min-height: 28rem;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 0.7rem;
            padding: 2rem;
            border: 1px dashed #b9c8dc;
            border-radius: 1rem;
            background: #f8fbff;
            color: #33506f;
            text-align: center;
            transition: border-color 0.18s ease, background-color 0.18s ease, transform 0.18s ease;
        }

        .free-download-add-card:hover,
        .free-download-add-card:focus-visible {
            border-color: #7fa0c8;
            background: #f2f7fd;
            outline: 0;
            transform: translateY(-1px);
        }

        .free-download-add-icon {
            width: 3rem;
            height: 3rem;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 999px;
            background: #ffffff;
            color: #005190;
            box-shadow: 0 10px 28px rgba(15, 23, 42, 0.08);
        }

        .free-download-add-title {
            color: #1b1e2f;
            font-weight: 800;
        }

        .free-download-add-copy {
            max-width: 14rem;
            color: #68758f;
            font-size: 0.92rem;
            line-height: 1.45;
        }

        .free-download-delete-button {
            width: 2.4rem;
            height: 2.4rem;
            padding: 0;
        }
    </style>
}

@section Scripts {
    @if (Model.IsAdminEditMode)
    {
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                const uploadsEnabled = document.getElementById("FreeDownloadUploadsEnabled")?.value === "true";
                const maxImageBytes = Number(document.getElementById("FreeDownloadMaxImageBytes")?.value || 0);
                const maxDownloadBytes = Number(document.getElementById("FreeDownloadMaxDownloadBytes")?.value || 0);

                function getToken(form) {
                    return form?.querySelector('input[name="__RequestVerificationToken"]')?.value
                        || document.querySelector('input[name="__RequestVerificationToken"]')?.value
                        || "";
                }

                function formatBytes(bytes) {
                    if (bytes >= 1024 * 1024) {
                        return `${Math.round(bytes / 1024 / 1024)} MB`;
                    }

                    return `${Math.round(bytes / 1024)} KB`;
                }

                const stagedFiles = new WeakMap();

                function getStagedFiles(form) {
                    if (!stagedFiles.has(form)) {
                        stagedFiles.set(form, {});
                    }

                    return stagedFiles.get(form);
                }

                function setStatus(form, kind, message, isError, isLoading) {
                    const status = form?.querySelector(`[data-upload-status="${kind}"]`);
                    if (!status) {
                        return;
                    }

                    if (isLoading) {
                        status.innerHTML = '<span class="free-download-upload-loading"><span class="free-download-upload-spinner" aria-hidden="true"></span><span>Verifying file...</span></span>';
                    } else {
                        status.textContent = message || "";
                    }

                    status.classList.toggle("is-error", !!isError);
                }

                async function verifyUpload(kind, file, form) {
                    const fd = new FormData();
                    fd.append("fileName", file.name);
                    fd.append("contentType", file.type || "");
                    fd.append("fileSize", String(file.size));

                    const token = getToken(form);
                    if (token) {
                        fd.append("__RequestVerificationToken", token);
                    }

                    const handler = kind === "image" ? "VerifyImageUpload" : "VerifyDownloadUpload";
                    const res = await fetch(`${window.location.pathname}?handler=${handler}`, {
                        method: "POST",
                        headers: token ? { "RequestVerificationToken": token } : {},
                        credentials: "same-origin",
                        body: fd
                    });

                    const json = await res.json().catch(function () { return null; });
                    if (!res.ok || !json?.success) {
                        throw new Error(json?.errorMessage || "File could not be verified.");
                    }

                    return json;
                }

                async function createUpload(kind, file, form) {
                    const fd = new FormData();
                    fd.append("id", form?.dataset.productId || "");
                    fd.append("fileName", file.name);
                    fd.append("contentType", file.type || "");
                    fd.append("fileSize", String(file.size));

                    const token = getToken(form);
                    if (token) {
                        fd.append("__RequestVerificationToken", token);
                    }

                    const handler = kind === "image" ? "CreateImageUpload" : "CreateDownloadUpload";
                    const res = await fetch(`${window.location.pathname}?handler=${handler}`, {
                        method: "POST",
                        headers: token ? { "RequestVerificationToken": token } : {},
                        credentials: "same-origin",
                        body: fd
                    });

                    const json = await res.json().catch(function () { return null; });
                    if (!res.ok || !json?.success) {
                        throw new Error(json?.errorMessage || "Upload could not be started.");
                    }

                    return json;
                }

                async function putFile(putUrl, file, cacheControl) {
                    const res = await fetch(putUrl, {
                        method: "PUT",
                        headers: {
                            "Content-Type": file.type || "application/octet-stream",
                            ...(cacheControl ? { "Cache-Control": cacheControl } : {})
                        },
                        body: file
                    });

                    if (!res.ok) {
                        throw new Error("Upload failed while sending the file.");
                    }
                }

                function setSaveBusy(form, isBusy) {
                    const button = document.querySelector(`[data-save-button][form="${form.id}"]`);
                    if (!button) {
                        return;
                    }

                    button.disabled = isBusy;
                    button.innerHTML = isBusy
                        ? '<span class="free-download-upload-spinner" aria-hidden="true"></span>Saving'
                        : `<i class="${button.dataset.saveIcon || "fa-solid fa-floppy-disk"}" aria-hidden="true"></i>${button.dataset.saveLabel || "Save"}`;
                }

                async function uploadStagedFile(form, kind, file) {
                    setStatus(form, kind, kind === "image" ? "Uploading image..." : "Uploading file...", false, false);

                    const upload = await createUpload(kind, file, form);
                    await putFile(upload.putUrl, file, upload.cacheControl || "");

                    const keyInput = form?.querySelector(`[data-upload-key="${kind}"]`);
                    if (keyInput) {
                        keyInput.value = upload.objectKey;
                    }

                    if (kind === "download" && upload.readUrl) {
                        let link = form?.querySelector("[data-current-download-link]");
                        if (!link) {
                            link = document.createElement("a");
                            link.className = "free-download-current-link";
                            link.target = "_blank";
                            link.rel = "noopener";
                            link.dataset.currentDownloadLink = "";
                            link.innerHTML = '<i class="fa-solid fa-download" aria-hidden="true"></i> Current download';
                            form?.querySelector(".free-download-file-upload")?.appendChild(link);
                        }

                        link.href = upload.readUrl;
                    }

                    setStatus(form, kind, "", false, false);
                }

                document.addEventListener("click", function (event) {
                    const trigger = event.target.closest("[data-upload-trigger]");
                    if (!trigger) {
                        return;
                    }

                    event.preventDefault();
                    const form = trigger.closest("form");
                    const kind = trigger.dataset.uploadTrigger;
                    const input = form?.querySelector(`[data-upload-input="${kind}"]`);

                    if (!uploadsEnabled) {
                        setStatus(form, kind, "Uploads are disabled in local development.", true, false);
                        return;
                    }

                    input?.click();
                });

                document.addEventListener("change", function (event) {
                    const input = event.target.closest("[data-upload-input]");
                    if (!input) {
                        return;
                    }

                    const file = input.files && input.files[0];
                    const kind = input.dataset.uploadInput;
                    const form = input.closest("form");
                    const maxBytes = kind === "image" ? maxImageBytes : maxDownloadBytes;

                    if (!file) {
                        return;
                    }

                    if (maxBytes > 0 && file.size > maxBytes) {
                        input.value = "";
                        setStatus(form, kind, `File is too large. Maximum size is ${formatBytes(maxBytes)}.`, true, false);
                        return;
                    }

                    (async function () {
                        const trigger = form?.querySelector(`[data-upload-trigger="${kind}"]`);
                        const label = form?.querySelector(`[data-upload-label="${kind}"]`);

                        try {
                            setStatus(form, kind, "", false, true);
                            if (trigger) {
                                trigger.disabled = true;
                            }

                            const verifiedFile = await verifyUpload(kind, file, form);
                            getStagedFiles(form)[kind] = file;

                            if (label) {
                                label.textContent = verifiedFile.fileName || file.name;
                            }

                            setStatus(form, kind, "", false, false);
                        } catch (error) {
                            input.value = "";
                            getStagedFiles(form)[kind] = null;
                            setStatus(form, kind, error?.message || "File could not be verified.", true, false);
                        } finally {
                            if (trigger) {
                                trigger.disabled = false;
                            }
                        }
                    })();
                });

                document.addEventListener("submit", function (event) {
                    const form = event.target.closest("form[data-product-id]");
                    if (!form) {
                        return;
                    }

                    event.preventDefault();

                    (async function () {
                        const titleInput = form.querySelector('input[name="EditInput.Name"]');
                        const title = titleInput?.value?.trim() || "";
                        const downloadKeyInput = form.querySelector('[data-upload-key="download"]');
                        const staged = getStagedFiles(form);

                        if (!title) {
                            titleInput?.focus();
                            setStatus(form, "download", "Give this download a title before saving.", true, false);
                            return;
                        }

                        if (!staged.download && !downloadKeyInput?.value?.trim()) {
                            setStatus(form, "download", "Choose a download file before saving.", true, false);
                            return;
                        }

                        if (!uploadsEnabled && (staged.image || staged.download)) {
                            setStatus(form, "download", "Uploads are disabled in local development.", true, false);
                            return;
                        }

                        try {
                            setSaveBusy(form, true);
                            setStatus(form, "download", "", false, false);

                            if (staged.image) {
                                await uploadStagedFile(form, "image", staged.image);
                                staged.image = null;
                            }

                            if (staged.download) {
                                await uploadStagedFile(form, "download", staged.download);
                                staged.download = null;
                            }

                            HTMLFormElement.prototype.submit.call(form);
                        } catch (error) {
                            setStatus(form, "download", `Save failed. ${error?.message || "Upload failed while saving."}`, true, false);
                            setSaveBusy(form, false);
                        }
                    })();
                });
            });
        </script>
    }
}
