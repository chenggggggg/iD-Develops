@page
@model iD_Develops.Pages.Portal.Admin.AuditLogModel
@{
    Layout = "_PortalLayout";
    ViewData["Title"] = "Audit log";
}

<section class="portal-page-shell space-y-6" data-audit-log>
    <header class="portal-page-header">
        <div>
            <p class="portal-eyebrow">SuperAdmin</p>
            <h1 class="portal-title-sm">Audit log</h1>
            <p class="portal-copy">Review important user, commercial, examination, access, and scheduling events.</p>
        </div>
    </header>

    <form method="get" class="space-y-4 rounded-xl border border-slate-200 bg-white p-4 shadow-sm" data-audit-filters>
        <div class="grid gap-3 md:grid-cols-2 xl:grid-cols-4">
            <label class="block md:col-span-2">
                <span class="mb-1.5 block text-sm font-medium text-slate-700">Search</span>
                <input asp-for="SearchQuery" name="q" class="block h-10 w-full rounded-lg border border-slate-300 bg-white px-3 text-sm text-slate-900 outline-none transition-colors focus:border-blue-500 focus:ring-2 focus:ring-blue-100 disabled:bg-slate-100 disabled:text-slate-500" placeholder="Event, user ID, or exact Stripe reference/email" />
            </label>
            <div class="block">
                <label for="Category" class="mb-1.5 block text-sm font-medium text-slate-700">Category</label>
                <select asp-for="Category" class="block h-10 w-full rounded-lg border border-slate-300 bg-white px-3 text-sm text-slate-900 outline-none transition-colors focus:border-blue-500 focus:ring-2 focus:ring-blue-100 disabled:bg-slate-100 disabled:text-slate-500">
                    <option value="">All categories</option>
                    @foreach (var category in Model.CategoryOptions)
                    {
                        <option value="@category">@category</option>
                    }
                </select>
            </div>
            <div class="block">
                <label for="Outcome" class="mb-1.5 block text-sm font-medium text-slate-700">Outcome</label>
                <select asp-for="Outcome" class="block h-10 w-full rounded-lg border border-slate-300 bg-white px-3 text-sm text-slate-900 outline-none transition-colors focus:border-blue-500 focus:ring-2 focus:ring-blue-100 disabled:bg-slate-100 disabled:text-slate-500">
                    <option value="">All outcomes</option>
                    @foreach (var outcome in Model.OutcomeOptions)
                    {
                        <option value="@outcome">@outcome</option>
                    }
                </select>
            </div>
        </div>
        <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-5 xl:items-end">
            <label class="block">
                <span class="mb-1.5 block text-sm font-medium text-slate-700">From date</span>
                <input asp-for="From" type="date" asp-format="{0:yyyy-MM-dd}" min="1900-01-01" max="9998-12-31" class="block h-10 w-full rounded-lg border border-slate-300 bg-white px-3 text-sm text-slate-900 outline-none transition-colors focus:border-blue-500 focus:ring-2 focus:ring-blue-100 disabled:bg-slate-100 disabled:text-slate-500" disabled="@Model.AllDates" data-audit-date />
            </label>
            <label class="block">
                <span class="mb-1.5 block text-sm font-medium text-slate-700">To date</span>
                <input asp-for="To" type="date" asp-format="{0:yyyy-MM-dd}" min="1900-01-01" max="9998-12-31" class="block h-10 w-full rounded-lg border border-slate-300 bg-white px-3 text-sm text-slate-900 outline-none transition-colors focus:border-blue-500 focus:ring-2 focus:ring-blue-100 disabled:bg-slate-100 disabled:text-slate-500" disabled="@Model.AllDates" data-audit-date />
            </label>
            <div class="block">
                <label for="PageSize" class="mb-1.5 block text-sm font-medium text-slate-700">Results per load</label>
                <select asp-for="PageSize" class="block h-10 w-full rounded-lg border border-slate-300 bg-white px-3 text-sm text-slate-900 outline-none transition-colors focus:border-blue-500 focus:ring-2 focus:ring-blue-100 disabled:bg-slate-100 disabled:text-slate-500">
                    @foreach (var size in Model.PageSizeOptions)
                    {
                        <option value="@size">@size events</option>
                    }
                </select>
            </div>
            <label class="inline-flex min-h-10 items-center gap-2 text-sm font-medium text-slate-700">
                <input asp-for="AllDates" class="h-4 w-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500" data-audit-all-dates />
                All dates
            </label>
            <div class="flex gap-2">
                <button type="submit" class="inline-flex min-h-10 flex-1 items-center justify-center gap-2 rounded-lg bg-slate-950 px-4 text-sm font-semibold text-white transition-colors hover:bg-slate-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500 disabled:cursor-wait disabled:opacity-60">
                    <span class="h-4 w-4 animate-spin rounded-full border-2 border-white/40 border-t-white motion-reduce:animate-none" data-audit-filter-spinner aria-hidden="true" hidden></span>
                    <span>Filter</span>
                </button>
                <a asp-page="/Portal/Admin/AuditLog" class="inline-flex min-h-10 items-center justify-center rounded-lg border border-slate-300 px-3 text-sm font-semibold text-slate-700 transition-colors hover:bg-slate-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500" aria-label="Clear filters">
                    <i class="fa-solid fa-rotate-left" aria-hidden="true"></i>
                </a>
            </div>
        </div>
        <p class="m-0 text-xs text-slate-500">Dates and times use Amsterdam (CET/CEST). Starts with today's events; select a date range or All dates to review older logs.</p>
        @if (!ViewData.ModelState.IsValid)
        {
            <div asp-validation-summary="All" role="alert" class="rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-800"></div>
        }
    </form>

    <div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
        <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-200 px-4 py-4">
            <div>
                <h2 class="m-0 text-lg font-semibold text-slate-950">Recorded events</h2>
                <p class="mb-0 mt-1 text-sm text-slate-500" role="status" data-audit-count>Showing @Model.Events.Count of @Model.TotalCount matching events.</p>
            </div>
            <div class="flex flex-wrap items-center gap-2 text-xs font-medium text-slate-600">
                <span>@Model.DateRangeLabel</span>
                <span class="rounded-full bg-slate-100 px-3 py-1">Newest first</span>
            </div>
        </div>
        @if (Model.Events.Count == 0)
        {
            <div class="px-5 py-14 text-center">
                <i class="fa-solid fa-clock-rotate-left text-3xl text-slate-300" aria-hidden="true"></i>
                <p class="mb-0 mt-3 font-medium text-slate-700">No audit events match these filters.</p>
                <p class="mb-0 mt-1 text-sm text-slate-500">Try another date range or clear your search.</p>
            </div>
        }
        else
        {
            <div class="hidden grid-cols-[10rem_7rem_minmax(0,1fr)_minmax(10rem,0.6fr)_1.25rem] gap-3 border-b border-slate-200 bg-slate-50 px-4 py-2 text-xs font-semibold uppercase tracking-wide text-slate-500 lg:grid">
                <span>Time (Amsterdam)</span>
                <span>Outcome</span>
                <span>Event</span>
                <span>Actor</span>
                <span class="sr-only">Expand</span>
            </div>
            <div class="divide-y divide-slate-100" data-audit-pages>
                <partial name="_AuditLogEntries" model="Model" />
            </div>
        }
        <p class="m-0 px-4 pb-4 text-sm text-red-700" data-audit-status role="status" hidden></p>
    </div>
</section>

@section Scripts {
    <script src="~/js/audit-log.js" asp-append-version="true" data-cookieconsent="ignore"></script>
}
