@page
@model iD_Develops.Pages.Portal.Profile.IndexModel
@{
    Layout = "_PortalLayout";
    ViewData["Title"] = "My Profile";
}

<section class="portal-page-shell">
    <div class="portal-card portal-card-lg">
        <p class="portal-eyebrow">My Profile</p>
        <h1 class="portal-title-sm">Under construction</h1>
        <p class="portal-copy portal-copy-spaced">
            This page is ready as a destination for the portal navigation, and you can fill in the actual profile experience next.
        </p>
        <a class="portal-btn portal-btn-outline" asp-page="/Portal/Home/Index">
            <i class="fa-solid fa-arrow-left-long" aria-hidden="true"></i>Back to home
        </a>
    </div>
</section>
