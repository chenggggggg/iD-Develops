@page
@model iD_Develops.Pages.Portal.Profile.IndexModel
@{
    Layout = "_PortalLayout";
    ViewData["Title"] = "My Profile";
}

<section class="portal-page-shell portal-data-page">
    <div class="portal-page-header">
        <div class="portal-page-header-copy">
            <p class="portal-eyebrow">My profile</p>
            <h1 class="portal-title-sm">@Model.DisplayName</h1>
            <p class="portal-copy">Your account overview, learning activity, and available booking credits.</p>
        </div>
        <a class="portal-btn portal-btn-outline" asp-page="/Portal/Settings/Index"><i class="fa-solid fa-gear" aria-hidden="true"></i>Account settings</a>
    </div>

    <div class="grid gap-4 lg:grid-cols-[minmax(0,1.4fr)_minmax(18rem,0.6fr)]">
        <div class="grid gap-4">
            <section class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
                <div class="flex flex-wrap items-center gap-4">
                    <span class="grid size-14 place-items-center rounded-full bg-[#eaf3fa] text-xl text-[#005190]" aria-hidden="true"><i class="fa-solid fa-user"></i></span>
                    <div class="min-w-0 flex-1"><h2 class="m-0 text-xl font-bold text-slate-950">@Model.DisplayName</h2><p class="mb-0 mt-1 text-sm text-slate-500">@Model.Email</p></div>
                    <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-700">@Model.Role</span>
                </div>
                <div class="mt-5 grid gap-3 sm:grid-cols-3">
                    <div class="rounded-lg bg-slate-50 p-4"><small class="block font-semibold uppercase tracking-wide text-slate-500">Courses</small><strong class="mt-1 block text-2xl text-slate-950">@Model.CourseCount</strong></div>
                    <div class="rounded-lg bg-slate-50 p-4"><small class="block font-semibold uppercase tracking-wide text-slate-500">Completed exams</small><strong class="mt-1 block text-2xl text-slate-950">@Model.CompletedExamCount</strong></div>
                    <div class="rounded-lg bg-slate-50 p-4"><small class="block font-semibold uppercase tracking-wide text-slate-500">Attended sessions</small><strong class="mt-1 block text-2xl text-slate-950">@Model.AttendedSessionCount</strong></div>
                </div>
            </section>

            <section class="rounded-xl border border-slate-200 bg-white shadow-sm">
                <div class="border-b border-slate-100 px-5 py-4"><h2 class="m-0 text-base font-semibold text-slate-900">Recent credit activity</h2><p class="mb-0 mt-1 text-sm text-slate-500">Your latest grants, reservations, returns, and uses.</p></div>
                @if (Model.RecentCreditActivity.Count == 0)
                {
                    <div class="px-5 py-8 text-sm text-slate-500">No credit activity yet.</div>
                }
                else
                {
                    <ul class="m-0 divide-y divide-slate-100 p-0">
                    @foreach (var activity in Model.RecentCreditActivity)
                    {
                        <li class="flex list-none items-center gap-3 px-5 py-3">
                            <span class="grid size-8 place-items-center rounded-full @(activity.QuantityDelta >= 0 ? "bg-emerald-50 text-emerald-700" : "bg-amber-50 text-amber-700")" aria-hidden="true"><i class="fa-solid @(activity.QuantityDelta >= 0 ? "fa-plus" : "fa-minus")"></i></span>
                            <span class="min-w-0 flex-1"><strong class="block text-sm text-slate-900">@activity.CreditType · @activity.TransactionType</strong><small class="block truncate text-slate-500">@(activity.Description ?? activity.CreatedAtUtc.ToString("dd MMM yyyy"))</small></span>
                            <strong class="text-sm @(activity.QuantityDelta >= 0 ? "text-emerald-700" : "text-amber-700")">@(activity.QuantityDelta > 0 ? "+" : "")@activity.QuantityDelta</strong>
                        </li>
                    }
                    </ul>
                }
            </section>
        </div>

        <aside class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
            <div class="flex items-start justify-between gap-3"><div><p class="portal-eyebrow">Available credits</p><h2 class="m-0 text-lg font-semibold text-slate-950">Booking balance</h2></div><span class="grid size-9 place-items-center rounded-lg bg-[#f7eff1] text-[#b23a48]" aria-hidden="true"><i class="fa-solid fa-coins"></i></span></div>
            @if (Model.CreditBalances.Count == 0)
            {
                <div class="my-5 rounded-lg border border-dashed border-slate-300 bg-slate-50 p-4 text-sm text-slate-600">You do not currently have any available credits.</div>
            }
            else
            {
                <div class="my-5 grid gap-3">
                @foreach (var balance in Model.CreditBalances)
                {
                    <div class="rounded-lg border border-slate-200 p-4"><small class="block font-semibold text-slate-500">@balance.Name</small><strong class="mt-1 block text-2xl text-slate-950">@balance.Quantity <span class="text-sm font-medium text-slate-500">@balance.UnitLabel</span></strong>@if (balance.NextExpiryUtc.HasValue){<small class="mt-2 block text-amber-700">Next expiry @balance.NextExpiryUtc.Value.ToString("dd MMM yyyy")</small>}</div>
                }
                </div>
            }
            <a class="portal-btn portal-btn-primary w-full justify-center" asp-page="/Products" asp-route-type="credit"><i class="fa-solid fa-plus" aria-hidden="true"></i>Add credits</a>
            <p class="mb-0 mt-4 text-xs leading-5 text-slate-500">Member since @Model.MemberSinceUtc.ToString("MMMM yyyy"). Level-test results will appear here once that feature is available.</p>
        </aside>
    </div>
</section>
