@page "/payment-result"
@model iD_Develops.Pages.PaymentResultModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<iD_Develops.Pages.PaymentResultModel> Localizer
@{
    ViewData["Title"] = Model.ResultTitle;
    var hasDetails = Model.SessionDetails.IsSessionValid || Model.IsLocalSuccess;
}

<section class="payment-result-page">
    <div class="payment-result-panel">
        <div class="payment-result-icon payment-result-@Model.ResultTone">
            <i class="fa-solid @Model.ResultIcon" aria-hidden="true"></i>
        </div>

        <p class="payment-result-kicker">@Localizer["PaymentLabel"]</p>
        <h1>@Model.ResultTitle</h1>
        <p class="payment-result-message">@Model.ResultMessage</p>

        @if (hasDetails)
        {
            <dl class="payment-result-details">
                <div>
                    <dt>@Localizer["ProductLabel"]</dt>
                    <dd>@Model.SessionDetails.ProductName</dd>
                </div>
                <div>
                    <dt>@Localizer["QuantityLabel"]</dt>
                    <dd>@Model.SessionDetails.Quantity</dd>
                </div>
                @if (Model.SessionDetails.AmountTotal > 0)
                {
                    <div>
                        <dt>@Localizer["AmountLabel"]</dt>
                        <dd>@Model.SessionDetails.AmountTotal.ToString("C")</dd>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(Model.SessionDetails.PaymentMethod))
                {
                    <div>
                        <dt>@Localizer["PaymentMethodLabel"]</dt>
                        <dd>@Model.SessionDetails.PaymentMethod</dd>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(Model.SessionDetails.DateOfPurchase))
                {
                    <div>
                        <dt>@Localizer["DateLabel"]</dt>
                        <dd>@Model.SessionDetails.DateOfPurchase</dd>
                    </div>
                }
            </dl>
        }

        @if (Model.IsLocalSuccess)
        {
            <div class="payment-result-note">
                @Localizer["LocalEnvironmentNote"]
            </div>
        }

        <div class="payment-result-actions">
            <a asp-page="/Pricing" asp-route-culture="@CultureInfo.CurrentCulture.Name.ToLowerInvariant()" class="public-btn public-btn-primary">
                @Localizer["PricingButton"] <i class="fa-solid fa-arrow-right ps-2" aria-hidden="true"></i>
            </a>
            <a asp-page="/Contact" asp-route-culture="@CultureInfo.CurrentCulture.Name.ToLowerInvariant()" class="public-btn public-btn-outline">
                @Localizer["ContactSupportButton"]
            </a>
        </div>
    </div>
</section>

<style>
    .payment-result-page {
        min-height: calc(100vh - 8rem);
        display: grid;
        place-items: center;
        padding: 4rem 1rem;
        background: linear-gradient(180deg, #f6f9fc 0%, #ffffff 100%);
    }

    .payment-result-panel {
        width: min(100%, 42rem);
        text-align: center;
        background: #ffffff;
        border: 1px solid #dfe7ef;
        border-radius: 1rem;
        box-shadow: 0 24px 70px rgba(15, 23, 42, 0.08);
        padding: clamp(1.5rem, 4vw, 3rem);
    }

    .payment-result-icon {
        width: 4.5rem;
        height: 4.5rem;
        display: inline-grid;
        place-items: center;
        border-radius: 50%;
        font-size: 2rem;
        margin-bottom: 1rem;
    }

    .payment-result-success {
        color: #0f7a4d;
        background: #e8f7ef;
    }

    .payment-result-warning {
        color: #9a5b00;
        background: #fff4d8;
    }

    .payment-result-danger {
        color: #a31d2a;
        background: #fde8eb;
    }

    .payment-result-secondary {
        color: #475569;
        background: #eef2f7;
    }

    .payment-result-kicker {
        margin: 0 0 0.35rem;
        color: #607086;
        font-size: 0.78rem;
        font-weight: 800;
        letter-spacing: 0;
        text-transform: uppercase;
    }

    .payment-result-panel h1 {
        margin: 0;
        color: #111827;
        font-weight: 800;
    }

    .payment-result-message {
        max-width: 34rem;
        margin: 0.8rem auto 0;
        color: #5d6b7c;
        line-height: 1.65;
    }

    .payment-result-details {
        display: grid;
        gap: 0.65rem;
        margin: 1.5rem 0 0;
        padding: 1rem;
        border: 1px solid #e5ebf2;
        border-radius: 0.8rem;
        background: #f9fbfd;
        text-align: left;
    }

    .payment-result-details div {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
    }

    .payment-result-details dt,
    .payment-result-details dd {
        margin: 0;
    }

    .payment-result-details dt {
        color: #68758f;
        font-size: 0.85rem;
        font-weight: 700;
    }

    .payment-result-details dd {
        color: #182232;
        font-weight: 700;
        text-align: right;
    }

    .payment-result-note {
        margin-top: 1rem;
        padding: 0.75rem 1rem;
        border-radius: 0.75rem;
        color: #30516f;
        background: #eef7ff;
        font-size: 0.9rem;
        font-weight: 700;
    }

    .payment-result-actions {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.75rem;
        margin-top: 1.5rem;
    }
</style>
