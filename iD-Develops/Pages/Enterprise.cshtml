@page
@model EnterpriseModel
@inject IStringLocalizer<EnterpriseModel> Localizer
@{
    ViewData["Title"] = Localizer["Title"];
    ViewData["SeoTitle"] = Localizer["SeoTitle"];
    ViewData["MetaDescription"] = Localizer["MetaDescription"];
    var matchDescription2 = Localizer["MatchDescription2"].Value;
}

<section class="public-hero-page">
    <div class="public-container">
        <div class="public-content-narrow">
            <p class="public-eyebrow public-eyebrow-left">@Localizer["HeroEyebrow"]</p>
            <h1 class="public-hero-title mx-0">@Localizer["HeroTitle"]</h1>
            <p class="public-hero-copy mx-0">@Localizer["HeroDescription"]</p>
            <div class="public-actions justify-start">
                <a href="https://koalendar.com/e/samenwerken" target="_blank" rel="noopener noreferrer" class="public-btn public-btn-primary">@Localizer["ScheduleConversation"] <i class="fas fa-arrow-right"></i></a>
                <a asp-page="/contact" asp-route-culture="@CultureInfo.CurrentCulture.Name.ToLowerInvariant()" class="public-btn public-btn-outline">@Localizer["ContactButton"] <i class="fas fa-arrow-right"></i></a>
            </div>
        </div>
    </div>
</section>

<section class="public-section public-section-soft">
    <div class="public-container">
        <div class="public-section-heading public-section-heading-center"><p class="public-eyebrow">@Localizer["ChallengesEyebrow"]</p></div>
        <div class="public-feature-grid xl:grid-cols-5">
            @for (var index = 1; index <= 5; index++)
            {
                <article class="public-feature-card"><p class="public-copy">@Localizer[$"Challenge{index}"]</p></article>
            }
        </div>
        <p class="public-copy mx-auto mt-10 max-w-3xl text-center">@Localizer["ChallengesConclusion"]</p>
    </div>
</section>

<section class="public-section">
    <div class="public-container">
        <div class="public-section-heading public-section-heading-center"><p class="public-eyebrow">@Localizer["ServicesEyebrow"]</p></div>
        <div class="public-icon-feature-grid">
            <article class="public-icon-feature-card"><i class="fa-solid fa-language"></i><div><div class="public-icon-feature-title">@Localizer["ServiceNt2Title"]</div><div class="public-icon-feature-description">@Localizer["ServiceNt2Description"]</div></div></article>
            <article class="public-icon-feature-card"><i class="fa-regular fa-comments"></i><div><div class="public-icon-feature-title">@Localizer["ServiceCommunicationTitle"]</div><div class="public-icon-feature-description">@Localizer["ServiceCommunicationDescription"]</div></div></article>
            <article class="public-icon-feature-card"><i class="fa-solid fa-people-group"></i><div><div class="public-icon-feature-title">@Localizer["ServiceDevelopmentTitle"]</div><div class="public-icon-feature-description">@Localizer["ServiceDevelopmentDescription"]</div></div></article>
            <article class="public-icon-feature-card"><i class="fa-solid fa-book-open"></i><div><div class="public-icon-feature-title">@Localizer["ServiceProgramsTitle"]</div><div class="public-icon-feature-description">@Localizer["ServiceProgramsDescription"]</div></div></article>
            <article class="public-icon-feature-card"><i class="fa-solid fa-chalkboard-user"></i><div><div class="public-icon-feature-title">@Localizer["ServiceTrainerTitle"]</div><div class="public-icon-feature-description">@Localizer["ServiceTrainerDescription"]</div></div></article>
        </div>
    </div>
</section>

<section class="public-section public-section-soft">
    <div class="public-container">
        <div class="public-editorial-cta">
            <img src="~/images/iddevelops-icon.png" alt="" aria-hidden="true" />
            <h2>@Localizer["MatchTitle"]</h2>
            <p class="public-copy">@Localizer["MatchDescription1"]</p>
            @if (!string.IsNullOrWhiteSpace(matchDescription2))
            {
                <p class="public-copy">@matchDescription2</p>
            }
            <a class="public-btn public-btn-primary" href="https://koalendar.com/e/samenwerken" target="_blank" rel="noopener noreferrer">@Localizer["MatchButton"] <i class="fas fa-arrow-right"></i></a>
        </div>
    </div>
</section>
