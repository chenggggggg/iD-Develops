@page
@model iD_Develops.Pages.LanguageAndCommunication.GoDutchModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<iD_Develops.Pages.LanguageAndCommunication.GoDutchModel> Localizer
@{
    ViewData["Title"] = Localizer["Title"];
}
<section class="public-page">
    <div class="public-container public-content-narrow">
        <p class="public-eyebrow public-eyebrow-left">@Localizer["Eyebrow"]</p>
        <h1 class="public-page-title">@Localizer["Heading"]</h1>
        <p class="public-copy">
        @Localizer["Paragraph1"]
        </p>
        <p class="public-copy">
        @Localizer["Paragraph2"]
        </p>
        <p class="public-copy">
        @Localizer["Paragraph3"]
        </p>
    </div>
</section>
