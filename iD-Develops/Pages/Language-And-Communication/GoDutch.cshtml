@page
@model iD_Develops.Pages.LanguageAndCommunication.GoDutchModel
@{
    ViewData["Title"] = "Language & Communication GoDutch!";
}
<section class="public-page">
    <div class="public-container public-content-narrow">
        <p class="public-eyebrow public-eyebrow-left">Language &amp; Communication</p>
        <h1 class="public-page-title">Go Dutch!</h1>
        <p class="public-copy">
        Interested in learning Dutch? But no time or interest to join group classes? 
        Study at your own pace? Master grammar, sentence patterns, pronunciation and culture (customs, idioms, etc.)  
        in our 10-week courses which you can complete at your own pace at home or wherever you like. 
        Of course we’re there to support you whenever you have questions and there is a voluntary speaking practice hour with fellow learners halfway. 
        </p>
        <p class="public-copy">
        It can either be a jump start for mingling with the Dutch or prepare you for the ‘inburgeringsexams’.
        </p>
        <p class="public-copy">
        Just contact us for more information! 
        </p>
    </div>
</section>
