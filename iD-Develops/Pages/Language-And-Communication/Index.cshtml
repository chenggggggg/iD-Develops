@page
@model iD_Develops.Pages.LanguageAndCommunication.IndexModel
@inject IStringLocalizer<iD_Develops.Pages.LanguageAndCommunication.IndexModel> Localizer
@{
    ViewData["Title"] = Localizer["Title"];
    ViewData["SeoTitle"] = Localizer["SeoTitle"];
    ViewData["MetaDescription"] = Localizer["MetaDescription"];
}

<section class="public-hero-page">
    <div class="public-container">
        <div class="public-content-narrow">
            <p class="public-eyebrow public-eyebrow-left">@Localizer["Title"]</p>
            <h1 class="public-hero-title mx-0">@Localizer["HeroTitle"]</h1>
            <p class="public-hero-copy mx-0">@Localizer["HeroParagraph1"]</p>
            <p class="public-hero-copy mx-0">@Localizer["HeroParagraph2"]</p>
            <div class="public-actions justify-start">
                <a href="https://koalendar.com/e/meet-with-id" target="_blank" rel="noopener noreferrer" class="public-btn public-btn-primary">@Localizer["ConversationButton"] <i class="fas fa-arrow-right"></i></a>
                <a asp-page="/contact" asp-route-culture="@CultureInfo.CurrentCulture.Name.ToLowerInvariant()" class="public-btn public-btn-outline">@Localizer["ContactButton"] <i class="fas fa-arrow-right"></i></a>
            </div>
        </div>
    </div>
</section>

<section class="public-section">
    <div class="public-container">
        <div class="public-section-heading public-section-heading-center"><p class="public-eyebrow">@Localizer["ServicesEyebrow"]</p></div>
        <div class="public-icon-feature-grid">
            <article class="public-icon-feature-card"><i class="fa-solid fa-language"></i><div><div class="public-icon-feature-title">@Localizer["ServiceEnglishTitle"]</div><div class="public-icon-feature-description">@Localizer["ServiceEnglishDescription"]</div></div></article>
            <article class="public-icon-feature-card"><i class="fa-solid fa-globe"></i><div><div class="public-icon-feature-title">@Localizer["ServiceInterculturalTitle"]</div><div class="public-icon-feature-description">@Localizer["ServiceInterculturalDescription"]</div></div></article>
            <article class="public-icon-feature-card"><i class="fa-regular fa-comments"></i><div><div class="public-icon-feature-title">@Localizer["ServiceSpeakingTitle"]</div><div class="public-icon-feature-description">@Localizer["ServiceSpeakingDescription"]</div></div></article>
            <article class="public-icon-feature-card"><i class="fa-regular fa-pen-to-square"></i><div><div class="public-icon-feature-title">@Localizer["ServiceWritingTitle"]</div><div class="public-icon-feature-description">@Localizer["ServiceWritingDescription"]</div></div></article>
            <article class="public-icon-feature-card"><i class="fa-solid fa-file-pen"></i><div><div class="public-icon-feature-title">@Localizer["ServiceOutsourceTitle"]</div><div class="public-icon-feature-description">@Localizer["ServiceOutsourceDescription"]</div></div></article>
        </div>
    </div>
</section>

<section class="public-section public-section-soft">
    <div class="public-container">
        <div class="public-two-column">
            <div><p class="public-eyebrow public-eyebrow-left">@Localizer["AudienceEyebrow"]</p><h2 class="public-section-title">@Localizer["AudienceTitle"]</h2></div>
            <div><p class="public-copy">@Localizer["AudienceParagraph1"]</p><p class="public-copy">@Localizer["AudienceParagraph2"]</p><p class="public-copy">@Localizer["AudienceParagraph3"]</p></div>
        </div>
        <div class="public-actions">
            <a href="https://koalendar.com/e/meet-with-id" target="_blank" rel="noopener noreferrer" class="public-btn public-btn-primary">@Localizer["ConversationButton"] <i class="fas fa-arrow-right"></i></a>
            <a asp-page="/contact" asp-route-culture="@CultureInfo.CurrentCulture.Name.ToLowerInvariant()" class="public-btn public-btn-outline">@Localizer["ContactButton"] <i class="fas fa-arrow-right"></i></a>
        </div>
    </div>
</section>
