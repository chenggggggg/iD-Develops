@page
@model iD_Develops.Pages.LanguageAndCommunication.IndexModel
@using System.Globalization
@{
    var isDutch = CultureInfo.CurrentCulture.Name.Equals("nl-NL", StringComparison.OrdinalIgnoreCase);
    ViewData["Title"] = isDutch ? "Taal & Communicatie" : "Language & Communication";
    ViewData["SeoTitle"] = isDutch ? null : "Business English & Communication Skills Training | iD!";
    ViewData["MetaDescription"] = isDutch ? null : "Practical business English and communication skills training: present with confidence, write clearly, and communicate across cultures.";
}

<section class="public-hero-page"><div class="public-container"><div class="public-content-narrow">
    <p class="public-eyebrow public-eyebrow-left">@(isDutch ? "Taal & Communicatie" : "Language & Communication")</p>
    <h1 class="public-hero-title tw:mx-0">@(isDutch ? "Wát je zegt is belangrijk, maar hóe je het zegt bepaalt of je gehoord wordt" : "What you say matters, but how you say it determines whether you're being heard")</h1>
    <p class="public-hero-copy tw:mx-0">@(isDutch ? "Je kunt de beste ideeën hebben en de beste bedoelingen: als je boodschap niet aankomt, blijft het daarbij. Gelukkig is communiceren geen aangeboren talent, maar een vaardigheid. En vaardigheden zijn te leren." : "You can have the best ideas and the best intentions in the world, but if your message doesn't land, that's where it stops. Luckily, communication is not an inborn talent but a skill. And skills can be learned.")</p>
    <p class="public-hero-copy tw:mx-0">@(isDutch ? "Bij iD! helpen we je scherper, overtuigender en prettiger te communiceren. In het Nederlands, Engels, non-verbaal, of intercultureel." : "At iD!, we're happy to help you communicate more clearly, more convincingly, and more comfortably. In Dutch, English, non-verbal communication, or across cultures.")</p>
    <div class="public-actions tw:justify-start"><a href="https://koalendar.com/e/meet-with-id" target="_blank" rel="noopener noreferrer" class="public-btn public-btn-primary">@(isDutch ? "Plan een gesprek" : "Book a conversation") <i class="fas fa-arrow-right"></i></a><a asp-page="/contact" class="public-btn public-btn-outline">@(isDutch ? "Contactformulier" : "Contact form") <i class="fas fa-arrow-right"></i></a></div>
</div></div></section>

<section class="public-section"><div class="public-container"><div class="public-section-heading public-section-heading-center"><p class="public-eyebrow">@(isDutch ? "Waar we je mee helpen" : "What we can help you with")</p></div><div class="public-icon-feature-grid"><article class="public-icon-feature-card"><i class="fa-solid fa-language"></i><div><div class="public-icon-feature-title">@(isDutch ? "(Zakelijk) Engels" : "(Business) English")</div><div class="public-icon-feature-description">@(isDutch ? "Van een professionelere e-mail tot een presentatie zonder zoeken naar woorden. Praktisch en direct toepasbaar." : "From writing a more professional email to giving a presentation without searching for words. Practical, relevant, and immediately useful.")</div></div></article><article class="public-icon-feature-card"><i class="fa-solid fa-globe"></i><div><div class="public-icon-feature-title">@(isDutch ? "Interculturele communicatie" : "Intercultural communication")</div><div class="public-icon-feature-description">@(isDutch ? "Wat in het ene land beleefd is, is ergens anders vaag of onbeleefd. We helpen je de codes lezen." : "What is polite in one country can come across as vague or even rude somewhere else. We help you read the codes — and respond in a way that works.")</div></div></article><article class="public-icon-feature-card"><i class="fa-regular fa-comments"></i><div><div class="public-icon-feature-title">@(isDutch ? "Gespreksvaardigheid & presenteren" : "Conversation skills & presenting")</div><div class="public-icon-feature-description">@(isDutch ? "Helder je punt maken, ook onder spanning. Een presentatie geven waar mensen wél naar luisteren." : "Making your point clearly, even under pressure. Giving a presentation that people really listen to.")</div></div></article><article class="public-icon-feature-card"><i class="fa-regular fa-pen-to-square"></i><div><div class="public-icon-feature-title">@(isDutch ? "Schrijfvaardigheid" : "Writing skills")</div><div class="public-icon-feature-description">@(isDutch ? "To-the-point schrijven dat gelezen wordt, niet tekst die vooral lang is." : "Writing clearly and to the point: text that gets read, not text that is just long.")</div></div></article><article class="public-icon-feature-card"><i class="fa-solid fa-file-pen"></i><div><div class="public-icon-feature-title">@(isDutch ? "Tekstwerk uitbesteden" : "Outsource your writing")</div><div class="public-icon-feature-description">@(isDutch ? "Liever geen tijd besteden aan zelf (leren) schrijven? Wij redigeren of schrijven het voor je." : "Would you rather not spend time writing — or learning how to write — yourself? We can edit your text or write it for you.")</div></div></article></div></div></section>

<section class="public-section public-section-soft"><div class="public-container"><div class="public-two-column"><div><p class="public-eyebrow public-eyebrow-left">@(isDutch ? "Voor wie" : "Who this is for")</p><h2 class="public-section-title">@(isDutch ? "Zekerder communiceren" : "Communicate with more confidence")</h2></div><div><p class="public-copy">@(isDutch ? "Voor iedereen die zich zekerder wil voelen in het Nederlands of Engels, en professionals die willen groeien in hoe ze overkomen." : "For anyone who wants to feel more confident communicating in Dutch or English, and for professionals who want to grow in the way they come across.")</p><p class="public-copy">@(isDutch ? "Alles is maatwerk; de prijs bepalen we na een oriënterend gesprek." : "Everything is tailor-made, and pricing is agreed after an introductory conversation.")</p><p class="public-copy">@(isDutch ? "Gaat je vraag dieper dan de vaardigheid zelf? Zoals waaróm is het spannend om je mening te geven? Kijk dan bij Persoonlijke Ontwikkeling. Soms zit het ‘hoe’ vast aan een ‘wie’." : "Does your question go deeper than the skill itself? For example: why is it so exciting to give your opinion? Then take a look at Personal Development. Sometimes the \"how\" is connected to the \"who\".")</p></div></div><div class="public-actions"><a href="https://koalendar.com/e/meet-with-id" target="_blank" rel="noopener noreferrer" class="public-btn public-btn-primary">@(isDutch ? "Plan een gesprek" : "Book a conversation") <i class="fas fa-arrow-right"></i></a><a asp-page="/contact" class="public-btn public-btn-outline">@(isDutch ? "Contactformulier" : "Contact form") <i class="fas fa-arrow-right"></i></a></div></div></section>
