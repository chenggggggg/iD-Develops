@page
@model iD_Develops.Pages.SuccessModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<iD_Develops.Pages.SuccessModel> Localizer
@{
    ViewData["Title"] = Localizer["Title"];
}

<div class="mx-auto max-w-3xl px-4 py-16 text-center">
    <h1 class="text-2xl font-bold text-[#10224d]">@Localizer["Heading"]</h1>
    <p class="mt-2 text-[#667085]">@Localizer["Message"]</p>
</div>
