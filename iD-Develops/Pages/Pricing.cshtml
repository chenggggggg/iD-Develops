@page
@model iD_Develops.Pages.PricingModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<iD_Develops.Pages.ProductsModel> Localizer
@{
    ViewData["Title"] = Localizer["PricingTitle"];
    ViewData["MetaDescription"] = Localizer["PricingMetaDescription"];
}

<section class="public-page">
    <div class="public-container">
        <div class="public-section-header">
            <p class="public-eyebrow">@Localizer["PricingEyebrow"]</p>
            <h1 class="public-page-title">@Localizer["PricingHeading"]</h1>
            <p class="public-muted">@Localizer["PricingIntroduction"]</p>
        </div>

        @if (Model.Products.Count == 0)
        {
            <div class="public-empty-state">
                @Localizer["NoProducts"]
            </div>
        }
        else
        {
            <div class="public-catalog-grid">
                @foreach (var product in Model.Products)
                {
                    <article class="public-catalog-card">
                        @if (!string.IsNullOrWhiteSpace(product.ImageUrl))
                        {
                            <img src="@product.ImageUrl" class="product-card-image" alt="@product.Name" />
                        }
                        <div class="public-catalog-body">
                            <div class="public-catalog-label">@Localizer[$"ProductType_{product.ProductType}"]</div>
                            <h2 class="public-catalog-title">@product.Name</h2>
                            <p class="public-catalog-summary">@product.Summary</p>

                            <div class="public-catalog-footer">
                                <strong>@(product.DisplayPrice.HasValue ? product.DisplayPrice.Value.ToString("C") : Localizer["CustomPrice"])</strong>
                                <a class="public-btn public-btn-outline" asp-page="/Product" asp-route-culture="@CultureInfo.CurrentCulture.Name.ToLowerInvariant()" asp-route-slug="@product.Slug">
                                    @Localizer["ViewDetails"] <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
                                </a>
                            </div>
                        </div>
                    </article>
                }
            </div>
        }
    </div>
</section>
