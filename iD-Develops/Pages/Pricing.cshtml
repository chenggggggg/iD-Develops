@page
@model iD_Develops.Pages.PricingModel
@{
    ViewData["Title"] = "Pricing";
}

<section class="public-page">
    <div class="public-container">
        <div class="public-section-header">
            <p class="public-eyebrow">Pricing</p>
            <h1 class="public-page-title">Pricing & Courses</h1>
            <p class="public-muted">Choose the course, booking, or guided learning option that fits your next step.</p>
        </div>

        @if (Model.Products.Count == 0)
        {
            <div class="public-empty-state">
                No pricing options are published yet.
            </div>
        }
        else
        {
            <div class="public-catalog-grid">
                @foreach (var product in Model.Products)
                {
                    <article class="public-catalog-card">
                        @if (!string.IsNullOrWhiteSpace(product.ImageUrl))
                        {
                            <img src="@product.ImageUrl" class="product-card-image" alt="@product.Name" />
                        }
                        <div class="public-catalog-body">
                            <div class="public-catalog-label">@product.ProductType</div>
                            <h2 class="public-catalog-title">@product.Name</h2>
                            <p class="public-catalog-summary">@product.Summary</p>

                            <div class="public-catalog-footer">
                                <strong>@(product.DisplayPrice.HasValue ? product.DisplayPrice.Value.ToString("C") : "Custom")</strong>
                                <a class="public-btn public-btn-outline" asp-page="/Product" asp-route-slug="@product.Slug">
                                    View <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
                                </a>
                            </div>
                        </div>
                    </article>
                }
            </div>
        }
    </div>
</section>
