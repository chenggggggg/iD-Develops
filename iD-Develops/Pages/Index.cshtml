                        <p class="m-0 text-xs font-medium uppercase tracking-[0.18em] text-[#B23A48]" data-approach-stage-number></p>
                        <h3 class="mt-4 mb-0 text-[clamp(1.6rem,3vw,2.5rem)] font-medium leading-[1.1] text-[#071F3D] [font-family:var(--serif-heading)]" data-approach-stage-title></h3>
                        <p class="mt-6 mb-0 max-w-[38rem] text-[1.05rem] leading-[1.75] text-[#535353]" data-approach-stage-description></p>
                    </div>
                    <ol class="m-0 grid list-none gap-16 p-0 md:gap-24" data-approach-features>
                <li class="relative flex flex-col gap-4 md:flex-row md:gap-16" data-approach-feature data-approach-index="0">
                    <div class="flex h-min shrink-0 items-center gap-3 md:w-64"><span class="grid size-8 flex-none place-items-center rounded-full bg-[#B23A48]/[0.07] text-xs text-[#B23A48]"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i></span><span class="text-[0.7rem] font-medium uppercase tracking-[0.18em] leading-snug text-[#071F3D] [font-family:var(--serif-label)]">@Localizer["ApproachStep1ShortTitle"]</span></div>
                    <div class="flex flex-col">
                        <h3 class="m-0 text-[1.05rem] font-bold leading-[1.3] text-[#071F3D]">@Localizer["ApproachStep1Title"]</h3>
                        <p class="mt-[0.55rem] mb-0 max-w-[42rem] leading-[1.65] text-[#535353]">@Localizer["ApproachStep1Description"]</p>
                    </div>
                </li>
                <li class="relative flex flex-col gap-4 md:flex-row md:gap-16" data-approach-feature data-approach-index="1">
                    <div class="flex h-min shrink-0 items-center gap-3 md:w-64"><span class="grid size-8 flex-none place-items-center rounded-full bg-[#B23A48]/[0.07] text-xs text-[#B23A48]"><i class="fa-solid fa-puzzle-piece" aria-hidden="true"></i></span><span class="text-[0.7rem] font-medium uppercase tracking-[0.18em] leading-snug text-[#071F3D] [font-family:var(--serif-label)]">@Localizer["ApproachStep2ShortTitle"]</span></div>
                    <div class="flex flex-col">
                        <h3 class="m-0 text-[1.05rem] font-bold leading-[1.3] text-[#071F3D]">@Localizer["ApproachStep2Title"]</h3>
                        <p class="mt-[0.55rem] mb-0 max-w-[42rem] leading-[1.65] text-[#535353]">@Localizer["ApproachStep2Description"]</p>
                    </div>
                </li>
                <li class="relative flex flex-col gap-4 md:flex-row md:gap-16" data-approach-feature data-approach-index="2">
                    <div class="flex h-min shrink-0 items-center gap-3 md:w-64"><span class="grid size-8 flex-none place-items-center rounded-full bg-[#B23A48]/[0.07] text-xs text-[#B23A48]"><i class="fa-solid fa-arrow-trend-up" aria-hidden="true"></i></span><span class="text-[0.7rem] font-medium uppercase tracking-[0.18em] leading-snug text-[#071F3D] [font-family:var(--serif-label)]">@Localizer["ApproachStep3ShortTitle"]</span></div>
                    <div class="flex flex-col">
                        <h3 class="m-0 text-[1.05rem] font-bold leading-[1.3] text-[#071F3D]">@Localizer["ApproachStep3Title"]</h3>
                        <p class="mt-[0.55rem] mb-0 max-w-[42rem] leading-[1.65] text-[#535353]">@Localizer["ApproachStep3Description"]</p>
                    </div>
