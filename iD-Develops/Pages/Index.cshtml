                <span aria-hidden="true" class="absolute inset-0 -z-20 bg-[url('/images/nt2-integration.webp')] bg-cover bg-center transition-transform duration-300 group-hover:scale-[1.045]"></span>
                <span class="flex w-full max-w-[34rem] flex-col items-start justify-end p-[clamp(1.5rem,4vw,2.5rem)] pb-[calc(clamp(1.5rem,4vw,2.5rem)-0.25rem)]">
                    <i class="fa-solid fa-language mb-0 block origin-left text-[2.15rem] leading-[0.9] text-[#535353] transition-transform duration-300 group-hover:scale-[0.86]" aria-hidden="true"></i>
                    <h3 class="mb-[0.38rem] mt-[0.68rem] text-[clamp(1.15rem,1.35vw,1.3rem)] leading-[1.15] text-[#071F3D] [font-family:var(--serif-heading)]">@(isDutch ? "NT2 / Inburgeren" : "NT2 / Integration")</h3>
                    <span class="max-w-[31rem] text-base leading-[1.6] text-[#535353]">@(isDutch ? "Nederlands leren — van eerste woorden tot inburgering en BIG-registratie." : "Learn Dutch — from your first words to integration and BIG registration.")</span>
                    <a class="mt-[0.85rem] inline-flex max-h-11 items-center gap-2 overflow-hidden rounded-full bg-transparent px-[0.8rem] py-2 text-sm font-bold leading-[1.3] text-[#B23A48] no-underline opacity-100 transition-all duration-300 translate-y-0 hover:bg-[#B23A48]/10 hover:no-underline focus-visible:bg-[#B23A48]/10 focus-visible:no-underline lg:mt-0 lg:max-h-0 lg:py-0 lg:opacity-0 lg:translate-y-[0.45rem] lg:group-hover:mt-[0.85rem] lg:group-hover:max-h-11 lg:group-hover:py-2 lg:group-hover:opacity-100 lg:group-hover:translate-y-0" asp-page="/nt2-integration">@(isDutch ? "Lees meer" : "Learn more") <i class="fas fa-arrow-right transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true"></i></a>
                </span>
            </article>
            <article class="group relative isolate flex min-h-[22rem] overflow-hidden rounded-2xl border border-[#E8E4DF] bg-[#FBF3F1] text-[#1A1A1A] shadow-[0_14px_40px_rgba(17,17,17,0.05)] transition-[border-color,box-shadow] duration-200 hover:border-[#B23A48]/45 hover:shadow-[0_24px_52px_rgba(17,17,17,0.10)] lg:row-span-2 lg:min-h-0">
                <span aria-hidden="true" class="absolute inset-0 -z-10 bg-[linear-gradient(90deg,rgba(255,255,255,0.98)_0%,rgba(255,255,255,0.9)_45%,rgba(255,255,255,0.2)_100%)] lg:bg-[linear-gradient(0deg,rgba(255,255,255,0.98)_0%,rgba(255,255,255,0.86)_38%,rgba(255,255,255,0.28)_72%,rgba(255,255,255,0)_100%)]"></span>
                <span aria-hidden="true" class="absolute inset-0 -z-20 bg-[url('/images/personal-development.webp')] bg-cover bg-center transition-transform duration-300 group-hover:scale-[1.045]"></span>
                <span class="flex w-full max-w-[34rem] flex-col items-start justify-end p-[clamp(1.5rem,4vw,2.5rem)] pb-[calc(clamp(1.5rem,4vw,2.5rem)-0.25rem)] lg:max-w-none">
                    <i class="fa-solid fa-compass mb-0 block origin-left text-[2.15rem] leading-[0.9] text-[#535353] transition-transform duration-300 group-hover:scale-[0.86]" aria-hidden="true"></i>
                    <h3 class="mb-[0.38rem] mt-[0.68rem] text-[clamp(1.15rem,1.35vw,1.3rem)] leading-[1.15] text-[#071F3D] [font-family:var(--serif-heading)]">@(isDutch ? "Persoonlijke Ontwikkeling" : "Personal Development")</h3>
                    <span class="max-w-[31rem] text-base leading-[1.6] text-[#535353]">@(isDutch ? "Vind richting bij werk, relaties of een grote verandering." : "Find direction in work, relationships, or a major change.")</span>
                    <a class="mt-[0.85rem] inline-flex max-h-11 items-center gap-2 overflow-hidden rounded-full bg-transparent px-[0.8rem] py-2 text-sm font-bold leading-[1.3] text-[#B23A48] no-underline opacity-100 transition-all duration-300 translate-y-0 hover:bg-[#B23A48]/10 hover:no-underline focus-visible:bg-[#B23A48]/10 focus-visible:no-underline lg:mt-0 lg:max-h-0 lg:py-0 lg:opacity-0 lg:translate-y-[0.45rem] lg:group-hover:mt-[0.85rem] lg:group-hover:max-h-11 lg:group-hover:py-2 lg:group-hover:opacity-100 lg:group-hover:translate-y-0" asp-page="/personal-development">@(isDutch ? "Lees meer" : "Learn more") <i class="fas fa-arrow-right transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true"></i></a>
                </span>
            </article>
            <article class="group relative isolate flex min-h-[22rem] overflow-hidden rounded-2xl border border-[#E8E4DF] bg-[#F5F2EC] text-[#1A1A1A] shadow-[0_14px_40px_rgba(17,17,17,0.05)] transition-[border-color,box-shadow] duration-200 hover:border-[#B23A48]/45 hover:shadow-[0_24px_52px_rgba(17,17,17,0.10)] lg:min-h-0">
                <span aria-hidden="true" class="absolute inset-0 -z-10 bg-[linear-gradient(90deg,rgba(255,255,255,0.98)_0%,rgba(255,255,255,0.9)_45%,rgba(255,255,255,0.2)_100%)] lg:bg-[linear-gradient(0deg,rgba(255,255,255,0.98)_0%,rgba(255,255,255,0.86)_38%,rgba(255,255,255,0.28)_72%,rgba(255,255,255,0)_100%)]"></span>
                <span aria-hidden="true" class="absolute inset-0 -z-20 bg-[url('/images/language-communication.webp')] bg-cover bg-center transition-transform duration-300 group-hover:scale-[1.045]"></span>
                <span class="flex w-full max-w-[34rem] flex-col items-start justify-end p-[clamp(1.5rem,4vw,2.5rem)] pb-[calc(clamp(1.5rem,4vw,2.5rem)-0.25rem)] lg:max-w-none">
                    <i class="fa-solid fa-comments mb-0 block origin-left text-[2.15rem] leading-[0.9] text-[#535353] transition-transform duration-300 group-hover:scale-[0.86]" aria-hidden="true"></i>
                    <h3 class="mb-[0.38rem] mt-[0.68rem] text-[clamp(1.15rem,1.35vw,1.3rem)] leading-[1.15] text-[#071F3D] [font-family:var(--serif-heading)]">@(isDutch ? "Taal & Communicatie" : "Language & Communication")</h3>
                    <span class="max-w-[31rem] text-base leading-[1.6] text-[#535353]">@(isDutch ? "Zeg wat je bedoelt — en zorg dat het aankomt." : "Say what you mean — and make sure it lands.")</span>
                    <a class="mt-[0.85rem] inline-flex max-h-11 items-center gap-2 overflow-hidden rounded-full bg-transparent px-[0.8rem] py-2 text-sm font-bold leading-[1.3] text-[#B23A48] no-underline opacity-100 transition-all duration-300 translate-y-0 hover:bg-[#B23A48]/10 hover:no-underline focus-visible:bg-[#B23A48]/10 focus-visible:no-underline lg:mt-0 lg:max-h-0 lg:py-0 lg:opacity-0 lg:translate-y-[0.45rem] lg:group-hover:mt-[0.85rem] lg:group-hover:max-h-11 lg:group-hover:py-2 lg:group-hover:opacity-100 lg:group-hover:translate-y-0" asp-page="/Language-And-Communication/Index">@(isDutch ? "Lees meer" : "Learn more") <i class="fas fa-arrow-right transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true"></i></a>
                </span>
            </article>
            <article class="group relative isolate flex min-h-[22rem] overflow-hidden rounded-2xl border border-[#E8E4DF] bg-[#EEF4F8] text-[#1A1A1A] shadow-[0_14px_40px_rgba(17,17,17,0.05)] transition-[border-color,box-shadow] duration-200 hover:border-[#B23A48]/45 hover:shadow-[0_24px_52px_rgba(17,17,17,0.10)] lg:col-span-2 lg:min-h-0">
                <span aria-hidden="true" class="absolute inset-0 -z-10 bg-[linear-gradient(90deg,rgba(255,255,255,0.98)_0%,rgba(255,255,255,0.9)_45%,rgba(255,255,255,0.2)_100%)] lg:bg-[linear-gradient(0deg,rgba(255,255,255,0.98)_0%,rgba(255,255,255,0.88)_32%,rgba(255,255,255,0.34)_60%,rgba(255,255,255,0)_86%),linear-gradient(90deg,rgba(255,255,255,0.72)_0%,rgba(255,255,255,0)_58%)]"></span>
                <span aria-hidden="true" class="absolute inset-0 -z-20 bg-[url('/images/training-development-for-organizations.webp')] bg-cover bg-center transition-transform duration-300 group-hover:scale-[1.045]"></span>
                <span class="flex w-full max-w-[34rem] flex-col items-start justify-end p-[clamp(1.5rem,4vw,2.5rem)] pb-[calc(clamp(1.5rem,4vw,2.5rem)-0.25rem)]">
                    <i class="fa-solid fa-people-group mb-0 block origin-left text-[2.15rem] leading-[0.9] text-[#535353] transition-transform duration-300 group-hover:scale-[0.86]" aria-hidden="true"></i>
                    <h3 class="mb-[0.38rem] mt-[0.68rem] text-[clamp(1.15rem,1.35vw,1.3rem)] leading-[1.15] text-[#071F3D] [font-family:var(--serif-heading)]">@(isDutch ? "Voor Organisaties" : "For Organizations")</h3>
                    <span class="max-w-[31rem] text-base leading-[1.6] text-[#535353]">@(isDutch ? "Laat je team groeien met taaltraining en communicatie." : "Help your team grow through language and communication.")</span>
