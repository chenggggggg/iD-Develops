<section class="tw:bg-[#FAFAF8] tw:py-24 tw:text-[#1A1A1A] tw:md:py-36">
    <div class="public-container">
        <div class="tw:w-full">
            <header class="tw:mb-14 tw:text-center tw:opacity-0 tw:translate-y-6 tw:transition-[opacity,translate] tw:duration-1000 tw:ease-out" data-reveal>
                <p class="public-eyebrow tw:my-0">@(isDutch ? "Onze werkwijze" : "The iD! approach")</p>
                <h2 class="tw:mx-auto tw:mt-5 tw:mb-5 tw:w-full tw:text-[clamp(2rem,5vw,3.6rem)] tw:font-medium tw:leading-tight tw:text-[#071F3D] tw:[font-family:var(--serif-heading)]">@(isDutch ? "Wat je van ons kunt verwachten" : "What you can expect from us")</h2>
                <p class="tw:mx-auto tw:m-0 tw:max-w-[42rem] tw:text-[1.05rem] tw:leading-[1.7] tw:text-[#535353]">@(isDutch ? "En geen coach die boven je staat. Bij iD! werk je op gelijkwaardig niveau, niet met iemand die het beter weet." : "And no coach standing above you. At iD! you work on equal footing, not with someone who claims to know better.")</p>
            </header>

            <div class="tw:mx-auto tw:mt-16 tw:max-w-3xl tw:space-y-16 tw:opacity-0 tw:translate-y-6 tw:transition-[opacity,translate] tw:duration-1000 tw:ease-out tw:md:mt-24 tw:md:space-y-24" data-reveal>
