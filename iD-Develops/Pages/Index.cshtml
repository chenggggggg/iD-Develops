                <span class="tw:flex tw:w-full tw:max-w-[34rem] tw:flex-col tw:items-start tw:justify-end tw:p-[clamp(1.5rem,4vw,2.5rem)] tw:pb-[calc(clamp(1.5rem,4vw,2.5rem)-0.25rem)] tw:lg:max-w-none">
