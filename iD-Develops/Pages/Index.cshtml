                <a class="public-btn public-btn-light border-[#B23A48] bg-[#B23A48] text-white shadow-[0_10px_24px_rgba(159,47,61,0.18)] hover:border-[#C84E5F] hover:bg-[#C84E5F] hover:text-white hover:shadow-[0_14px_30px_rgba(159,47,61,0.24)] focus:border-[#C84E5F] focus:bg-[#C84E5F] focus:text-white focus:shadow-[0_14px_30px_rgba(159,47,61,0.24)]" href="@levelTestUrl">@(isDutch ? "Doe de gratis niveautest" : "Take the free level test") <i class="fas fa-arrow-right"></i></a>
                <a asp-page="/contact" class="public-btn public-btn-outline-light border-white/60 bg-white/[0.04] text-white/90 hover:border-white/90 hover:bg-white/[0.12] hover:text-white focus:border-white/90 focus:bg-white/[0.12] focus:text-white">@(isDutch ? "Stuur een bericht" : "Get in touch") <i class="fas fa-arrow-right"></i></a>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/js/home-team-carousel.js" asp-append-version="true"></script>
}
