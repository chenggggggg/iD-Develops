@page
@model IndexModel
@using System.Globalization
@inject IStringLocalizer<IndexModel> Localizer
@{
    var levelTestUrl = $"/{CultureInfo.CurrentCulture.Name.ToLowerInvariant()}/level-test";
    var routeCulture = CultureInfo.CurrentCulture.Name.ToLowerInvariant();
    ViewData["Title"] = Localizer["Title"];
    ViewData["SeoTitle"] = Localizer["SeoTitle"];
    ViewData["MetaDescription"] = Localizer["MetaDescription"];
    ViewData["BodyClass"] = "home-page";
    var showExpandedLearningOptions = bool.TryParse(Localizer["ShowExpandedLearningOptions"], out var showExpanded) && showExpanded;
}

<section class="home-hero">
    <div class="public-container relative z-10 flex w-full items-center py-16 opacity-0 translate-y-6 transition-[opacity,translate] duration-1000 ease-out md:py-20" data-reveal="load">
        <div class="max-w-[46rem]">
            <p class="mb-6 text-xs font-medium uppercase tracking-[0.2em] text-white/75 [font-family:var(--serif-label)]">iD! Training &amp; Development</p>
            <h1 class="mb-7 text-[clamp(3.2rem,7vw,6.5rem)] font-medium leading-[0.92] tracking-[-0.045em] text-white [font-family:var(--serif-heading)]"><span class="lg:whitespace-nowrap">@Localizer["HeroTitleLine1"]</span><br /><em class="font-normal text-[#F4C8CD] lg:whitespace-nowrap">@Localizer["HeroTitleLine2"]</em></h1>
            <p class="home-hero-subtitle"><span>@Localizer["HeroSubtitleLine1"]</span><span>@Localizer["HeroSubtitleLine2"]</span></p>
            <div class="flex flex-col items-start gap-3 sm:flex-row sm:items-center sm:gap-4">
                <a href="@levelTestUrl" class="public-btn public-btn-primary min-h-12 border-[#B23A48] bg-[#B23A48] px-6 text-white shadow-[0_10px_28px_rgba(0,0,0,0.22)] hover:border-[#C84E5F] hover:bg-[#C84E5F] hover:text-white focus:border-[#C84E5F] focus:bg-[#C84E5F] focus:text-white">@Localizer["HeroLevelTestButton"] <i class="fas fa-arrow-right" aria-hidden="true"></i></a>
                <a asp-page="/contact" asp-route-culture="@routeCulture" class="public-btn public-btn-outline-light min-h-12 border-white/65 bg-black/10 px-6 text-white backdrop-blur-sm hover:border-white hover:bg-white hover:text-[#071F3D] focus:border-white focus:bg-white focus:text-[#071F3D]">@Localizer["HeroContactButton"] <i class="fas fa-arrow-right" aria-hidden="true"></i></a>
            </div>
            @* Provisional figures — replace with owner-confirmed numbers before launch. *@
            <ul class="mt-10 flex list-none flex-wrap items-start gap-x-7 gap-y-4 p-0 text-white/85 sm:mt-12 gap-x-9">
                <li class="flex flex-col gap-0.5"><strong class="text-2xl font-medium leading-none text-white [font-family:var(--serif-heading)]">2,000+</strong><span class="text-[0.68rem] uppercase tracking-[0.12em] [font-family:var(--serif-label)]">@Localizer["LearnersSupported"]</span></li>
                <li class="flex flex-col gap-0.5"><strong class="text-2xl font-medium leading-none text-white [font-family:var(--serif-heading)]">15+</strong><span class="text-[0.68rem] uppercase tracking-[0.12em] [font-family:var(--serif-label)]">@Localizer["YearsExperience"]</span></li>
                <li class="flex flex-col gap-0.5"><strong class="text-2xl font-medium leading-none text-white [font-family:var(--serif-heading)]">4.9/5</strong><span class="text-[0.68rem] uppercase tracking-[0.12em] [font-family:var(--serif-label)]">@Localizer["AverageRating"]</span></li>
            </ul>
        </div>
    </div>
</section>

