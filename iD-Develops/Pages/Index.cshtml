            <article class="group relative isolate flex min-h-[22rem] overflow-hidden rounded-2xl border border-[#E8E4DF] bg-[#EDF7F8] text-[#1A1A1A] shadow-[0_14px_40px_rgba(17,17,17,0.05)] transition-[border-color,box-shadow] duration-200 hover:border-[#B23A48]/45 hover:shadow-[0_24px_52px_rgba(17,17,17,0.10)] lg:col-span-2 lg:row-span-2 lg:min-h-0">
