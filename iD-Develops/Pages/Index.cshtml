@page
@model IndexModel
@using System.Globalization
@{
    var isDutch = CultureInfo.CurrentCulture.Name.Equals("nl-NL", StringComparison.OrdinalIgnoreCase);
    var levelTestUrl = $"/{CultureInfo.CurrentCulture.Name.ToLowerInvariant()}/level-test";
    ViewData["Title"] = isDutch ? "Home" : "Home";
    ViewData["SeoTitle"] = isDutch ? null : "iD! Training & Development | Language, Communication & Growth";
    ViewData["MetaDescription"] = isDutch ? null : "Learn Dutch, sharpen your communication, or grow into who you want to be. iD! guides individuals and teams with expertise, honesty, and humour.";
    ViewData["BodyClass"] = "home-page";
}

<section class="home-hero">
    <div class="public-container tw:relative tw:z-10 tw:flex tw:w-full tw:items-center tw:py-16 tw:opacity-0 tw:translate-y-6 tw:transition-[opacity,translate] tw:duration-1000 tw:ease-out tw:md:py-20" data-reveal="load">
        <div class="tw:max-w-[46rem]">
            <p class="tw:mb-6 tw:text-xs tw:font-medium tw:uppercase tw:tracking-[0.2em] tw:text-white/75 tw:[font-family:var(--serif-label)]">iD! Training &amp; Development</p>
            @if (isDutch)
            {
                <h1 class="tw:mb-7 tw:text-[clamp(3.2rem,7vw,6.5rem)] tw:font-medium tw:leading-[0.92] tw:tracking-[-0.045em] tw:text-white tw:[font-family:var(--serif-heading)]"><span class="tw:lg:whitespace-nowrap">Vind je stem.</span><br /><em class="tw:font-normal tw:text-[#F4C8CD] tw:lg:whitespace-nowrap">Vind je richting.</em></h1>
                <p class="home-hero-subtitle"><span>Leer de taal. Zeg wat je bedoelt.</span><span>Ga met vertrouwen verder.</span></p>
            }
            else
            {
                <h1 class="tw:mb-7 tw:text-[clamp(3.2rem,7vw,6.5rem)] tw:font-medium tw:leading-[0.92] tw:tracking-[-0.045em] tw:text-white tw:[font-family:var(--serif-heading)]"><span class="tw:lg:whitespace-nowrap">Find your voice.</span><br /><em class="tw:font-normal tw:text-[#F4C8CD] tw:lg:whitespace-nowrap">Find your direction.</em></h1>
                <p class="home-hero-subtitle"><span>Learn the language. Say what you mean.</span><span>Move forward with confidence.</span></p>
            }
            <div class="tw:flex tw:flex-col tw:items-start tw:gap-3 tw:sm:flex-row tw:sm:items-center tw:sm:gap-4">
                <a href="@levelTestUrl" class="public-btn public-btn-primary tw:min-h-12 tw:border-[#B23A48] tw:bg-[#B23A48] tw:px-6 tw:text-white tw:shadow-[0_10px_28px_rgba(0,0,0,0.22)] tw:hover:border-[#C84E5F] tw:hover:bg-[#C84E5F] tw:hover:text-white tw:focus:border-[#C84E5F] tw:focus:bg-[#C84E5F] tw:focus:text-white">@(isDutch ? "Test je niveau" : "Test your level") <i class="fas fa-arrow-right" aria-hidden="true"></i></a>
                <a asp-page="/contact" class="public-btn public-btn-outline-light tw:min-h-12 tw:border-white/65 tw:bg-black/10 tw:px-6 tw:text-white tw:backdrop-blur-sm tw:hover:border-white tw:hover:bg-white tw:hover:text-[#071F3D] tw:focus:border-white tw:focus:bg-white tw:focus:text-[#071F3D]">@(isDutch ? "Neem contact op" : "Contact us") <i class="fas fa-arrow-right" aria-hidden="true"></i></a>
            </div>
            @* Provisional figures — replace with owner-confirmed numbers before launch. *@
            <ul class="tw:mt-10 tw:flex tw:list-none tw:flex-wrap tw:items-start tw:gap-x-7 tw:gap-y-4 tw:p-0 tw:text-white/85 tw:sm:mt-12 tw:gap-x-9">
                <li class="tw:flex tw:flex-col tw:gap-0.5"><strong class="tw:text-2xl tw:font-medium tw:leading-none tw:text-white tw:[font-family:var(--serif-heading)]">2,000+</strong><span class="tw:text-[0.68rem] tw:uppercase tw:tracking-[0.12em] tw:[font-family:var(--serif-label)]">@(isDutch ? "Cursisten begeleid" : "Learners supported")</span></li>
                <li class="tw:flex tw:flex-col tw:gap-0.5"><strong class="tw:text-2xl tw:font-medium tw:leading-none tw:text-white tw:[font-family:var(--serif-heading)]">15+</strong><span class="tw:text-[0.68rem] tw:uppercase tw:tracking-[0.12em] tw:[font-family:var(--serif-label)]">@(isDutch ? "Jaar ervaring" : "Years of experience")</span></li>
                <li class="tw:flex tw:flex-col tw:gap-0.5"><strong class="tw:text-2xl tw:font-medium tw:leading-none tw:text-white tw:[font-family:var(--serif-heading)]">4.9/5</strong><span class="tw:text-[0.68rem] tw:uppercase tw:tracking-[0.12em] tw:[font-family:var(--serif-label)]">@(isDutch ? "Gemiddelde beoordeling" : "Average rating")</span></li>
            </ul>
        </div>
    </div>
</section>

