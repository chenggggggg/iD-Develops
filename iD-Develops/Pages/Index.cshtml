<section class="bg-[#FAFAF8] py-24 text-[#1A1A1A] md:py-36">
    <div class="public-container">
        <div class="w-full">
            <header class="mb-14 text-center opacity-0 translate-y-6 transition-[opacity,translate] duration-1000 ease-out" data-reveal>
                <p class="public-eyebrow my-0">@Localizer["ApproachEyebrow"]</p>
                <h2 class="mx-auto mt-5 mb-5 w-full text-[clamp(2rem,5vw,3.6rem)] font-medium leading-tight text-[#071F3D] [font-family:var(--serif-heading)]">@Localizer["ApproachTitle"]</h2>
                <p class="mx-auto m-0 max-w-[42rem] text-[1.05rem] leading-[1.7] text-[#535353]">@Localizer["ApproachIntro"]</p>
