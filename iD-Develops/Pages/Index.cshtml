@page
@model IndexModel
@using System.Globalization
@{
    var isDutch = CultureInfo.CurrentCulture.Name.Equals("nl-NL", StringComparison.OrdinalIgnoreCase);
    var levelTestUrl = $"/{CultureInfo.CurrentCulture.Name.ToLowerInvariant()}/level-test";
    ViewData["Title"] = isDutch ? "Home" : "Home";
    ViewData["SeoTitle"] = isDutch ? null : "iD! Training & Development | Language, Communication & Growth";
    ViewData["MetaDescription"] = isDutch ? null : "Learn Dutch, sharpen your communication, or grow into who you want to be. iD! guides individuals and teams with expertise, honesty, and humour.";
    ViewData["BodyClass"] = "home-page";
}

<section class="home-hero">
    <div class="public-container relative z-10 flex w-full items-center py-16 opacity-0 translate-y-6 transition-[opacity,translate] duration-1000 ease-out md:py-20" data-reveal="load">
        <div class="max-w-[46rem]">
            <p class="mb-6 text-xs font-medium uppercase tracking-[0.2em] text-white/75 [font-family:var(--serif-label)]">iD! Training &amp; Development</p>
            @if (isDutch)
            {
                <h1 class="mb-7 text-[clamp(3.2rem,7vw,6.5rem)] font-medium leading-[0.92] tracking-[-0.045em] text-white [font-family:var(--serif-heading)]"><span class="lg:whitespace-nowrap">Vind je stem.</span><br /><em class="font-normal text-[#F4C8CD] lg:whitespace-nowrap">Vind je richting.</em></h1>
                <p class="home-hero-subtitle"><span>Leer de taal. Zeg wat je bedoelt.</span><span>Ga met vertrouwen verder.</span></p>
            }
            else
            {
                <h1 class="mb-7 text-[clamp(3.2rem,7vw,6.5rem)] font-medium leading-[0.92] tracking-[-0.045em] text-white [font-family:var(--serif-heading)]"><span class="lg:whitespace-nowrap">Find your voice.</span><br /><em class="font-normal text-[#F4C8CD] lg:whitespace-nowrap">Find your direction.</em></h1>
                <p class="home-hero-subtitle"><span>Learn the language. Say what you mean.</span><span>Move forward with confidence.</span></p>
            }
            <div class="flex flex-col items-start gap-3 sm:flex-row sm:items-center sm:gap-4">
                <a href="@levelTestUrl" class="public-btn public-btn-primary min-h-12 border-[#B23A48] bg-[#B23A48] px-6 text-white shadow-[0_10px_28px_rgba(0,0,0,0.22)] hover:border-[#C84E5F] hover:bg-[#C84E5F] hover:text-white focus:border-[#C84E5F] focus:bg-[#C84E5F] focus:text-white">@(isDutch ? "Test je niveau" : "Test your level") <i class="fas fa-arrow-right" aria-hidden="true"></i></a>
                <a asp-page="/contact" class="public-btn public-btn-outline-light min-h-12 border-white/65 bg-black/10 px-6 text-white backdrop-blur-sm hover:border-white hover:bg-white hover:text-[#071F3D] focus:border-white focus:bg-white focus:text-[#071F3D]">@(isDutch ? "Neem contact op" : "Contact us") <i class="fas fa-arrow-right" aria-hidden="true"></i></a>
            </div>
            @* Provisional figures — replace with owner-confirmed numbers before launch. *@
            <ul class="mt-10 flex list-none flex-wrap items-start gap-x-7 gap-y-4 p-0 text-white/85 sm:mt-12 gap-x-9">
                <li class="flex flex-col gap-0.5"><strong class="text-2xl font-medium leading-none text-white [font-family:var(--serif-heading)]">2,000+</strong><span class="text-[0.68rem] uppercase tracking-[0.12em] [font-family:var(--serif-label)]">@(isDutch ? "Cursisten begeleid" : "Learners supported")</span></li>
                <li class="flex flex-col gap-0.5"><strong class="text-2xl font-medium leading-none text-white [font-family:var(--serif-heading)]">15+</strong><span class="text-[0.68rem] uppercase tracking-[0.12em] [font-family:var(--serif-label)]">@(isDutch ? "Jaar ervaring" : "Years of experience")</span></li>
                <li class="flex flex-col gap-0.5"><strong class="text-2xl font-medium leading-none text-white [font-family:var(--serif-heading)]">4.9/5</strong><span class="text-[0.68rem] uppercase tracking-[0.12em] [font-family:var(--serif-label)]">@(isDutch ? "Gemiddelde beoordeling" : "Average rating")</span></li>
            </ul>
        </div>
    </div>
</section>

<section class="bg-[#FAFAF8] py-24 text-[#1A1A1A] md:py-36" id="home-services">
    <div class="public-container">
        <div class="mx-auto mb-14 max-w-3xl text-center opacity-0 translate-y-6 transition-[opacity,translate] duration-1000 ease-out" data-reveal>
            <p class="public-eyebrow my-0">@(isDutch ? "Diensten" : "What we do")</p>
            <h2 class="mx-0 mt-5 mb-0 text-[clamp(2rem,5vw,3.6rem)] leading-tight text-[#071F3D] [font-family:var(--serif-heading)]">@(isDutch ? "Waar kunnen we je mee helpen?" : "What do you need right now?")</h2>
