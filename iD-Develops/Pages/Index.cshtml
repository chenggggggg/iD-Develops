                <p class="public-eyebrow public-eyebrow-left my-0">@Localizer["ApproachWhyEyebrow"]</p>
                <p class="mt-5 mb-5 max-w-[42rem] leading-7 text-[#535353]">@Localizer["ApproachWhyParagraph1"]</p>
                <p class="m-0 max-w-[42rem] leading-7 text-[#535353]">@Localizer["ApproachWhyParagraph2"]</p>
