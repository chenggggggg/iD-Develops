@page
@model AboutModel
@inject IStringLocalizer<AboutModel> Localizer
@{
    ViewData["Title"] = Localizer["Title"];
    ViewData["SeoTitle"] = Localizer["SeoTitle"];
    ViewData["MetaDescription"] = Localizer["MetaDescription"];
    var originParagraph3 = Localizer["OriginParagraph3"].Value;
}

<section class="public-hero-page">
    <div class="public-container">
        <div class="public-hero-grid">
            <div>
                <p class="public-eyebrow public-eyebrow-left">@Localizer["Title"]</p>
                <h1 class="public-hero-title mx-0">@Localizer["HeroTitle"]</h1>
                <p class="public-hero-copy mx-0">@Localizer["HeroDescription"]</p>
            </div>
            <div><img class="public-about-image" src="~/images/aboutus.png" alt="@Localizer["HeroImageAlt"]" /></div>
        </div>
    </div>
</section>

<section class="public-section">
    <div class="public-container public-content-narrow mx-auto">
        <p class="public-eyebrow public-eyebrow-left">@Localizer["OriginEyebrow"]</p>
        <p class="public-copy">@Localizer["OriginParagraph1"]</p>
        <p class="public-copy">@Localizer["OriginParagraph2"]</p>
        @if (!string.IsNullOrWhiteSpace(originParagraph3))
        {
            <p class="public-copy">@originParagraph3</p>
        }
    </div>
</section>

<section class="public-section public-section-soft">
    <div class="public-container">
        <div class="public-two-column">
            <div>
                <p class="public-eyebrow public-eyebrow-left">@Localizer["TogetherEyebrow"]</p>
                <h2 class="public-section-title">@Localizer["TogetherTitle"]</h2>
            </div>
            <p class="public-copy">@Localizer["TogetherDescription"]</p>
        </div>
    </div>
</section>

<section class="public-section">
    <div class="public-container public-content-narrow mx-auto">
        <p class="public-eyebrow public-eyebrow-left">@Localizer["ValuesEyebrow"]</p>
        <p class="public-copy">@Localizer["ValuesParagraph1"]</p>
        <p class="public-copy">@Localizer["ValuesParagraph2"]</p>
        <div class="public-actions justify-start">
            <a href="https://koalendar.com/e/meet-with-id" target="_blank" rel="noopener noreferrer" class="public-btn public-btn-primary">@Localizer["ScheduleConversation"] <i class="fas fa-arrow-right"></i></a>
            <a asp-page="/contact" asp-route-culture="@CultureInfo.CurrentCulture.Name.ToLowerInvariant()" class="public-btn public-btn-outline">@Localizer["ContactButton"] <i class="fas fa-arrow-right"></i></a>
        </div>
    </div>
</section>
