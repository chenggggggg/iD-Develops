@using iD_Develops.Models
@using iD_Develops.Utilities
@model iD_Develops.Pages.Shared.Examination.ExaminationHeaderModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<iD_Develops.Pages.Shared.Examination.ExaminationHeaderModel> Localizer

@{
    var returnCourseId = ViewData["ReturnCourseId"] as int?;
    var durationSeconds = Model.DurationSeconds.GetValueOrDefault();
    var durationHours = durationSeconds / 3600;
    var durationMinutes = (durationSeconds % 3600) / 60;
    var durationRemainingSeconds = durationSeconds % 60;
    var durationDisplay = Model.ShowTimer ? ExamDuration.Format(durationSeconds) : string.Empty;
    var examTitle = !string.IsNullOrWhiteSpace(Model.ExamTitle) ? Model.ExamTitle : Localizer["UntitledExam"].Value;
    var examTitleInputSize = Math.Clamp(examTitle.Length, 1, 60);
    var deadlineUtc = Model.EndDateTime.HasValue
        ? DateTime.SpecifyKind(Model.EndDateTime.Value, DateTimeKind.Utc).ToString("O", System.Globalization.CultureInfo.InvariantCulture)
        : null;
}

<header>
    <nav class="exam-header">
        <div class="exam-header-inner">
            <div class="exam-header-row">

                <!-- Left: Timer -->
                <div class="exam-header-group">
                    @if (Model.Mode == PaginationMode.Editing)
                    {
                        <a class="exam-header-back"
                           asp-page="@(returnCourseId.HasValue ? "/Portal/Courses/Course" : "/Portal/Exams/List")"
                           asp-route-courseId="@returnCourseId"
                           asp-route-edit="@(returnCourseId.HasValue ? true : null)"
                           aria-label="@(returnCourseId.HasValue ? Localizer["BackCourseEditorLabel"] : Localizer["BackExamsLabel"])">
                            <i class="fa-solid fa-chevron-left" aria-hidden="true"></i>
                        </a>
                    }
                    <div class="exam-header-stack">
                        <small class="exam-header-label">@Localizer["TimerLabel"]</small>

                        @if (Model.Mode == PaginationMode.Exam && Model.ShowTimer)
                        {
                            <div class="exam-header-value" id="countdown" data-duration="@deadlineUtc">
                                --:--:--
                            </div>
                        }
                        else if (Model.Mode == PaginationMode.Editing)
                        {
                            <div class="exam-header-value exam-header-inline-edit"
                                 data-exam-header-edit="timeLimit"
                                 data-exam-id="@Model.ExamId"
                                 data-exam-header-saved-value="@durationDisplay">
                                <span class="exam-header-inline-display" data-exam-header-display>
                                    @(Model.ShowTimer ? durationDisplay : Localizer["NoTimeLimit"])
                                </span>
                                <span class="exam-header-time-editor"
                                      data-exam-time-editor
                                      role="group"
                                      aria-label="@Localizer["TimeLimitLabel"]">
                                    <input class="exam-header-time-part"
                                           type="number"
                                           min="0"
                                           max="99999"
                                           step="1"
                                           inputmode="numeric"
                                           placeholder="hh"
                                           value="@(Model.ShowTimer ? durationHours.ToString("00") : null)"
                                           data-exam-time-part="hours"
                                           aria-label="@Localizer["TimeLimitHoursLabel"]" />
                                    <span class="exam-header-time-separator" aria-hidden="true">:</span>
                                    <input class="exam-header-time-part"
                                           type="number"
                                           min="0"
                                           max="59"
                                           step="1"
                                           inputmode="numeric"
                                           placeholder="mm"
                                           value="@(Model.ShowTimer ? durationMinutes.ToString("00") : null)"
                                           data-exam-time-part="minutes"
                                           aria-label="@Localizer["TimeLimitMinutesLabel"]" />
                                    <span class="exam-header-time-separator" aria-hidden="true">:</span>
                                    <input class="exam-header-time-part"
                                           type="number"
                                           min="0"
                                           max="59"
                                           step="1"
                                           inputmode="numeric"
                                           placeholder="ss"
                                           value="@(Model.ShowTimer ? durationRemainingSeconds.ToString("00") : null)"
                                           data-exam-time-part="seconds"
                                           aria-label="@Localizer["TimeLimitSecondsLabel"]" />
                                </span>
                                <i class="fa-solid fa-pencil exam-header-edit-icon" aria-hidden="true"></i>
                            </div>
                        }
                        else if (Model.Mode == PaginationMode.Start && Model.ShowTimer)
                        {
                            <div class="exam-header-value">@durationDisplay</div>
                        }
                        else
                        {
                            <div class="exam-header-value">@Localizer["NoTimeLimit"]</div>
                        }
                    </div>
                </div>

                <!-- Middle: Status (only in Editing mode) -->
                @if (Model.Mode == PaginationMode.Editing)
                {
                    <div class="exam-header-status">
                        <small class="exam-header-label">@Localizer["StatusLabel"]</small>
                        <div class="exam-header-value exam-header-status-value">
                            <span id="editorSaveStatus">@Localizer["UpToDateStatus"]</span>
                            <button type="button"
                                    id="editorSaveRetry"
                                    class="exam-icon-button exam-save-retry"
                                    title=""
                                    disabled
                                    aria-label="@Localizer["RetrySaveLabel"]">
                                <i id="editorSaveIcon" class="fa-solid fa-check exam-save-icon"></i>
                            </button>
                        </div>
                    </div>
                }
                else
                {
                    <!-- Keeps spacing balanced when status is not shown -->
                    <div class="exam-header-spacer"></div>
                }

                <!-- Right: Exam + Course -->
                <div class="exam-header-title-block">
                    @if (Model.Mode == PaginationMode.Editing)
                    {
                        <small class="exam-header-label exam-header-name-edit"
                               data-exam-header-edit="name"
                               data-exam-id="@Model.ExamId"
                               data-exam-header-saved-value="@examTitle">
                            <input class="exam-header-name-input"
                                   type="text"
                                   value="@examTitle"
                                   size="@examTitleInputSize"
                                   readonly
                                   data-exam-header-input
                                   aria-label="@Localizer["ExamNameLabel"]" />
                            <i class="fa-solid fa-pencil exam-header-edit-icon" aria-hidden="true"></i>
                        </small>
                    }
                    else
                    {
                        <small class="exam-header-label">@(!string.IsNullOrWhiteSpace(Model.ExamTitle) ? Model.ExamTitle : "-")</small>
                    }

                    <div class="exam-header-value" id="editorCourseName">
                        @(!string.IsNullOrWhiteSpace(Model.CourseName) ? Model.CourseName : "-")
                    </div>
                </div>

                <!-- Far-right: Settings gear (only in Editing mode) -->
                @if (Model.Mode == PaginationMode.Editing)
                {
                    <div class="exam-header-settings">
                        <a class="exam-icon-button"
                           asp-page="/Portal/Examination/Settings"
                           asp-route-examId="@Model.ExamId"
                           asp-route-returnCourseId="@returnCourseId"
                           aria-label="@Localizer["ExamSettingsLabel"]"
                           title="@Localizer["ExamSettingsLabel"]">
                            <i class="fa-solid fa-gear"></i>
                        </a>
                    </div>
                }

            </div>
        </div>

    </nav>

</header>



