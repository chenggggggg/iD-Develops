@using iD_Develops.Models
@model OpenAnswerField
<fieldset class="min-w-0 rounded-xl border border-slate-200 bg-slate-50 p-4 sm:p-5" data-open-field data-open-key="@Model.Key" disabled>
    <legend class="px-1 text-sm font-semibold text-[var(--id-ink)]" data-open-field-caption>Answer input</legend>
    <p class="mb-3 text-sm font-semibold text-[var(--id-blue)]" data-open-group-maximum></p>
    <div class="mb-4 flex flex-wrap justify-end gap-2">
        <button type="button" class="inline-flex min-h-11 min-w-11 items-center justify-center gap-2 rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm font-semibold text-[var(--id-blue)] transition-colors hover:bg-slate-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--id-blue)] disabled:cursor-not-allowed disabled:opacity-40" data-open-action="move-up" aria-label="Move answer input up" disabled><i class="fa-solid fa-arrow-up" aria-hidden="true"></i></button>
        <button type="button" class="inline-flex min-h-11 min-w-11 items-center justify-center gap-2 rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm font-semibold text-[var(--id-blue)] transition-colors hover:bg-slate-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--id-blue)] disabled:cursor-not-allowed disabled:opacity-40" data-open-action="move-down" aria-label="Move answer input down" disabled><i class="fa-solid fa-arrow-down" aria-hidden="true"></i></button>
        <button type="button" class="inline-flex min-h-11 min-w-11 items-center justify-center gap-2 rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm font-semibold text-[var(--id-blue)] transition-colors hover:bg-slate-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--id-blue)] disabled:cursor-not-allowed disabled:opacity-40" data-open-action="remove-field" disabled>Remove input</button>
    </div>
    <label class="block text-sm font-medium text-slate-700">
        Input label <span class="font-normal text-slate-500">(optional)</span>
        <input type="text" value="@Model.Label" maxlength="500" placeholder="For example: First missing word" class="mt-1 min-h-11 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-base text-[var(--id-ink)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--id-blue)]" data-open-label />
    </label>
    <div class="mt-4 space-y-3" data-open-alternatives>
        @foreach (var answer in Model.AcceptedAnswers)
        {
            <partial name="/Pages/Shared/Examination/Questions/_OpenAcceptedAnswer.Edit.cshtml" model="answer" />
        }
    </div>
    <button type="button" class="mt-3 inline-flex min-h-11 min-w-11 items-center justify-center gap-2 rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm font-semibold text-[var(--id-blue)] transition-colors hover:bg-slate-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--id-blue)] disabled:cursor-not-allowed disabled:opacity-40" data-open-action="add-alternative" disabled><i class="fa-solid fa-plus" aria-hidden="true"></i>Add accepted answer</button>
</fieldset>
