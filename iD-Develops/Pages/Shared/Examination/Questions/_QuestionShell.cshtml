@using iD_Develops.Pages.Shared.Examination.Questions
@model QuestionShellModel

<div class="question-shell" id="question-shell"
     data-question-id="@(Model.Question?.Id ?? 0)"
     data-question-kind="@(Model.Question?.GetType().Name)"
     data-is-draft="@(Model.Question == null ? "true" : "false")">
    @if (Model.Mode == QuestionRenderMode.Edit)
    {
        @if (Model.Question == null)
        {
            <div class="question-shell-empty-wrap">
                <div class="question-shell-empty">
                    <h4>No questions yet</h4>
                    <p>Select a question type to add your first question.</p>

                    <div class="question-type-actions">
                        <!-- These should do the same as the + button: open modal -->
                        <button type="button" class="public-btn public-btn-outline public-btn-sm js-add-draft" data-question-type="Open">Open</button>
                        <button type="button" class="public-btn public-btn-outline public-btn-sm js-add-draft" data-question-type="MultipleChoice">Multiple choice</button>
                        <button type="button" class="public-btn public-btn-outline public-btn-sm js-add-draft" data-question-type="TrueOrFalse">True / False</button>
                    </div>
                </div>
            </div>
        }
        else
        {
            <partial name="/Pages/Shared/Examination/Questions/_QuestionBody.Edit.cshtml" model="Model.Question" />
        }
    }
    else
    {
        <partial name="/Pages/Shared/Examination/Questions/_QuestionBody.Take.cshtml" model="Model" />
    }
</div>
