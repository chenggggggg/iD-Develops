@using iD_Develops.Pages.Shared.Examination.Questions
@model QuestionShellModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<iD_Develops.Pages.Shared.Examination.Questions.QuestionShellModel> Localizer

<div class="question-shell" id="question-shell"
     data-question-id="@(Model.Question?.Id ?? 0)"
     data-question-kind="@(Model.Question?.GetType().Name)"
     data-is-draft="@(Model.Question == null ? "true" : "false")">
    @if (Model.Mode == QuestionRenderMode.Edit)
    {
        @if (Model.Question == null)
        {
            <div class="question-shell-empty-wrap">
                <div class="question-shell-empty">
                    <h4>@Localizer["NoQuestionsHeading"]</h4>
                    <p>@Localizer["NoQuestionsMessage"]</p>

                    <div class="question-type-actions">
                        <!-- These should do the same as the + button: open modal -->
                        <button type="button" class="public-btn public-btn-outline public-btn-sm js-add-draft" data-question-type="Open">@Localizer["OpenQuestion"]</button>
                        <button type="button" class="public-btn public-btn-outline public-btn-sm js-add-draft" data-question-type="MultipleChoice">@Localizer["MultipleChoice"]</button>
                        <button type="button" class="public-btn public-btn-outline public-btn-sm js-add-draft" data-question-type="TrueOrFalse">@Localizer["TrueFalse"]</button>
                    </div>
                </div>
            </div>
        }
        else
        {
            <partial name="/Pages/Shared/Examination/Questions/_QuestionBody.Edit.cshtml" model="Model.Question" />
        }
    }
    else
    {
        <partial name="/Pages/Shared/Examination/Questions/_QuestionBody.Take.cshtml" model="Model" />
    }
</div>
