@using iD_Develops.Models
@model PaginationModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<iD_Develops.Pages.Shared.Examination.PaginationModel> Localizer

@{
    var isTaking = Model.Mode == PaginationMode.Exam;
    var currentNumber = Model.QuestionsMetadata?.FirstOrDefault(question => question.QuestionId == Model.CurrentQuestionId)?.QuestionNumber ?? 0;
    var questionCount = Model.QuestionsMetadata?.Count ?? 0;
}

<div class="@(isTaking ? "fixed inset-x-0 bottom-0 z-[999] flex border-t border-[var(--id-border)] bg-white pb-[env(safe-area-inset-bottom)] shadow-[0_-2px_14px_rgba(2,7,47,0.06)]" : "exam-pagination-bar")" data-exam-pagination>

    <!-- LEFT: question navigation (takes all remaining space) -->
    <div class="@(isTaking ? "flex min-w-0 flex-1 items-center overflow-x-auto overscroll-x-contain py-1.5 pl-[max(0.5rem,env(safe-area-inset-left))] pr-[max(0.5rem,env(safe-area-inset-right))] [scrollbar-width:thin]" : "exam-pagination-left")" data-exam-question-scroll>
        @if (Model.Mode != PaginationMode.Start)
        {
            <div class="@(isTaking ? "flex w-max min-w-full items-stretch gap-1" : "question-button-group")" role="group" aria-label="@Localizer["QuestionNavigationLabel"]">
                @* Existing questions (Exam + Editing) *@
                @if (Model.QuestionsMetadata?.Count > 0)
                {
                    @foreach (var questionMeta in Model.QuestionsMetadata)
                    {
                        var isActive = questionMeta.QuestionId == Model.CurrentQuestionId;

                        <button type="button"
                                class="question-nav-btn @(isTaking ? "min-h-11 min-w-11 shrink-0 touch-manipulation select-none rounded-lg border-0 px-3" : null) @(isActive ? "is-active" : "")"
                                data-question-id="@questionMeta.QuestionId"
                                data-action="load-question"
                                aria-current="@(isActive ? "page" : null)"
                                aria-label="@Localizer["QuestionLabel", questionMeta.QuestionNumber]">
                            <span class="@(isTaking ? "text-sm font-semibold tabular-nums" : "question-nav-number")">@questionMeta.QuestionNumber</span>
                        </button>
                    }
                }
                else if (Model.Mode == PaginationMode.Exam)
                {
                    <div class="exam-pagination-empty">
                        @Localizer["NoQuestions"]
                    </div>
                }

                @if (Model.Mode == PaginationMode.Editing)
                {
                    <details class="question-add-menu">
                        <summary class="question-add-btn" aria-label="@Localizer["AddQuestionLabel"]">
                            +
                        </summary>

                        <div class="question-add-menu-list">
                            <button type="button" class="question-add-menu-item js-add-draft" data-question-type="Open">@Localizer["OpenQuestion"]</button>
                            <button type="button" class="question-add-menu-item js-add-draft" data-question-type="MultipleChoice">@Localizer["MultipleChoice"]</button>
                            <button type="button" class="question-add-menu-item js-add-draft" data-question-type="TrueOrFalse">@Localizer["TrueFalse"]</button>
                        </div>
                    </details>
                }
            </div>
        }
    </div>


    <!-- RIGHT: action buttons (ALWAYS pinned right) -->
    <div class="@(isTaking ? "flex shrink-0 flex-col items-center justify-center gap-1 border-l border-[var(--id-border)] py-1 pl-2 pr-[max(0.5rem,env(safe-area-inset-right))] sm:flex-row sm:gap-4 sm:py-2 sm:pl-4 sm:pr-[max(1rem,env(safe-area-inset-right))]" : "exam-pagination-right")">
        @if (Model.Mode == PaginationMode.Exam)
        {
            var hasQuestions = Model.QuestionsMetadata?.Count > 0;
            <span class="text-xs font-medium tabular-nums text-[var(--id-muted)]" role="status" data-exam-progress data-format="@Localizer["QuestionProgress", "{current}", questionCount]">@Localizer["QuestionProgress", currentNumber, questionCount]</span>
            <button type="button"
                    id="submitExam"
                    class="inline-flex min-h-11 shrink-0 touch-manipulation select-none items-center justify-center rounded-lg border-0 bg-[var(--id-blue)] px-5 py-2 text-sm font-semibold text-white hover:bg-[var(--id-blue-dark)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--id-blue)] disabled:cursor-not-allowed disabled:opacity-50"
                    disabled="@(!hasQuestions)">
                @Localizer["SubmitAction"]
            </button>
        }
        else if (Model.Mode == PaginationMode.Editing)
        {
            <div class="exam-publish-status @(Model.IsPublished ? "is-published" : "is-draft")"
                 data-publish-status
                 role="status">
                <span class="exam-publish-status-dot" aria-hidden="true"></span>
                <span>@Localizer["StatusLabel"]</span>
                <span class="exam-publish-status-value" data-publish-status-label>
                    @(Model.IsPublished ? Localizer["PublishedStatus"] : Localizer["NotPublishedStatus"])
                </span>
            </div>

            <button type="button"
                    id="publishExamBtn"
                    class="exam-action-btn exam-publish-toggle @(Model.IsPublished ? "is-published" : "is-draft")"
                    data-published="@(Model.IsPublished ? "true" : "false")"
                    onclick="toggleExamPublishState()"
                    aria-label="@(Model.IsPublished ? Localizer["UnpublishExamLabel"] : Localizer["PublishExamLabel"])">
                <i class="fa-regular fa-share-from-square inline-flex size-4 flex-none items-center justify-center @(Model.IsPublished ? "exam-hidden" : "")" data-publish-icon></i>
                <i class="fa-solid fa-eye-slash inline-flex size-4 flex-none items-center justify-center @(!Model.IsPublished ? "exam-hidden" : "")" data-unpublish-icon></i>
                <span class="exam-spinner inline-flex size-4 flex-none items-center justify-center exam-hidden"
                      role="status"
                      aria-hidden="true"
                      data-publish-spinner></span>
                <span data-publish-label>@(Model.IsPublished ? Localizer["UnpublishAction"] : Localizer["PublishAction"])</span>
            </button>
        }
        else if (Model.Mode == PaginationMode.Start)
        {
            var isPublished = Model.IsPublished;
            var hasInProgress = Model.InProgressRecordId.HasValue;

            // Unlimited attempts: MaxAttempts == -1
            var isUnlimited = Model.MaxAttempts == -1;

            // For unlimited, AttemptsLeft may be int.MaxValue in your state model.
            // For UI logic, treat unlimited as always having attempts left.
            var hasAttemptsLeft = isUnlimited || Model.AttemptsLeft > 0;

            // If no attempts left AND no in-progress, Start must be disabled.
            var disableStart = !isPublished || (!hasAttemptsLeft && !hasInProgress);

            <div class="exam-pagination-start-actions">

                @* CONTINUE (only if there is an in-progress record) *@
                @if (hasInProgress)
                {
                    <form method="post"
                          asp-page-handler="Continue"
                          class="m-0 exam-pagination-form">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="examId" value="@Model.ExamId" />

                        <button type="submit"
                                class="exam-action-btn exam-action-secondary"
                                disabled="@(!isPublished)">
                            @Localizer["ContinueAction"]
                        </button>
                    </form>
                }

                @* START / RESTART *@
                @if (!hasInProgress)
                {
                    @* Normal Start (no in-progress exists) *@
                    <form method="post"
                          asp-page-handler="CreateRecord"
                          class="m-0 exam-pagination-form">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="examId" value="@Model.ExamId" />

                        <button type="submit"
                                class="exam-action-btn exam-action-primary"
                                disabled="@disableStart">
                            @Localizer["StartAction"]
                        </button>
                    </form>
                }
                else
                {
                    @* In-progress exists: allow restart if attempts left (or unlimited). *@
                    <form method="post"
                          asp-page-handler="Restart"
                          class="m-0 exam-pagination-form"
                          data-confirm-title="@Localizer["RestartAction"]"
                          data-confirm-message="@Localizer["RestartConfirmation"]"
                          data-confirm-action="@Localizer["RestartAction"]"
                          data-confirm-tone="warning">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="examId" value="@Model.ExamId" />

                        <button type="submit"
                                class="exam-action-btn exam-action-primary"
                                disabled="@(!isPublished || !hasAttemptsLeft)">
                            @Localizer["RestartAction"]
                        </button>
                    </form>
                }

                @* Optional: small status text (recommended) *@
                <div class="exam-pagination-status">
                    @if (!isPublished)
                    {
                        <span>@Localizer["PublishBeforeStarting"]</span>
                    }
                    else if (isUnlimited)
                    {
                        <span>@Localizer["UnlimitedAttempts"]</span>
                    }
                    else
                    {
                        <span>@Localizer["AttemptsLeft", Model.AttemptsLeft]</span>
                    }

                    @if (!hasAttemptsLeft && !hasInProgress && !isUnlimited)
                    {
                        <span class="ml-2">@Localizer["NoAttemptsRemaining"]</span>
                    }
                </div>

            </div>
        }

    </div>
</div>

@if (isTaking)
{
    <dialog class="m-auto w-[calc(100%_-_2rem)] max-w-lg max-h-[calc(100dvh-2rem)] overflow-hidden rounded-2xl border border-slate-200 bg-white p-0 text-[var(--id-ink)] shadow-2xl backdrop:bg-slate-950/60"
            aria-labelledby="examSubmitTitle" aria-describedby="examSubmitMessage" data-exam-submit-dialog
            data-singular-message="@Localizer["UnansweredSingular"]" data-plural-message="@Localizer["UnansweredPlural", "{count}"]"
            data-question-message="@Localizer["UnansweredQuestion", "{number}"]">
        <form method="dialog" class="m-0 flex max-h-[calc(100dvh-2rem)] flex-col">
            <header class="shrink-0 border-b border-slate-200 px-5 py-4">
                <h2 id="examSubmitTitle" class="m-0 text-lg font-semibold">@Localizer["IncompleteTitle"]</h2>
            </header>
            <div class="min-h-0 overflow-y-auto overscroll-contain px-5 py-4">
                <p id="examSubmitMessage" class="m-0 text-base leading-7"></p>
                <ul class="mt-3 mb-0 list-disc space-y-1 pl-5 text-sm leading-6 text-[var(--id-muted)]" data-exam-missing-list></ul>
            </div>
            <footer class="flex shrink-0 flex-wrap justify-end gap-2 border-t border-slate-200 bg-slate-50 px-5 py-3">
                <button type="submit" value="cancel" autofocus class="min-h-11 touch-manipulation rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold hover:bg-slate-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--id-blue)]">@Localizer["CancelAction"]</button>
                <button type="submit" value="confirm" class="min-h-11 touch-manipulation rounded-lg border-0 bg-red-700 px-4 py-2 text-sm font-semibold text-white hover:bg-red-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red-700">@Localizer["SubmitAnywayAction"]</button>
            </footer>
        </form>
    </dialog>
}








