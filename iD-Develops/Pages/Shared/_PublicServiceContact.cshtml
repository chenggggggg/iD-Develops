@model PublicServiceContact
<section class="bg-[var(--serif-blue-dark)]" data-testid="service-contact">
    <div class="public-container grid gap-8 py-14 md:py-20 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16" data-testid="service-frame">
        <h2 class="m-0 text-4xl leading-[1.15] text-balance text-white md:text-5xl">@Model.Title</h2>
        <div class="min-w-0">
            <div class="space-y-4 text-lg leading-[1.8] text-white/85">
                @foreach (var paragraph in Model.Paragraphs.Where(paragraph => !string.IsNullOrWhiteSpace(paragraph)))
                {
                    <p class="m-0">@paragraph</p>
                }
            </div>
            <div class="mt-7 flex flex-wrap gap-3">
                @{
                    var primaryData = new ViewDataDictionary(ViewData) { ["ServiceActionClass"] = "border-white bg-white text-[var(--serif-blue-dark)] hover:bg-[var(--serif-soft)] focus-visible:outline-white" };
                    var secondaryData = new ViewDataDictionary(ViewData) { ["ServiceActionClass"] = "border-white/60 bg-transparent text-white hover:border-white hover:bg-white/10 focus-visible:outline-white" };
                }
                <partial name="_PublicServiceAction" model="Model.PrimaryAction" view-data="primaryData" />
                @if (Model.SecondaryAction is not null)
                {
                    <partial name="_PublicServiceAction" model="Model.SecondaryAction" view-data="secondaryData" />
                }
            </div>
        </div>
    </div>
</section>
