@inject IViewLocalizer localizer
@inject iD_Develops.Services.IApplicationUrlService ApplicationUrls
@using System.Globalization
@using Microsoft.AspNetCore.Mvc.ViewFeatures

@{
    var currentCulture = CultureInfo.CurrentCulture.Name;
    var routeCulture = currentCulture.ToLowerInvariant();

    // RouteData may not contain "Page" in every situation, so guard it.
    var currentPage = ViewContext?.RouteData?.Values?["Page"]?.ToString() ?? string.Empty;

    var requestPath = Context?.Request?.Path.Value ?? string.Empty;
    var usePublicNavigation = ViewData["UsePublicNavigation"] as bool? == true;
    var useAbsolutePublicLinks = usePublicNavigation
        && Context?.Request is { } currentRequest
        && ApplicationUrls.IsPortalRequest(currentRequest);
    var isPortalPage = !usePublicNavigation
        && currentPage.StartsWith("/Portal", StringComparison.OrdinalIgnoreCase);
    var isHomePage = currentPage.Equals("/Index", StringComparison.OrdinalIgnoreCase)
        || requestPath.Equals("/", StringComparison.OrdinalIgnoreCase);

    var usesLightNav =
        currentPage.Equals("/Portal/Exams/Results", StringComparison.OrdinalIgnoreCase)
        || isPortalPage;

    var logoThemeClass = usesLightNav ? "public-nav-logo-light" : "public-nav-logo-dark";
    var logoImage = usesLightNav ? "/images/iddevelops-navlogo-light.png" : "/images/iddevelops-navlogo-dark.png";
    var languageLabel = localizer["Language_Current"];
    var seoTitle = ViewData["SeoTitle"]?.ToString();
    var documentTitle = string.IsNullOrWhiteSpace(seoTitle)
        ? $"{ViewData["Title"]} | iD! Training & Development"
        : seoTitle;
    var metaDescription = ViewData["MetaDescription"]?.ToString();

    string PublicPageHref(string page)
    {
        var relativeUrl = Url.Page(page, values: new { culture = routeCulture }) ?? $"/{routeCulture}/";
        return useAbsolutePublicLinks ? ApplicationUrls.PublicUrl(relativeUrl) : relativeUrl;
    }

    var cookiePreferencesHref = $"{PublicPageHref("/cookie-policy")}?preferences=true";
    var mobileNavLinkClass = "flex min-h-12 items-center rounded-md px-3 py-3 text-base font-medium text-[var(--serif-ink)] no-underline transition-colors hover:bg-[var(--serif-soft)] hover:text-[var(--id-red)] hover:no-underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--id-red)]";
    var mobileLoginViewData = new ViewDataDictionary(ViewData) { ["PublicLoginVariant"] = "mobile" };
}

<!DOCTYPE html>
<html lang="@currentCulture">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@documentTitle</title>
    @if (!string.IsNullOrWhiteSpace(metaDescription))
    {
        <meta name="description" content="@metaDescription" />
    }
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@300;500;600&family=Playfair+Display:wght@400;500;600;700&family=Source+Sans+3:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/tailwind.generated.css" asp-append-version="true" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.1.1/css/all.min.css" rel="stylesheet">
    <partial name="_CookiebotBanner" />
    @await RenderSectionAsync("Styles", required: false)
    <script src="~/js/set-language.js" asp-append-version="true"></script>
</head>
<body class="public-site @ViewData["BodyClass"]">

    <main class="@(isHomePage ? "!mt-0 !pt-0" : string.Empty)" role="main">
        <header class="public-header @(isHomePage ? "!fixed" : string.Empty) opacity-0 -translate-y-full @("[@media(scripting:none)]:opacity-100 [@media(scripting:none)]:translate-y-0") transition-[opacity,translate] duration-1000 ease-out" data-reveal="load">
            <div class="public-container">
                <nav class="public-nav" aria-label="@localizer["Nav_Menu"]">
                    <a class="public-nav-brand" href="@PublicPageHref("/index")">
                        <img src="@logoImage" class="public-nav-logo @logoThemeClass logo-image" alt="Logo" />
                    </a>
                    <div class="flex items-center gap-2 justify-self-end lg:hidden">
                        <partial name="_PublicLanguageSwitch" />
                        <button class="public-menu-toggle touch-manipulation focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--id-red)]" type="button" data-public-menu-toggle aria-controls="sidebarMenu" aria-haspopup="dialog" aria-expanded="false" aria-label="@localizer["Nav_Toggle"]" disabled>
                            <span class="public-menu-toggle-bars" aria-hidden="true"></span>
                        </button>
                    </div>
                    <div class="hidden lg:contents" id="navbarSupportedContent">
                        <ul class="public-nav-list">
                            <li class="public-nav-item">
                                <div class="group relative flex h-16 items-center" data-services-menu data-open="false">
                                    <button class="public-nav-link border-0 bg-transparent p-0" type="button" aria-expanded="false" aria-controls="services-menu" data-services-toggle>@localizer["Nav_Services"] <i class="fa-solid fa-chevron-down transition-transform duration-200 group-hover:rotate-180 group-focus-within:rotate-180 group-data-[open=true]:rotate-180" aria-hidden="true"></i></button>
                                    <ul class="pointer-events-none absolute -left-4 top-full z-50 m-0 grid min-w-64 origin-top scale-y-95 list-none border border-[var(--serif-border)] bg-[#FAFAF8]/[0.98] px-4 py-[0.65rem] opacity-0 transition-[opacity,transform] duration-[180ms] ease-out group-hover:pointer-events-auto group-hover:scale-y-100 group-hover:opacity-100 group-focus-within:pointer-events-auto group-focus-within:scale-y-100 group-focus-within:opacity-100 group-data-[open=true]:pointer-events-auto group-data-[open=true]:scale-y-100 group-data-[open=true]:opacity-100" id="services-menu" data-services-panel>
                                        <li><a class="block px-0 py-[0.55rem] text-left text-xs font-light uppercase tracking-[0.1em] text-[#6B6B6B] no-underline transition-colors hover:text-[#1A1A1A] hover:no-underline focus:text-[#1A1A1A] focus:no-underline [font-family:var(--serif-label)]" href="@PublicPageHref("/nt2-integration")">@localizer["Footer_Nt2Integration"]</a></li>
                                        <li><a class="block px-0 py-[0.55rem] text-left text-xs font-light uppercase tracking-[0.1em] text-[#6B6B6B] no-underline transition-colors hover:text-[#1A1A1A] hover:no-underline focus:text-[#1A1A1A] focus:no-underline [font-family:var(--serif-label)]" href="@PublicPageHref("/personal-development")">@localizer["Footer_PersonalDevelopment"]</a></li>
                                        <li><a class="block px-0 py-[0.55rem] text-left text-xs font-light uppercase tracking-[0.1em] text-[#6B6B6B] no-underline transition-colors hover:text-[#1A1A1A] hover:no-underline focus:text-[#1A1A1A] focus:no-underline [font-family:var(--serif-label)]" href="@PublicPageHref("/Language-And-Communication/Index")">@localizer["Footer_LanguageCommunication"]</a></li>
                                    </ul>
                                </div>
                            </li>
                            <li class="public-nav-item">
                                <a class="public-nav-link" href="@PublicPageHref("/enterprise")">@localizer["Nav_Organizations"]</a>
                            </li>
                            <li class="public-nav-item">
                                <a class="public-nav-link" href="@PublicPageHref("/Pricing")">@localizer["Nav_Products"]</a>
                            </li>
                            @if (isPortalPage)
                            {
                                <li class="public-nav-item">
                                    <span class="public-nav-link">@localizer["Nav_PortalSection"]</span>
                                </li>
                            }
                        </ul>
                        <ul class="public-nav-actions">
                            <partial name="_LoginPartial" />
                            <li class="public-nav-item"><partial name="_PublicLanguageSwitch" /></li>
                            <li class="public-nav-item">
                                <a class="public-nav-link public-nav-contact" href="@PublicPageHref("/contact")">@localizer["Nav_Contact"] <i class="fas fa-arrow-right"></i></a>
                            </li>
                        </ul>
                    </div>

                </nav>
            </div>
        </header>
        @RenderBody()
    </main>

    <dialog class="fixed inset-y-0 right-0 left-auto m-0 h-dvh max-h-none w-[min(88vw,360px)] max-w-none overflow-y-auto overscroll-contain border-0 border-l border-[var(--serif-border)] bg-[var(--serif-bg)] p-0 text-[var(--serif-ink)] shadow-[0_24px_60px_rgba(7,31,61,0.18)] backdrop:bg-[#071f3d]/40 open:flex open:flex-col lg:open:hidden"
            id="sidebarMenu" aria-labelledby="sidebarMenuLabel" data-public-menu>
        <div class="flex shrink-0 items-center justify-between gap-4 border-b border-[var(--serif-border)] px-6 py-4">
            <h2 class="m-0 text-xl font-semibold text-[var(--serif-blue-dark)]" id="sidebarMenuLabel">@localizer["Nav_Menu"]</h2>
            <button type="button" class="public-menu-close size-11 shrink-0 touch-manipulation focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--id-red)]" data-public-menu-close aria-label="@localizer["Nav_Close"]">&times;</button>
        </div>
        <nav class="min-h-0 flex-1 overflow-y-auto overscroll-contain px-3 py-5" aria-label="@localizer["Nav_Menu"]">
            <ul class="m-0 grid list-none gap-1 p-0">
                <li class="px-3 pb-2 text-xs font-medium uppercase tracking-[0.15em] text-[var(--id-red)] [font-family:var(--serif-label)]">@localizer["Nav_Services"]</li>
                <li class="public-nav-item">
                    <a class="@mobileNavLinkClass" href="@PublicPageHref("/nt2-integration")">@localizer["Footer_Nt2Integration"]</a>
                </li>
                <li class="public-nav-item">
                    <a class="@mobileNavLinkClass" href="@PublicPageHref("/personal-development")">@localizer["Footer_PersonalDevelopment"]</a>
                </li>
                <li class="public-nav-item">
                    <a class="@mobileNavLinkClass" href="@PublicPageHref("/Language-And-Communication/Index")">@localizer["Footer_LanguageCommunication"]</a>
                </li>
            </ul>
            <ul class="mx-3 mt-5 mb-0 grid list-none gap-1 border-t border-[var(--serif-border)] p-0 pt-3 [&>li]:-mx-3">
                <li class="public-nav-item">
                    <a class="@mobileNavLinkClass" href="@PublicPageHref("/enterprise")">@localizer["Nav_Organizations"]</a>
                </li>
                <li class="public-nav-item">
                    <a class="@mobileNavLinkClass" href="@PublicPageHref("/Pricing")">@localizer["Nav_Products"]</a>
                </li>
            </ul>
        </nav>
        <div class="shrink-0 border-t border-[var(--serif-border)] bg-[var(--serif-soft)] px-6 py-5">
            <ul class="m-0 grid list-none gap-3 p-0" data-public-mobile-actions>
                <li class="public-nav-item">
                    <a class="flex min-h-12 w-full items-center justify-between gap-3 rounded-md bg-[var(--id-red)] px-4 py-3 text-base font-semibold text-white no-underline transition-colors hover:bg-[#9F2F3D] hover:text-white hover:no-underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--id-red)]" href="@PublicPageHref("/contact")">
                        <span>@localizer["Nav_Contact"]</span>
                        <svg class="size-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false">
                            <path d="M5 12h14m-6-6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                    </a>
                </li>
                <partial name="_LoginPartial" view-data="mobileLoginViewData" />
            </ul>
        </div>
    </dialog>

    <footer class="public-footer">
        <div class="public-container">
            @if (ViewData["HideFooterNavigation"] as bool? != true)
            {
                <div class="public-footer-grid">
                    <div class="public-footer-brand">
                        <div class="public-footer-logo">iD! Training &amp; Development</div>
                        <p>@localizer["Footer_AboutUs_Description"]</p>
                        <div class="public-footer-socials">
                            <a href="https://www.linkedin.com/in/dominiqueheemels/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
                                <i class="fa-brands fa-linkedin"></i>
                            </a>
                            <a href="https://www.facebook.com/profile.php?id=61553944244076" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
                                <i class="fa-brands fa-facebook"></i>
                            </a>
                            <a href="mailto:info@id-develops.com" aria-label="Email">
                                <i class="fa-solid fa-envelope"></i>
                            </a>
                        </div>
                    </div>

                    <div class="public-footer-group">
                        <h2>@localizer["Footer_Services"]</h2>
                        <ul data-footer-services>
                            <li><a href="@PublicPageHref("/nt2-integration")">@localizer["Footer_Nt2Integration"]</a></li>
                            <li><a href="@PublicPageHref("/personal-development")">@localizer["Footer_PersonalDevelopment"]</a></li>
                            <li><a href="@PublicPageHref("/Language-And-Communication/Index")">@localizer["Footer_LanguageCommunication"]</a></li>
                            <li><a href="@PublicPageHref("/enterprise")">@localizer["Footer_Enterprise"]</a></li>
                            <li><a href="@PublicPageHref("/FreeDownloads")">@localizer["Footer_FreeDownloads"]</a></li>
                            <li><a href="@PublicPageHref("/Pricing")">@localizer["Footer_Products"]</a></li>
                        </ul>
                    </div>

                    <div class="public-footer-group">
                        <h2>@localizer["Footer_AboutHeading"]</h2>
                        <ul>
                            <li><a href="@PublicPageHref("/about")">@localizer["Footer_AboutUs"]</a></li>
                            <li><a href="@PublicPageHref("/contact")">@localizer["Nav_Contact"]</a></li>
                            <li><a href="https://koalendar.com/e/meet-with-id" target="_blank" rel="noopener noreferrer">@localizer["Footer_BookFreeConsultation"]</a></li>
                        </ul>
                    </div>

                    <div class="public-footer-group">
                        <h2>@localizer["Footer_Legal"]</h2>
                        <ul>
                            <li><a href="@PublicPageHref("/terms-conditions")">@localizer["Footer_Terms"]</a></li>
                            <li><a href="@PublicPageHref("/privacy")">@localizer["Footer_Privacy"]</a></li>
                            <li><a href="@PublicPageHref("/cookie-policy")">@localizer["Footer_Cookie"]</a></li>
                            <li><a href="@PublicPageHref("/disclaimer")">@localizer["Footer_Disclaimer"]</a></li>
                            <li><a href="@cookiePreferencesHref" data-cookiebot-preferences>@localizer["Footer_Preferences"]</a></li>
                        </ul>
                    </div>
                </div>
            }

            <div class="public-footer-bottom">
                <p>&copy; 2026 iD! Training &amp; Development. @localizer["Footer_RightsReserved"]</p>
                @if (ViewData["HideFooterNavigation"] as bool? != true && !useAbsolutePublicLinks)
                {
                    <div class="public-language-wrap">
                        <a class="public-footer-language" id="footerLanguageSelector" role="button" data-public-language-toggle aria-expanded="false" href="#">
                            <i class="fa-solid fa-globe" aria-hidden="true"></i>
                            <span>@languageLabel</span>
                        </a>
                        <ul class="public-language-menu language-selector-dropdown footer-language-dropdown" aria-labelledby="footerLanguageSelector" data-public-language-menu hidden>
                            <li>
                                <a class="language-option @(currentCulture == "en-US" ? "active disabled" : "")" href="#" data-lang="en-US">
                                    <img src="~/images/usa-flag.png" alt="" aria-hidden="true" />
                                    <span>
                                        <strong>@localizer["Language_UnitedStates"]</strong>
                                        <small>@localizer["Footer_English"]</small>
                                    </span>
                                    @if (currentCulture == "en-US")
                                    {
                                        <span class="inline-flex size-5 items-center justify-center rounded-full bg-[#071F3D] text-white" aria-hidden="true">
                                            <svg class="size-3" viewBox="0 0 20 20" fill="none">
                                                <path d="M4.5 10.25 8 13.5l7.5-7.25" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" />
                                            </svg>
                                        </span>
                                    }
                                </a>
                            </li>
                            <li>
                                <a class="language-option @(currentCulture == "nl-NL" ? "active disabled" : "")" href="#" data-lang="nl-NL">
                                    <img src="~/images/nl-flag.png" alt="" aria-hidden="true" />
                                    <span>
                                        <strong>@localizer["Language_Netherlands"]</strong>
                                        <small>@localizer["Footer_Dutch"]</small>
                                    </span>
                                    @if (currentCulture == "nl-NL")
                                    {
                                        <span class="inline-flex size-5 items-center justify-center rounded-full bg-[#071F3D] text-white" aria-hidden="true">
                                            <svg class="size-3" viewBox="0 0 20 20" fill="none">
                                                <path d="M4.5 10.25 8 13.5l7.5-7.25" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" />
                                            </svg>
                                        </span>
                                    }
                                </a>
                            </li>
                        </ul>
                    </div>
                }
            </div>
        </div>
    </footer>

    <partial name="_AppDialog" />

    <script src="/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/home-reveal.js" asp-append-version="true" defer data-cookieconsent="ignore"></script>
    <script src="~/js/public-layout.js" asp-append-version="true" defer data-cookieconsent="ignore"></script>
    <script src="~/js/feature-slideshow.js" asp-append-version="true"></script>
    <script src="~/js/display-messages.js" asp-append-version="true"></script>
    <script src="~/js/app-dialogs.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
    <partial name="_WorkflowFeedback" />
</body>
</html>
