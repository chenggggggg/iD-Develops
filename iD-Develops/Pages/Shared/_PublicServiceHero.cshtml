@model PublicServiceHero
<section data-testid="service-hero" aria-labelledby="service-title">
    <div class="public-container grid gap-8 pb-12 pt-10 md:pb-16 md:pt-16 lg:grid-cols-12 lg:gap-x-10" data-testid="service-frame">
        <div class="min-w-0 lg:col-span-12">
            <h1 id="service-title" class="m-0 text-[clamp(2.25rem,4vw,3.5rem)] leading-[1.12] tracking-[-0.025em] text-balance text-[var(--serif-blue-dark)]">@Model.Title</h1>
            <p class="mb-0 mt-4 text-xl leading-relaxed text-[var(--serif-blue-dark)] font-normal tracking-normal">@Model.SupportingText</p>
        </div>
        <div class="min-w-0 lg:col-span-7">
            <div class="flex flex-col gap-6 text-lg leading-relaxed text-[var(--serif-ink)]/85 tracking-normal" data-testid="service-prose">
                @foreach (var passage in Model.Paragraphs)
                {
                    <partial name="_PublicServiceParagraphs" model="passage" />
                }
            </div>
            <div class="mt-8 flex flex-wrap gap-3">
                <partial name="_PublicServiceAction" model="Model.PrimaryAction" />
                @{
                    var secondaryData = new ViewDataDictionary(ViewData) { ["ServiceActionClass"] = "public-btn-outline" };
                }
                <partial name="_PublicServiceAction" model="Model.SecondaryAction" view-data="secondaryData" />
            </div>
        </div>
        <figure class="m-0 min-w-0 lg:col-span-5">
            <img src="/images/services/@(Model.ImageName)-960.webp" srcset="/images/services/@(Model.ImageName)-480.webp 480w, /images/services/@(Model.ImageName)-960.webp 960w" sizes="(min-width: 1024px) 380px, (min-width: 768px) 700px, calc(100vw - 32px)" width="960" height="640" alt="" fetchpriority="high" class="aspect-[3/2] h-auto w-full rounded-lg object-cover" />
            @if (!string.IsNullOrWhiteSpace(Model.NoteTitle))
            {
                <figcaption class="mt-6 border-l-2 border-[var(--id-red)] pl-5">
                    <h2 class="m-0 text-2xl leading-tight text-[var(--serif-blue-dark)]">@Model.NoteTitle</h2>
                    <p class="mb-0 mt-3 text-base leading-relaxed text-[var(--serif-muted)]">@Model.NoteDescription</p>
                </figcaption>
            }
        </figure>
    </div>
</section>
