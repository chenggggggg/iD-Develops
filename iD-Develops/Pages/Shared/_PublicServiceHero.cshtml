@model PublicServiceHero
<section class="border-b border-[var(--serif-border)]" data-testid="service-hero" aria-labelledby="service-title">
    <div class="public-container grid items-center gap-10 py-12 md:gap-14 md:py-20 lg:grid-cols-[1.15fr_0.85fr] lg:gap-12">
        <div class="min-w-0">
            <p class="mb-5 font-[family-name:var(--serif-label)] text-xs font-medium tracking-[0.12em] text-[var(--serif-muted)] uppercase">@Model.Eyebrow</p>
            <h1 id="service-title" class="m-0 text-[clamp(2.25rem,4vw,3.5rem)] leading-[1.08] tracking-[-0.035em] text-balance text-[var(--serif-blue-dark)]">@Model.Title</h1>
            <div class="mt-6 space-y-4 text-lg leading-[1.75] text-[var(--serif-muted)]">
                @foreach (var paragraph in Model.Paragraphs)
                {
                    <p class="m-0">@paragraph</p>
                }
            </div>
            <div class="mt-8 flex flex-wrap gap-3">
                <partial name="_PublicServiceAction" model="Model.PrimaryAction" />
                @{
                    var secondaryData = new ViewDataDictionary(ViewData) { ["ServiceActionClass"] = "public-btn-outline" };
                }
                <partial name="_PublicServiceAction" model="Model.SecondaryAction" view-data="secondaryData" />
            </div>
        </div>
        <figure class="m-0 min-w-0">
            <img src="/images/services/@(Model.ImageName)-960.webp" srcset="/images/services/@(Model.ImageName)-480.webp 480w, /images/services/@(Model.ImageName)-960.webp 960w" sizes="(min-width: 1024px) 380px, (min-width: 768px) 700px, calc(100vw - 32px)" width="960" height="640" alt="" fetchpriority="high" class="aspect-[4/3] h-auto w-full rounded-t-[4rem] rounded-br-[4rem] object-cover lg:aspect-[4/5]" />
            @if (!string.IsNullOrWhiteSpace(Model.NoteTitle))
            {
                <figcaption class="mt-6 border-l-2 border-[var(--id-red)] pl-5">
                    <h2 class="m-0 text-2xl leading-tight text-[var(--serif-blue-dark)]">@Model.NoteTitle</h2>
                    <p class="mb-0 mt-3 text-base leading-relaxed text-[var(--serif-muted)]">@Model.NoteDescription</p>
                </figcaption>
            }
        </figure>
    </div>
</section>
