@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer localizer
@inject iD_Develops.Services.IApplicationUrlService ApplicationUrls

<div data-navigation-progress
     data-public-url="@ApplicationUrls.PublicUrl()"
     data-portal-url="@ApplicationUrls.PortalUrl()"
     data-loading-label="@localizer["Loading"].Value"
     data-loading-destination="@localizer["LoadingDestination"].Value"
     role="status" aria-live="polite" aria-atomic="true" hidden
     class="sr-only">
    <span data-navigation-progress-label>@localizer["Loading"]</span>
</div>
<script src="~/js/workflow-feedback.js" asp-append-version="true"></script>
