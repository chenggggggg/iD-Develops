@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer localizer
@inject iD_Develops.Services.IApplicationUrlService ApplicationUrls

<div data-navigation-progress
     data-public-url="@ApplicationUrls.PublicUrl()"
     data-portal-url="@ApplicationUrls.PortalUrl()"
     data-loading-label="@localizer["Loading"].Value"
     data-loading-destination="@localizer["LoadingDestination"].Value"
     role="status" aria-live="polite" aria-atomic="true" hidden
     class="pointer-events-none fixed inset-x-0 top-4 z-[20000] flex justify-center px-4">
    <div class="flex max-w-full items-center gap-3 rounded-lg border border-[var(--id-border)] bg-white px-4 py-3 text-sm font-semibold text-[var(--id-ink)] shadow-lg">
        <span aria-hidden="true" class="size-4 shrink-0 rounded-full border-2 border-current border-r-transparent text-[var(--id-blue)] motion-safe:animate-spin"></span>
        <span data-navigation-progress-label class="min-w-0 truncate">@localizer["Loading"]</span>
    </div>
</div>
<script src="~/js/workflow-feedback.js" asp-append-version="true"></script>
