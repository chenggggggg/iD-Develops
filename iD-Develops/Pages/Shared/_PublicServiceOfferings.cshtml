@model IReadOnlyList<PublicServiceOffering>
<div data-testid="service-offerings">
    @for (var index = 0; index < Model.Count; index++)
    {
        var offering = Model[index];
        <article class="grid min-w-0 gap-3 border-t border-[var(--serif-border)] py-6 md:grid-cols-[1fr_2fr] md:gap-10">
            <h3 class="m-0 font-[family-name:var(--serif-body)] text-xl font-semibold leading-snug text-[var(--serif-blue-dark)] tracking-normal">@offering.Title</h3>
            <div class="flex flex-col gap-6 text-lg leading-relaxed text-[var(--serif-ink)]/85 tracking-normal">
                <partial name="_PublicServiceParagraphs" model="offering.Description" />
            </div>
        </article>
    }
</div>
