@inject IViewLocalizer localizer
@using System.Globalization

@{
    var isAuthenticated = User?.Identity?.IsAuthenticated == true;
    var portalHomeUrl = Url.Page("/Portal/Home/Index") ?? "/portal/home";
    var portalUrl = isAuthenticated
        ? portalHomeUrl
        : Url.Page("/Account/Login", new
        {
            area = "Identity",
            returnUrl = portalHomeUrl
        }) ?? "/identity/account/login";
    var portalText = isAuthenticated ? localizer["Nav_Portal"].Value : "Log In";
}

<li class="public-nav-item">
    <a class="public-nav-link public-nav-login"
       href="@portalUrl">
        <span>@portalText</span>
    </a>
</li>
