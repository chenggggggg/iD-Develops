@inject iD_Develops.Services.IApplicationUrlService ApplicationUrls
@inject iD_Develops.Services.IPortalSessionIndicatorService PortalSessionIndicator
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
    var hasPortalSession = PortalSessionIndicator.HasActiveSession(Context.Request);
    var portalPath = hasPortalSession
        ? "/"
        : $"/login?returnUrl={Uri.EscapeDataString("/")}";
    var portalUrl = ApplicationUrls.PortalUrl(portalPath);
}

<li class="public-nav-item">
    <a class="public-nav-link public-nav-login"
       href="@portalUrl">
        <span>@(hasPortalSession ? Localizer["Nav_Portal"] : Localizer["Nav_SignIn"])</span>
    </a>
</li>
