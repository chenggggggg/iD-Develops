<dialog data-app-dialog
        aria-labelledby="appDialogTitle"
        aria-describedby="appDialogMessage"
        class="m-auto w-[min(92vw,30rem)] overflow-hidden rounded-xl border border-slate-200 bg-white p-0 text-slate-800 shadow-2xl backdrop:bg-slate-950/50">
    <form method="dialog" class="m-0">
        <header class="flex items-start justify-between gap-4 px-5 pt-5 sm:px-6 sm:pt-6">
            <div class="flex min-w-0 items-start gap-3">
                <span data-app-dialog-icon="warning" class="grid size-10 shrink-0 place-items-center rounded-full bg-amber-50 text-amber-700" aria-hidden="true">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                </span>
                <span data-app-dialog-icon="danger" class="grid size-10 shrink-0 place-items-center rounded-full bg-red-50 text-red-700" aria-hidden="true" hidden>
                    <i class="fa-solid fa-trash-can"></i>
                </span>
                <span data-app-dialog-icon="info" class="grid size-10 shrink-0 place-items-center rounded-full bg-sky-50 text-sky-700" aria-hidden="true" hidden>
                    <i class="fa-solid fa-circle-info"></i>
                </span>
                <div class="min-w-0 pt-0.5">
                    <h2 id="appDialogTitle" data-app-dialog-title class="m-0 text-lg font-semibold text-slate-950">Confirm action</h2>
                    <p id="appDialogMessage" data-app-dialog-message class="mt-1 text-sm leading-6 text-slate-600"></p>
                </div>
            </div>
            <button type="submit"
                    value="cancel"
                    formnovalidate
                    class="grid size-8 shrink-0 place-items-center rounded-md border-0 bg-transparent text-slate-500 transition-colors hover:bg-slate-100 hover:text-slate-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#005190]"
                    aria-label="Close">
                <i class="fa-solid fa-xmark" aria-hidden="true"></i>
            </button>
        </header>

        <div data-app-dialog-input-group class="px-5 pt-4 sm:px-6" hidden>
            <label data-app-dialog-input-label for="appDialogInput" class="mb-1.5 block text-sm font-semibold text-slate-700">Reason</label>
            <input id="appDialogInput"
                   data-app-dialog-input
                   class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 outline-none transition focus:border-[#005190] focus:ring-2 focus:ring-[#005190]/15" />
        </div>

        <footer class="mt-5 flex flex-wrap justify-end gap-2 border-t border-slate-200 bg-slate-50 px-5 py-4 sm:px-6">
            <button type="submit"
                    value="cancel"
                    formnovalidate
                    data-app-dialog-cancel
                    class="inline-flex min-h-9 items-center justify-center rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 transition-colors hover:border-slate-400 hover:bg-slate-100 hover:text-slate-950 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#005190]">
                Cancel
            </button>
            <button type="submit"
                    value="confirm"
                    data-app-dialog-confirm
                    class="inline-flex min-h-9 items-center justify-center rounded-lg border border-[#005190] bg-[#005190] px-4 py-2 text-sm font-semibold text-white transition-colors hover:border-[#003f70] hover:bg-[#003f70] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#005190]">
                Continue
            </button>
        </footer>
    </form>
</dialog>
