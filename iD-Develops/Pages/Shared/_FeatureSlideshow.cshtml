@model FeatureSlideshowViewModel

@{
    var sectionId = Model.Id ?? $"feature-slideshow-{Guid.NewGuid():N}";
    var features = Model.Features ?? Array.Empty<FeatureSlideshowItem>();
    var intervalMilliseconds = Math.Max(Model.IntervalMilliseconds, 1000);
}

@if (features.Count > 0)
{
    <section id="@sectionId"
             class="feature-slideshow bg-[#FAFAF8] py-28 text-[#1A1A1A] md:py-40"
             data-feature-slideshow
             data-feature-interval="@intervalMilliseconds"
             style="--feature-slideshow-duration: @(intervalMilliseconds)ms;">
        <div class="public-container">
            <header class="mb-14 text-center md:mb-20">
                <p class="public-eyebrow">@Model.Eyebrow</p>
                <h2 class="mx-auto mb-0 max-w-3xl text-4xl font-bold leading-[1.05] text-[#071f3d] md:text-5xl lg:text-6xl">
                    @Model.Title
                </h2>
            </header>

            <div class="feature-slideshow-layout mx-auto grid max-w-[1200px] items-center gap-10 lg:grid-cols-[minmax(320px,0.92fr)_minmax(0,1.08fr)] lg:gap-16">
                <div class="feature-slideshow-rail-wrap">
                    <div class="feature-slideshow-rail" role="tablist" aria-label="@Model.Eyebrow">
                        @for (var i = 0; i < features.Count; i++)
                        {
                            var feature = features[i];
                            var isActive = i == 0;
                            var panelId = $"{sectionId}-feature-{i}";

                            <button type="button"
                                    class="feature-slideshow-item"
                                    role="tab"
                                    aria-selected="@(isActive ? "true" : "false")"
                                    aria-controls="@panelId"
                                    data-feature-trigger
                                    data-feature-index="@i"
                                    data-active="@(isActive ? "true" : "false")">
                                <span class="feature-slideshow-line" aria-hidden="true">
                                    <span class="feature-slideshow-progress" data-feature-progress></span>
                                </span>
                                <span class="feature-slideshow-copy">
                                    <span class="feature-slideshow-title">@feature.Title</span>
                                    <span id="@panelId"
                                          class="feature-slideshow-description"
                                          data-feature-description
                                          aria-hidden="@(isActive ? "false" : "true")">
                                        <span>@feature.Description</span>
                                    </span>
                                </span>
                            </button>
                        }
                    </div>
                </div>

                <figure class="feature-slideshow-figure relative m-0 overflow-hidden rounded-2xl border border-[#E8E4DF] bg-[#F5F3F0] shadow-[0_24px_70px_rgba(17,17,17,0.10)]">
                    @for (var i = 0; i < features.Count; i++)
                    {
                        var feature = features[i];
                        <img class="feature-slideshow-image"
                             src="@feature.ImageSrc"
                             alt="@feature.ImageAlt"
                             width="920"
                             height="690"
                             data-feature-image
                             data-feature-index="@i"
                             data-active="@(i == 0 ? "true" : "false")"
                             data-feature-fallback="/images/gradient.jpg"
                             aria-hidden="@(i == 0 ? "false" : "true")" />
                    }
                </figure>
            </div>
        </div>
    </section>
}
