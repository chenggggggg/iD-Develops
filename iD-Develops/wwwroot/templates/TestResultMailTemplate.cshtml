@using iD_Develops.Models
@model TestResultData

<!DOCTYPE html>
<html>
<head>
    <title>Your Language Test Results</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Lato:wght@300;400;700&display=swap" rel="stylesheet">
</head>
<body style="font-family: 'Lato', Arial, sans-serif; color: #10224d; margin: 0; padding: 0; background-color: #f3f7fb;">
    <div style="display:none; font-size:1px; color:#ffffff; max-height:0px; max-width:0px; opacity:0; overflow:hidden;">
        Hello @Model.DisplayName, your Dutch level test result is ready.
    </div>

    <div style="width: 100%; background-color: #f3f7fb; padding: 28px 12px;">
        <div style="max-width: 620px; margin: 0 auto;">
            <div style="text-align: center; padding: 10px 0 24px;">
                <img src="@Model.Branding.LogoUrl" alt="@Model.Branding.SiteName" style="display: inline-block; width: 250px; max-width: 78%; height: auto;">
            </div>

            <div style="background: #ffffff; border-radius: 18px; overflow: hidden; border: 1px solid #dce7f2; box-shadow: 0 18px 45px rgba(7, 27, 73, 0.08);">
                <div style="background: #071b49; padding: 34px 32px 30px; color: #ffffff;">
                    <p style="margin: 0 0 10px; color: #9fd2f2; font-size: 13px; font-weight: 700; letter-spacing: 1.4px; text-transform: uppercase;">Dutch level test</p>
                    <h1 style="margin: 0; font-size: 32px; line-height: 1.16; font-weight: 700;">Your result is ready</h1>
                    <p style="margin: 14px 0 0; color: #dbeafe; font-size: 16px; line-height: 1.55;">Hi @Model.DisplayName, thanks for completing the test.</p>
                </div>

                <div style="padding: 30px 32px;">
                    <div style="background: #f6f9fc; border: 1px solid #dfeaf5; border-radius: 14px; padding: 22px;">
                        <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="border-collapse: collapse;">
                            <tr>
                                <td style="width: 50%; padding: 0 12px 0 0; text-align: center; border-right: 1px solid #dfeaf5;">
                                    <p style="margin: 0 0 8px; color: #5c6b82; font-size: 13px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase;">Score</p>
                                    <p style="margin: 0; color: #071b49; font-size: 38px; line-height: 1; font-weight: 700;">@Model.Score / @Model.MaxScore</p>
                                </td>
                                <td style="width: 50%; padding: 0 0 0 12px; text-align: center;">
                                    <p style="margin: 0 0 8px; color: #5c6b82; font-size: 13px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase;">Level</p>
                                    <p style="margin: 0; color: #005190; font-size: 38px; line-height: 1; font-weight: 700;">@Model.ResultLevel</p>
                                </td>
                            </tr>
                        </table>
                    </div>

                    <div style="text-align: center; margin: 26px 0 30px;">
                        <a href="@Model.ActionUrl" style="background-color: #005190; color: #ffffff; padding: 14px 26px; text-align: center; display: inline-block; border-radius: 999px; text-decoration: none; font-size: 16px; font-weight: 700;">@Model.ActionText</a>
                    </div>

                    <div style="border-top: 1px solid #e6edf5; padding-top: 24px;">
                        <h2 style="margin: 0 0 12px; color: #071b49; font-size: 20px; line-height: 1.3; font-weight: 700;">What this means</h2>
                        <p style="margin: 0; color: #344563; font-size: 15px; line-height: 1.7;">@Model.ResultAdvice</p>
                    </div>

                    <div style="margin-top: 24px; background: #eef6fb; border-radius: 14px; padding: 20px;">
                        <h2 style="margin: 0 0 10px; color: #071b49; font-size: 18px; line-height: 1.3; font-weight: 700;">Need help choosing the next step?</h2>
                        <p style="margin: 0 0 16px; color: #40516b; font-size: 15px; line-height: 1.6;">We can walk through your result with you and recommend the best learning path.</p>
                        <a href="https://koalendar.com/e/test-results-options" target="_blank" rel="noopener noreferrer" style="background-color: #ffffff; color: #005190; border: 1px solid #b8d6ea; padding: 11px 18px; text-align: center; display: inline-block; border-radius: 999px; text-decoration: none; font-weight: 700;">Book an appointment</a>
                    </div>

                    <div style="margin-top: 26px; border-top: 1px solid #e6edf5; padding-top: 22px;">
                        <p style="margin: 0 0 14px; color: #40516b; font-size: 15px; line-height: 1.6;">Explore our courses and resources to keep building your Dutch.</p>
                        <a href="@Model.ProductsURL" style="color: #005190; font-weight: 700; text-decoration: none;">Discover courses</a>
                        <span style="color: #b8c5d6; padding: 0 8px;">|</span>
                        <a href="@Model.ContactURL" style="color: #005190; font-weight: 700; text-decoration: none;">Contact us</a>
                    </div>

                    <p style="margin: 28px 0 0; color: #344563; font-size: 15px; line-height: 1.6;">Best regards,<br><strong>iD! Training &amp; Development</strong></p>
                </div>
            </div>

            <div style="text-align: center; padding: 22px 12px 0;">
                <p style="margin: 0 0 10px; color: #718096; font-size: 13px;">Follow us</p>
                <p style="margin: 0; font-size: 13px;">
                    <a href="@Model.Branding.LinkedInUrl" target="_blank" style="color: #005190; text-decoration: none; margin: 0 8px; font-weight: 700;">LinkedIn</a>
                    <a href="@Model.Branding.FacebookUrl" target="_blank" style="color: #005190; text-decoration: none; margin: 0 8px; font-weight: 700;">Facebook</a>
                </p>
            </div>
        </div>
    </div>
</body>
</html>
